<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Compléter mon profil — KongoBazar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/public/checkbox.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/login.css') }}">
    <style>
        .profile-hint { background: #f0f8fc; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px; font-size: 14px; color: #1a1a1a; }
        .profile-row { display: flex; gap: 12px; flex-wrap: wrap; }
        .profile-row .login-field { flex: 1; min-width: 160px; }
        .profile-avatar-preview {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 72px;
            height: 72px;
            border-radius: 50%;
            overflow: hidden;
            background: #f1f5f9;
        }
        .profile-avatar-preview img { width: 100%; height: 100%; object-fit: cover; }
        .profile-avatar-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .profile-avatar-placeholder i { font-size: 30px; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
        .profile-avatar-placeholder img { width: 100%; height: 100%; object-fit: cover; }
        select.login-field-select {
            width: 100%; border: 1px solid #e3e6ea; border-radius: 30px; padding: 12px 18px; font-size: 14px; background: #fff;
        }
        .profile-actions { display: flex; gap: 10px; margin-top: 10px; }
        .profile-actions .login-submit { flex: 1; }
        .profile-later { border: 1px solid #e3e6ea; border-radius: 30px; padding: 13px 20px; background: #fff; color: #1a1a1a; font-weight: 600; text-decoration: none; text-align: center; }
    </style>
</head>
<body class="login-body{{ loginImage ? ' login-has-image' : '' }}">

    <div class="login-layout">
        <div class="login-visual">
            {% if loginImage %}
                <img class="login-visual-photo" src="{{ vich_uploader_asset(loginImage, 'imageFile') }}" alt="{{ loginImage.title|default('') }}">
            {% else %}
                <a href="{{ path('public_home') }}" class="login-visual-logo"><span>Kongo</span><span>Bazar</span></a>
            {% endif %}
        </div>
        {% if loginImage %}
            <img class="login-mobile-photo" src="{{ vich_uploader_asset(loginImage, 'imageFile') }}" alt="{{ loginImage.title|default('') }}">
        {% endif %}

        <a href="{{ path('public_home') }}" class="login-mobile-logo"><span>Kongo</span><span>Bazar</span></a>

        <div class="login-form-col">
            <div class="login-card">
                {% if loginImage %}
                    <a href="{{ path('public_home') }}" class="login-card-eyebrow login-card-eyebrow--logo" style="text-decoration:none;display:block;"><span class="is-kongo">Kongo</span><span class="is-bazar">Bazar</span></a>
                {% else %}
                    <p class="login-card-eyebrow">Bienvenue,</p>
                {% endif %}
                <h1 class="login-card-title">Complète ton profil</h1>

                <div class="profile-hint">
                    <i class="bi bi-stars"></i>
                    {% if required %}
                        Il ne reste que quelques champs à remplir pour finaliser ta commande.
                    {% else %}
                        Complète ton profil pour retrouver des offres adaptées, autour de toi.
                    {% endif %}
                </div>

                {% for message in app.flashes('error') %}
                    <div class="login-alert">{{ message }}</div>
                {% endfor %}

                <form method="post" enctype="multipart/form-data">
                    <div class="login-field text-center mb-3">
                        <div class="profile-avatar-preview" id="avatarPreviewWrap">
                            {% if user.avatarName %}
                                <img id="avatarPreview" src="{{ vich_uploader_asset(user, 'avatarFile') }}" alt="">
                            {% else %}
                                {% set startCivility = user.civility %}
                                <div id="avatarPlaceholderIcon" class="profile-avatar-placeholder">
                                    {% if startCivility %}
                                        <img src="/images/avatars/avatar-{{ startCivility }}.png" alt="">
                                    {% else %}
                                        <i class="bi bi-camera-fill" style="color:#8a8f98;background:#f1f5f9;"></i>
                                    {% endif %}
                                </div>
                                <img id="avatarPreview" src="" alt="" hidden>
                            {% endif %}
                        </div>
                        <div class="mt-2">
                            <label for="avatarInput" style="cursor:pointer; color: var(--kb-theme-color, #2FA8E0); font-size: 13px; font-weight: 600;">
                                <i class="bi bi-camera"></i> Choisir une photo de profil
                            </label>
                            <input type="file" name="avatar" id="avatarInput" accept="image/*" hidden>
                        </div>
                    </div>

                    <div class="profile-row">
                        <div class="login-field">
                            <label for="civility">Civilité</label>
                            <select name="civility" id="civility" class="login-field-select" required>
                                <option value="">—</option>
                                {% for key, label in constant('App\\Entity\\User::CIVILITIES') %}
                                    <option value="{{ key }}" {{ user.civility == key ? 'selected' : '' }}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="login-field">
                            <label for="date_of_birth">Date de naissance</label>
                            <input type="date" name="date_of_birth" id="date_of_birth" value="{{ user.dateOfBirth ? user.dateOfBirth|date('Y-m-d') : '' }}" required>
                        </div>
                    </div>

                    <div class="login-field">
                        <label for="phone">Téléphone</label>
                        <input type="tel" name="phone" id="phone" value="{{ user.phone }}" required>
                    </div>

                    <div class="profile-row">
                        <div class="login-field">
                            <label for="geoRoot">Province</label>
                            <select id="geoRoot" class="login-field-select">
                                <option value="">—</option>
                                {% for unit in rootUnits %}
                                    <option value="{{ unit.id }}">{{ unit.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="login-field">
                            <label for="geoLevel2">Ville / Territoire</label>
                            <select id="geoLevel2" class="login-field-select" disabled><option value="">—</option></select>
                        </div>
                    </div>
                    <div class="profile-row">
                        <div class="login-field">
                            <label for="geoLevel3">Secteur / Commune</label>
                            <select id="geoLevel3" class="login-field-select" disabled><option value="">—</option></select>
                        </div>
                        <div class="login-field">
                            <label for="geoLevel4">Quartier</label>
                            <select id="geoLevel4" class="login-field-select" disabled><option value="">—</option></select>
                        </div>
                    </div>
                    <input type="hidden" name="administrative_unit" id="administrativeUnitInput" value="{{ user.administrativeUnit ? user.administrativeUnit.id : '' }}">

                    <div class="login-field">
                        <label for="address">Adresse (rue, numéro, point de repère)</label>
                        <input type="text" name="address" id="address" value="{{ user.address }}" required>
                    </div>

                    <label class="login-remember">
                        <input type="checkbox" name="accepts_newsletter" class="kb-checkbox" {{ user.acceptsNewsletter ? 'checked' : '' }}>
                        <span>Je souhaite recevoir les offres et nouveautés par e-mail.</span>
                    </label>

                    <div class="profile-actions">
                        {% if not required %}
                            <a href="{{ path('public_complete_profile_later') }}" class="profile-later">Plus tard</a>
                        {% endif %}
                        <button type="submit" class="login-submit">Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('avatarInput').addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const img = document.getElementById('avatarPreview');
            const placeholder = document.getElementById('avatarPlaceholderIcon');
            img.src = URL.createObjectURL(file);
            img.hidden = false;
            img.style.display = 'block';
            if (placeholder) placeholder.style.display = 'none';
        });
        (function () {
            const civilitySelect = document.getElementById('civility');
            const placeholder = document.getElementById('avatarPlaceholderIcon');
            // Si une vraie photo est déjà en place (pas de placeholder dans la page), rien à faire ici.
            if (!civilitySelect || !placeholder) return;

            const AVATAR_STYLES = {
                m: '/images/avatars/avatar-m.png',
                mme: '/images/avatars/avatar-mme.png',
            };

            civilitySelect.addEventListener('change', function () {
                const src = AVATAR_STYLES[this.value];
                if (src) {
                    placeholder.innerHTML = '<img src="' + src + '" alt="">';
                } else {
                    placeholder.innerHTML = '<i class="bi bi-camera-fill" style="color:#8a8f98;background:#f1f5f9;"></i>';
                }
            });
        })();

        (function () {
            const root = document.getElementById('geoRoot');
            const lvl2 = document.getElementById('geoLevel2');
            const lvl3 = document.getElementById('geoLevel3');
            const lvl4 = document.getElementById('geoLevel4');
            const hidden = document.getElementById('administrativeUnitInput');

            function fillChildren(select, parentId) {
                select.innerHTML = '<option value="">—</option>';
                select.disabled = true;
                if (!parentId) return;
                fetch('/geo/children/' + parentId)
                    .then((r) => r.json())
                    .then((data) => {
                        (data.results || []).forEach((u) => {
                            const opt = document.createElement('option');
                            opt.value = u.id;
                            opt.textContent = u.name;
                            select.appendChild(opt);
                        });
                        select.disabled = false;
                    });
            }

            root.addEventListener('change', function () {
                hidden.value = this.value;
                fillChildren(lvl2, this.value);
                lvl3.innerHTML = '<option value="">—</option>'; lvl3.disabled = true;
                lvl4.innerHTML = '<option value="">—</option>'; lvl4.disabled = true;
            });
            lvl2.addEventListener('change', function () {
                hidden.value = this.value || root.value;
                fillChildren(lvl3, this.value);
                lvl4.innerHTML = '<option value="">—</option>'; lvl4.disabled = true;
            });
            lvl3.addEventListener('change', function () {
                hidden.value = this.value || lvl2.value || root.value;
                fillChildren(lvl4, this.value);
            });
            lvl4.addEventListener('change', function () {
                hidden.value = this.value || lvl3.value || lvl2.value || root.value;
            });
        })();
    </script>
</body>
</html>