<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Connexion — KongoBazar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/public/checkbox.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/login.css') }}">
</head>
<body class="login-body{{ loginImage ? ' login-has-image' : '' }}">

    <div class="login-layout">
        {# --- Colonne / bandeau image (ordinateur : colonne gauche ; mobile : bandeau du haut) --- #}
        <div class="login-visual">
            {% if loginImage %}
                <img class="login-visual-photo" src="{{ vich_uploader_asset(loginImage, 'imageFile') }}" alt="{{ loginImage.title|default('') }}">
            {% else %}
                <div class="login-visual-logo"><span>Kongo</span><span>Bazar</span></div>
            {% endif %}
        </div>
        {% if loginImage %}
            <img class="login-mobile-photo" src="{{ vich_uploader_asset(loginImage, 'imageFile') }}" alt="{{ loginImage.title|default('') }}">
        {% endif %}

        <div class="login-mobile-logo"><span>Kongo</span><span>Bazar</span></div>

        <div class="login-form-col">
            <div class="login-card">
                {% if loginImage %}
                    <p class="login-card-eyebrow login-card-eyebrow--logo"><span class="is-kongo">Kongo</span><span class="is-bazar">Bazar</span></p>
                {% else %}
                    <p class="login-card-eyebrow">Bienvenue,</p>
                {% endif %}
                <h1 class="login-card-title">Connexion compte client</h1>

                {% if error %}
                    <div class="login-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post">
                    <div class="login-field">
                        <label for="email">Adresse e-mail</label>
                        <input type="email" name="email" id="email" value="{{ last_username }}" required autofocus>
                    </div>
                    <div class="login-field">
                        <label for="password">Mot de passe</label>
                        <div class="login-field-input-wrap">
                            <input type="password" name="password" id="password" required>
                            <button type="button" class="login-field-password-toggle" id="loginPasswordToggle" aria-label="Afficher le mot de passe">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <label class="login-remember">
                        <input type="checkbox" name="_remember_me" id="remember_me" class="kb-checkbox">
                        Se souvenir de moi
                    </label>
                    <button type="submit" class="login-submit">Se connecter</button>
                </form>

                <p class="login-links">
                    <a href="#">Mot de passe oublié ?</a>
                    <span class="login-links-sep">·</span>
                    <a href="/register" class="login-links-register">
                        <span class="login-links-register-full">Pas encore de compte ? S'inscrire</span>
                        <span class="login-links-register-short">S'inscrire</span>
                    </a>
                </p>
            </div>
        </div>
    </div>

    <div class="login-loading-overlay" id="loginLoadingOverlay" role="status" aria-live="polite">
        <div class="login-loading-word">
            <span class="ll-letter is-kongo" style="animation-delay:0.00s">K</span><span class="ll-letter is-kongo" style="animation-delay:0.09s">o</span><span class="ll-letter is-kongo" style="animation-delay:0.18s">n</span><span class="ll-letter is-kongo" style="animation-delay:0.27s">g</span><span class="ll-letter is-kongo" style="animation-delay:0.36s">o</span><span class="ll-letter is-bazar" style="animation-delay:0.45s">B</span><span class="ll-letter is-bazar" style="animation-delay:0.54s">a</span><span class="ll-letter is-bazar" style="animation-delay:0.63s">z</span><span class="ll-letter is-bazar" style="animation-delay:0.72s">a</span><span class="ll-letter is-bazar" style="animation-delay:0.81s">r</span>
        </div>
        <p class="login-loading-caption">Récupération des infos…</p>
    </div>

    <script>
        document.getElementById('loginPasswordToggle').addEventListener('click', function () {
            const input = document.getElementById('password');
            const icon = this.querySelector('i');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });

        document.querySelector('.login-card form').addEventListener('submit', function () {
            document.getElementById('loginLoadingOverlay').classList.add('is-visible');
            const btn = this.querySelector('.login-submit');
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Connexion…';
            }
        });
    </script>
</body>
</html>