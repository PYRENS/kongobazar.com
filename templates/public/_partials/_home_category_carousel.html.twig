{# ==========================================================================
   Carrousel "Catégorie" — sans titre, juste sous le Hero.
   2 rangées d'illustrations rondes (desktop ET mobile), flèches + glissement tactile.
   Contexte attendu :
     - categoryCarouselItems : Category[] (feuilles), déjà filtrées par HomeController
       (choix admin dans l'ordre, ou mode automatique si aucun choix)
   ========================================================================== #}
{% if categoryCarouselItems|default([])|length > 0 %}
<section class="home-cat-carousel" data-cat-carousel aria-label="Catégories">
    <button type="button" class="carousel-arrow home-cat-carousel-arrow home-cat-carousel-arrow--prev" data-cat-carousel-prev aria-label="{{ 'home.prev'|trans }}" hidden>
        <i class="bi bi-chevron-left"></i>
    </button>

    <div class="home-cat-carousel-track" data-cat-carousel-track>
        {% for category in categoryCarouselItems %}
            <a href="{{ path('catalog_category', { slug: category.slug }) }}" class="home-cat-carousel-item" title="{{ category.name }}">
                <span class="home-cat-carousel-circle" style="background:{{ category.effectiveThemeColor ?? '#2FA8E0' }};">
                    {% if category.imageName %}
                        <img src="{{ vich_uploader_asset(category, 'imageFile') }}" alt="{{ category.name }}" loading="lazy">
                    {% else %}
                        <i class="bi {{ category.icon|default('bi-tag') }}"></i>
                    {% endif %}
                </span>
                <span class="home-cat-carousel-label">{{ category.name }}</span>
            </a>
        {% endfor %}
    </div>

    <button type="button" class="carousel-arrow home-cat-carousel-arrow home-cat-carousel-arrow--next" data-cat-carousel-next aria-label="{{ 'home.next'|trans }}" hidden>
        <i class="bi bi-chevron-right"></i>
    </button>
</section>
{% endif %}