{# ==========================================================================
   Header complet du site public (kongobazar.com)
   Toutes les données de navigation (rayons, tendances, menu personnalisé,
   pubs mega menu, panier) sont désormais fournies par des fonctions Twig
   centralisées (voir src/Twig/AppExtension.php), pas par le contrôleur.
   Ça évite qu'un contrôleur qui oublie de les transmettre fasse planter
   le header (ex. DirectoryController).
   ========================================================================== #}
{% import 'public/_partials/_category_menu.html.twig' as menu %}
{% set cart = current_cart() %}
{% set cartSummary = cart_summary() %}
{# Icônes sociales flottantes, fixes sur le bord gauche #}
{% set socialSetting = social_float_setting() %}
{% set socialLinks = social_links() %}
{% if socialLinks|length > 0 %}
<div class="social-float{{ socialSetting.showOnDesktop ? '' : ' social-float--hide-desktop' }}{{ socialSetting.showOnTablet ? '' : ' social-float--hide-tablet' }}{{ socialSetting.showOnMobile ? '' : ' social-float--hide-mobile' }}">
    {% for link in socialLinks %}
        <a href="{{ link.url }}" class="social-float-item" style="background:{{ link.colorHex }};" target="_blank" rel="noopener" aria-label="{{ link.platform }}"><i class="{{ link.iconClass }}"></i></a>
    {% endfor %}
</div>
{% endif %}

<header id="site-header" class="site-header">
    {# --- Barre d'info du haut --- #}
    <div class="top-bar">
        <div class="container-kb top-bar-inner">
            <span class="top-bar-welcome">{{ 'header.welcome'|trans }}</span>
            <div class="top-bar-links">
                <div class="topbar-dropdown">
                    <button type="button" class="topbar-dropdown-toggle">
                        <i class="bi bi-person"></i> {{ app.user ? (app.user.firstName ?: 'header.my_account'|trans) : 'header.my_account'|trans }} <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="topbar-dropdown-panel">
                        {% if app.user %}
                            <a href="{{ path('account_index') }}"><i class="bi bi-person-circle"></i> {{ 'header.my_space'|trans }}</a>
                            <a href="{{ path('account_index') }}"><i class="bi bi-bag-check"></i> {{ 'header.order_history'|trans }}</a>
                            <a href="{{ path('public_logout') }}"><i class="bi bi-box-arrow-right"></i> {{ 'header.logout'|trans }}</a>
                        {% else %}
                            <a href="{{ path('public_login') }}"><i class="bi bi-box-arrow-in-right"></i> {{ 'header.login'|trans }}</a>
                            <a href="/register"><i class="bi bi-person-plus"></i> {{ 'header.register'|trans }}</a>
                        {% endif %}
                    </div>
                </div>

                <span class="topbar-sep">|</span>

                <a href="{{ path('wishlist_index') }}" class="topbar-simple-link">
                    <i class="bi bi-heart"></i> {{ 'header.my_wishlist'|trans }}
                </a>

                <span class="topbar-sep">|</span>

                {% set languages = [
                    { code: 'fr', abbr: 'FR', label: 'Français', flag: 'fi-fr', enabled: true },
                    { code: 'en', abbr: 'EN', label: 'English', flag: 'fi-gb', enabled: false },
                    { code: 'ln', abbr: 'LN', label: 'Lingala', flag: 'fi-cd', enabled: false },
                    { code: 'kg', abbr: 'KG', label: 'Kikongo', flag: 'fi-cd', enabled: false },
                    { code: 'tsh', abbr: 'TSH', label: 'Tshiluba', flag: 'fi-cd', enabled: false },
                    { code: 'sw', abbr: 'SW', label: 'Kiswahili', flag: 'fi-cd', enabled: false },
                ] %}
                {% set currentLang = languages|filter(l => l.code == current_locale())|first %}

                <div class="topbar-dropdown">
                    <button type="button" class="topbar-dropdown-toggle">
                        <span class="fi {{ currentLang.flag }}"></span> {{ currentLang.abbr }} <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="topbar-dropdown-panel">
                        {% for lang in languages %}
                            {% if lang.enabled %}
                                <form action="{{ path('set_preferences') }}" method="post" class="setting-mini-form">
                                    <input type="hidden" name="locale" value="{{ lang.code }}">
                                    <button type="submit" class="lang-row{{ lang.code == current_locale() ? ' active' : '' }}">
                                        <span class="fi {{ lang.flag }}"></span> {{ lang.label }}
                                        {% if lang.code == current_locale() %}<i class="bi bi-check"></i>{% endif %}
                                    </button>
                                </form>
                            {% else %}
                                <span class="lang-row lang-row--disabled">
                                    <span class="fi {{ lang.flag }}"></span> {{ lang.label }}
                                </span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <span class="topbar-sep">|</span>

                {% set currencies = [{ code: 'USD', flag: 'fi-us' }, { code: 'CDF', flag: 'fi-cd' }] %}
                {% set currentCur = currencies|filter(c => c.code == current_currency())|first %}

                <div class="topbar-dropdown">
                    <button type="button" class="topbar-dropdown-toggle">
                        <span class="fi {{ currentCur.flag }}"></span> {{ currentCur.code }} <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="topbar-dropdown-panel">
                        {% for cur in currencies %}
                            <form action="{{ path('set_preferences') }}" method="post" class="setting-mini-form">
                                <input type="hidden" name="currency" value="{{ cur.code }}">
                                <button type="submit" class="lang-row{{ cur.code == current_currency() ? ' active' : '' }}">
                                    <span class="fi {{ cur.flag }}"></span> {{ cur.code }}
                                    {% if cur.code == current_currency() %}<i class="bi bi-check"></i>{% endif %}
                                </button>
                            </form>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# --- Ligne principale : logo / recherche / panier --- #}
    <div class="main-header">
        <div class="container-kb main-header-inner">
            <a href="{{ path('public_home') }}" class="logo">
                <span class="logo-kongo">Kongo</span><span class="logo-bazar">Bazar</span>
            </a>

            <form class="search-form" action="{{ path('catalog_search') }}" method="get" role="search">
                <input type="search" name="q" placeholder="{{ 'header.search_placeholder'|trans }}" autocomplete="off">
                <button type="submit" aria-label="{{ 'header.search_submit'|trans }}"><i class="icon-search bi bi-search"></i></button>
                <div class="search-suggestions" hidden></div>
            </form>

            <button class="cart-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas">
                <i class="icon-cart bi bi-cart3 cart-trigger-icon"></i>
                <span class="cart-trigger-divider"></span>
                <span class="cart-trigger-text">
                    <span class="cart-trigger-label">{{ 'cart.my_cart'|trans }}</span>
                    <span class="cart-trigger-detail">
                        <strong data-cart-count>{{ cartSummary.itemCount }}</strong> {{ 'cart.items_suffix'|trans }}
                        <span class="cart-trigger-sep">-</span>
                        {% set display = cart_display_subtotal() %}
                        <strong data-cart-total>{{ display.amount|price(display.currency) }}</strong>
                    </span>
                </span>
            </button>
        </div>
    </div>

    {# --- Navigation principale + mega menu --- #}
    <nav class="main-nav">
        <div class="container-kb main-nav-inner">
            <ul class="nav-items">
                {% for nav in navbar_items() %}
                    {% if nav.systemKey == 'all_rayons' %}
                        <li>
                            <button type="button" class="nav-rayons-trigger" data-bs-toggle="offcanvas" data-bs-target="#mainMenuOffcanvas">
                                <i class="bi bi-list"></i> {{ 'nav.all_rayons'|trans }}
                            </button>
                        </li>
                    {% elseif nav.systemKey == 'home' %}
                        <li class="{{ app.request.attributes.get('_route') == 'public_home' ? 'active' : '' }}">
                            <a href="{{ path('public_home') }}">{{ 'nav.home'|trans }}</a>
                        </li>
                    {% elseif nav.systemKey == 'catalogue' %}
                        <li class="has-mega-menu">
                            <a href="{{ path('catalog_index') }}">{{ 'nav.catalogue'|trans }}</a>
                            {% include 'public/_partials/_mega_menu_catalogue.html.twig' %}
                        </li>
                    {% elseif nav.systemKey == 'offers' %}
                        <li class="nav-simple-dropdown">
                            <button type="button" class="nav-simple-dropdown-toggle">
                                {{ 'nav.offers'|trans }} <i class="bi bi-chevron-down"></i>
                            </button>
                            <div class="nav-simple-dropdown-panel">
                                <a href="{{ path('catalog_offers_individual') }}"><i class="bi bi-person"></i> {{ 'nav.offers_individual'|trans }}</a>
                                <a href="{{ path('catalog_offers_professional') }}"><i class="bi bi-briefcase"></i> {{ 'nav.offers_professional'|trans }}</a>
                                <a href="{{ path('catalog_offers_store') }}"><i class="bi bi-shop"></i> {{ 'nav.offers_store'|trans }}</a>
                                <a href="{{ path('catalog_offers_kongobazar') }}"><i class="bi bi-award"></i> {{ 'nav.offers_kongobazar'|trans }}</a>
                            </div>
                        </li>
                    {% else %}
                        <li>
                            <a href="{{ nav.internalRoute ? path(nav.internalRoute) : nav.url }}"
                               {% if nav.openInNewTab %}target="_blank" rel="noopener"{% endif %}>
                                {{ nav.label }}
                            </a>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </nav>

    {# --- Bandeau "Tendances" (catégories les plus visitées, 7 derniers jours) --- #}
    {% set trends = trending_categories() %}
    {% if trends|length > 0 %}
        <div class="trends-bar">
            <div class="container-kb trends-bar-inner">
                <span class="trends-label">{{ 'home.trends.label'|trans }} <i class="bi bi-chevron-right"></i></span>
                {% for item in trends %}
                    <a href="{{ path('catalog_category', { slug: item.category.slug }) }}">{{ item.category.name }}</a>
                    {% if not loop.last %}<span class="trends-sep">•</span>{% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
</header>

{# --- Header condensé, affiché en JS au scroll (voir main.js) --- #}
<header id="site-header-condensed" class="site-header-condensed">
    <div class="container-kb site-header-condensed-inner condensed-inner--mobile">
        <button class="hamburger-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainMenuOffcanvas" aria-label="{{ 'menu.open'|trans }}">
            <i class="icon-menu bi bi-list"></i>
        </button>
        <a href="{{ path('public_home') }}" class="logo-small">
            <span class="logo-kongo">Kongo</span><span class="logo-bazar">Bazar</span>
        </a>

        <div class="condensed-icons">
            <button type="button" class="condensed-icon-btn" id="mobileSearchToggle" aria-label="{{ 'header.search_placeholder'|trans }}">
                <i class="bi bi-search"></i>
            </button>
            {% if app.user %}
                <div class="topbar-dropdown condensed-account-dropdown">
                    <button type="button" class="condensed-icon-btn condensed-icon-btn--account topbar-dropdown-toggle" aria-label="{{ 'header.my_account'|trans }}">
                        <i class="bi bi-person"></i>
                        <span class="condensed-account-dot" aria-hidden="true"></span>
                    </button>
                    <div class="topbar-dropdown-panel condensed-account-panel">
                        <a href="{{ path('account_index') }}"><i class="bi bi-person-circle"></i> {{ 'header.my_account'|trans }}</a>
                        <a href="{{ path('account_index') }}"><i class="bi bi-bag-check"></i> {{ 'header.order_history'|trans }}</a>
                        <a href="{{ path('wishlist_index') }}"><i class="bi bi-heart"></i> {{ 'header.my_wishlist'|trans }}</a>
                        <a href="{{ path('public_logout') }}"><i class="bi bi-box-arrow-right"></i> {{ 'header.logout'|trans }}</a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('public_login') }}" class="condensed-icon-btn" aria-label="{{ 'header.my_account'|trans }}">
                    <i class="bi bi-person"></i>
                </a>
            {% endif %}
            <a href="{{ path('wishlist_index') }}" class="condensed-icon-btn" aria-label="{{ 'header.my_wishlist'|trans }}">
                <i class="bi bi-heart"></i>
            </a>
            <button class="condensed-icon-btn condensed-icon-btn--cart" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas" aria-label="{{ 'cart.my_cart'|trans }}">
                <i class="bi bi-cart3"></i>
                <strong class="cart-count" data-cart-count>{{ cartSummary.itemCount }}</strong>
            </button>
        </div>

        <div class="mobile-search-drawer" id="mobileSearchOverlay">
            <div class="mobile-search-drawer-header">
                <h5 class="offcanvas-title">{{ 'header.search_title'|trans|default('Rechercher') }}</h5>
                <button type="button" class="btn-close-custom" id="mobileSearchClose" aria-label="{{ 'menu.close'|trans }}">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="mobile-search-drawer-body">
                <form class="search-form-condensed mobile-search-drawer-form" action="{{ path('catalog_search') }}" method="get">
                    <div class="mobile-search-drawer-inputwrap">
                        <input type="search" name="q" placeholder="{{ 'header.search_placeholder'|trans }}" autocomplete="off">
                        <button type="submit" class="mobile-search-submit"><i class="bi bi-search"></i></button>
                    </div>
                    <div class="search-suggestions" hidden></div>
                </form>
            </div>
        </div>
    </div>

    <div class="container-kb site-header-condensed-inner condensed-inner--desktop">
        <button class="hamburger-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainMenuOffcanvas" aria-label="{{ 'menu.open'|trans }}">
            <i class="icon-menu bi bi-list"></i>
        </button>
        <a href="{{ path('public_home') }}" class="logo-small">
            <span class="logo-kongo">Kongo</span><span class="logo-bazar">Bazar</span>
        </a>
        <form class="search-form-condensed-desktop" action="{{ path('catalog_search') }}" method="get">
            <input type="search" name="q" placeholder="{{ 'header.search_placeholder'|trans }}" autocomplete="off">
            <button type="submit"><i class="bi bi-search"></i></button>
            <div class="search-suggestions" hidden></div>
        </form>
        <div class="condensed-desktop-links">
            {% if app.user %}
                <div class="topbar-dropdown condensed-account-dropdown">
                    <button type="button" class="condensed-desktop-link topbar-dropdown-toggle">
                        <i class="bi bi-person"></i> {{ app.user.firstName ?: 'header.my_account'|trans }} <i class="bi bi-chevron-down condensed-account-caret"></i>
                    </button>
                    <div class="topbar-dropdown-panel condensed-account-panel">
                        <a href="{{ path('account_index') }}"><i class="bi bi-person-circle"></i> {{ 'header.my_account'|trans }}</a>
                        <a href="{{ path('account_index') }}"><i class="bi bi-bag-check"></i> {{ 'header.order_history'|trans }}</a>
                        <a href="{{ path('wishlist_index') }}"><i class="bi bi-heart"></i> {{ 'header.my_wishlist'|trans }}</a>
                        <a href="{{ path('public_logout') }}"><i class="bi bi-box-arrow-right"></i> {{ 'header.logout'|trans }}</a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('public_login') }}" class="condensed-desktop-link">
                    <i class="bi bi-person"></i> {{ 'header.my_account'|trans }}
                </a>
            {% endif %}
            {% set languages = [
                { code: 'fr', abbr: 'FR', label: 'Français', flag: 'fi-fr', enabled: true },
                { code: 'en', abbr: 'EN', label: 'English', flag: 'fi-gb', enabled: false },
                { code: 'ln', abbr: 'LN', label: 'Lingala', flag: 'fi-cd', enabled: false },
                { code: 'kg', abbr: 'KG', label: 'Kikongo', flag: 'fi-cd', enabled: false },
                { code: 'tsh', abbr: 'TSH', label: 'Tshiluba', flag: 'fi-cd', enabled: false },
                { code: 'sw', abbr: 'SW', label: 'Kiswahili', flag: 'fi-cd', enabled: false },
            ] %}
            {% set currentLang = languages|filter(l => l.code == current_locale())|first %}

            <div class="topbar-dropdown">
                <button type="button" class="topbar-dropdown-toggle condensed-desktop-link">
                    <span class="fi {{ currentLang.flag }}"></span> {{ currentLang.abbr }} <i class="bi bi-chevron-down"></i>
                </button>
                <div class="topbar-dropdown-panel">
                    {% for lang in languages %}
                        {% if lang.enabled %}
                            <form action="{{ path('set_preferences') }}" method="post" class="setting-mini-form">
                                <input type="hidden" name="locale" value="{{ lang.code }}">
                                <button type="submit" class="lang-row{{ lang.code == current_locale() ? ' active' : '' }}">
                                    <span class="fi {{ lang.flag }}"></span> {{ lang.label }}
                                    {% if lang.code == current_locale() %}<i class="bi bi-check"></i>{% endif %}
                                </button>
                            </form>
                        {% else %}
                            <span class="lang-row lang-row--disabled">
                                <span class="fi {{ lang.flag }}"></span> {{ lang.label }}
                            </span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {% set currencies = [{ code: 'USD', flag: 'fi-us' }, { code: 'CDF', flag: 'fi-cd' }] %}
            {% set currentCur = currencies|filter(c => c.code == current_currency())|first %}

            <div class="topbar-dropdown">
                <button type="button" class="topbar-dropdown-toggle condensed-desktop-link">
                    <span class="fi {{ currentCur.flag }}"></span> {{ currentCur.code }} <i class="bi bi-chevron-down"></i>
                </button>
                <div class="topbar-dropdown-panel">
                    {% for cur in currencies %}
                        <form action="{{ path('set_preferences') }}" method="post" class="setting-mini-form">
                            <input type="hidden" name="currency" value="{{ cur.code }}">
                            <button type="submit" class="lang-row{{ cur.code == current_currency() ? ' active' : '' }}">
                                <span class="fi {{ cur.flag }}"></span> {{ cur.code }}
                                {% if cur.code == current_currency() %}<i class="bi bi-check"></i>{% endif %}
                            </button>
                        </form>
                    {% endfor %}
                </div>
            </div>
            <button class="cart-trigger cart-trigger--condensed" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas">
                <i class="icon-cart bi bi-cart3"></i>
                <strong class="cart-count" data-cart-count>{{ cartSummary.itemCount }}</strong>
            </button>
        </div>
    </div>

    <button type="button" class="mobile-rayons-bar" data-bs-toggle="offcanvas" data-bs-target="#topRayonsOffcanvas">
        <i class="bi bi-star"></i> {{ 'menu.top_rayons'|trans }}
    </button>

    {% set trends = trending_categories() %}
    {% if trends|length > 0 %}
    <div class="mobile-trends-bar">
        {% for item in trends %}
            <a href="{{ path('catalog_category', { slug: item.category.slug }) }}">{{ item.category.name }}</a>
            {% if not loop.last %}<span class="trends-sep">•</span>{% endif %}
        {% endfor %}
    </div>
    {% endif %}
</header>

{# --- Tiroir latéral partagé : menu mobile / hamburger du header condensé --- #}
<div class="offcanvas offcanvas-start" tabindex="-1" id="mainMenuOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">{{ 'menu.title'|trans }}</h5>
        <div class="offcanvas-lang-currency">
            {% set languages = [
                { code: 'fr', abbr: 'FR', label: 'Français', flag: 'fi-fr', enabled: true },
                { code: 'en', abbr: 'EN', label: 'English', flag: 'fi-gb', enabled: false },
                { code: 'ln', abbr: 'LN', label: 'Lingala', flag: 'fi-cd', enabled: false },
                { code: 'kg', abbr: 'KG', label: 'Kikongo', flag: 'fi-cd', enabled: false },
                { code: 'tsh', abbr: 'TSH', label: 'Tshiluba', flag: 'fi-cd', enabled: false },
                { code: 'sw', abbr: 'SW', label: 'Kiswahili', flag: 'fi-cd', enabled: false },
            ] %}
            {% set currentLang = languages|filter(l => l.code == current_locale())|first %}

            <div class="topbar-dropdown">
                <button type="button" class="topbar-dropdown-toggle">
                    <span class="fi {{ currentLang.flag }}"></span> {{ currentLang.abbr }} <i class="bi bi-chevron-down"></i>
                </button>
                <div class="topbar-dropdown-panel">
                    {% for lang in languages %}
                        {% if lang.enabled %}
                            <form action="{{ path('set_preferences') }}" method="post" class="setting-mini-form">
                                <input type="hidden" name="locale" value="{{ lang.code }}">
                                <button type="submit" class="lang-row{{ lang.code == current_locale() ? ' active' : '' }}">
                                    <span class="fi {{ lang.flag }}"></span> {{ lang.label }}
                                    {% if lang.code == current_locale() %}<i class="bi bi-check"></i>{% endif %}
                                </button>
                            </form>
                        {% else %}
                            <span class="lang-row lang-row--disabled">
                                <span class="fi {{ lang.flag }}"></span> {{ lang.label }}
                            </span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {% set currencies = [{ code: 'USD', flag: 'fi-us' }, { code: 'CDF', flag: 'fi-cd' }] %}
            {% set currentCur = currencies|filter(c => c.code == current_currency())|first %}

            <div class="topbar-dropdown">
                <button type="button" class="topbar-dropdown-toggle">
                    <span class="fi {{ currentCur.flag }}"></span> {{ currentCur.code }} <i class="bi bi-chevron-down"></i>
                </button>
                <div class="topbar-dropdown-panel">
                    {% for cur in currencies %}
                        <form action="{{ path('set_preferences') }}" method="post" class="setting-mini-form">
                            <input type="hidden" name="currency" value="{{ cur.code }}">
                            <button type="submit" class="lang-row{{ cur.code == current_currency() ? ' active' : '' }}">
                                <span class="fi {{ cur.flag }}"></span> {{ cur.code }}
                                {% if cur.code == current_currency() %}<i class="bi bi-check"></i>{% endif %}
                            </button>
                        </form>
                    {% endfor %}
                </div>
            </div>
        </div>
        <button type="button" class="btn-close-custom" data-bs-dismiss="offcanvas" aria-label="{{ 'menu.close'|trans }}">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div class="offcanvas-body">
        {# Éléments du navbar : affichés uniquement à ≤991px, avant les rayons #}
        <ul class="offcanvas-nav-items">
            {% for nav in navbar_mobile_items() %}
                {% if nav.systemKey == 'home' %}
                    <li class="{{ app.request.attributes.get('_route') == 'public_home' ? 'active' : '' }}">
                        <a href="{{ path('public_home') }}">{{ 'nav.home'|trans }}</a>
                    </li>
                {% elseif nav.systemKey == 'catalogue' %}
                    <li><a href="{{ path('catalog_index') }}">{{ 'nav.catalogue'|trans }}</a></li>
                {% elseif nav.systemKey == 'offers' %}
                    <li>
                        <button type="button" class="offcanvas-nav-collapse-toggle" data-bs-toggle="collapse" data-bs-target="#offcanvasOffersList" aria-expanded="false">
                            {{ 'nav.offers'|trans }} <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="collapse" id="offcanvasOffersList">
                            <ul class="offcanvas-nav-sub">
                                <li><a href="{{ path('catalog_offers_individual') }}"><i class="bi bi-person"></i> {{ 'nav.offers_individual'|trans }}</a></li>
                                <li><a href="{{ path('catalog_offers_professional') }}"><i class="bi bi-briefcase"></i> {{ 'nav.offers_professional'|trans }}</a></li>
                                <li><a href="{{ path('catalog_offers_store') }}"><i class="bi bi-shop"></i> {{ 'nav.offers_store'|trans }}</a></li>
                                <li><a href="{{ path('catalog_offers_kongobazar') }}"><i class="bi bi-award"></i> {{ 'nav.offers_kongobazar'|trans }}</a></li>
                            </ul>
                        </div>
                    </li>
                {% elseif not nav.systemKey %}
                    <li>
                        <a href="{{ nav.internalRoute ? path(nav.internalRoute) : nav.url }}"{% if nav.openInNewTab %} target="_blank" rel="noopener"{% endif %}>{{ nav.label }}</a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>

        {{ menu.drillMenu(root_categories()) }}

        {# Liens utiles : visibles uniquement sur mobile (le footer est long à atteindre) #}
        <div class="offcanvas-info-links">
            <a href="#" data-scroll-to-footer><i class="bi bi-info-circle"></i> Infos &amp; aide</a>
            {% for item in footer_bottom_links() %}
                <a href="{{ item.internalRoute ? path(item.internalRoute) : item.url }}"{% if item.openInNewTab %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </div>
        <script>
            document.querySelectorAll('[data-scroll-to-footer]').forEach(function (link) {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    var drawer = link.closest('.offcanvas');
                    var closeBtn = drawer && drawer.querySelector('[data-bs-dismiss="offcanvas"]');
                    if (closeBtn) closeBtn.click();
                    // On attend la fermeture du tiroir avant de défiler
                    setTimeout(function () {
                        // Page campagne : même saut que le bouton flottant (chargement automatique en pause)
                        var shortcut = document.getElementById('soldeFooterShortcut');
                        if (shortcut) { shortcut.click(); return; }
                        var footer = document.querySelector('footer.site-footer');
                        if (footer) footer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 350);
                });
            });
        </script>
    </div>
</div>

{# --- Tiroir latéral dédié "Top Rayons" (bande bleue mobile), distinct du menu complet --- #}
<div class="offcanvas offcanvas-start" tabindex="-1" id="topRayonsOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title"><i class="bi bi-star"></i> {{ 'menu.top_rayons'|trans }}</h5>
        <button type="button" class="btn-close-custom" data-bs-dismiss="offcanvas" aria-label="{{ 'menu.close'|trans }}">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div class="offcanvas-body">
        <ul class="top-rayons-offcanvas-list">
            {% for rayon in top_rayons() %}
                <li>
                    <a href="{{ path('catalog_rayon', { slug: rayon.slug }) }}">
                        <i class="bi {{ rayon.icon|default('bi-tag') }}"></i>
                        {{ rayon.name }}
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            {% endfor %}
        </ul>
        <a href="{{ path('catalog_index') }}" class="top-rayons-offcanvas-seeall">
            {{ 'menu.voir_tous_rayons'|trans }} <i class="bi bi-chevron-right"></i>
        </a>

        {% set topRayonsAd = mobile_top_rayons_ad() %}
        {% if topRayonsAd and topRayonsAd.imageName %}
            <a {% if topRayonsAd.targetUrl %}href="{{ path('ads_click', { id: topRayonsAd.id, zoneKey: 'mobile_top_rayons_offcanvas' }) }}"{% endif %}{% if topRayonsAd.openInNewTab %} target="_blank" rel="noopener"{% endif %} class="top-rayons-offcanvas-ad{{ topRayonsAd.targetUrl ? ' ad-clickable' : '' }}">
                <img src="{{ vich_uploader_asset(topRayonsAd, 'imageFile') }}" alt="{{ topRayonsAd.title }}" loading="lazy">
            </a>
        {% endif %}
    </div>
</div>

{# --- Bouton retour en haut, affiché en JS au scroll --- #}
<button id="back-to-top" class="back-to-top" type="button" aria-label="{{ 'header.back_to_top'|trans }}">
    <i class="icon-arrow-up bi bi-arrow-up"></i>
</button>
