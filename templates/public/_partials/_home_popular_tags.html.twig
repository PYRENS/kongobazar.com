{# ==========================================================================
   "Popular Tags" — logos de marques mises en avant + mosaïque lifestyle
   Contexte attendu :
     - featuredBrands   : Brand[] (featuredHomepage = true, triées par featuredHomepagePosition)
     - adLifestyleLeft   : Advertisement|null (zoneKey homepage_lifestyle_left)
     - adLifestyleCenter : Advertisement|null (zoneKey homepage_lifestyle_center)
     - adLifestyleRight  : Advertisement|null (zoneKey homepage_lifestyle_right)
   ========================================================================== #}
<section class="home-popular-tags">
    <div class="popular-tags-grid">
        <aside class="popular-tags-brands">
            {% for brand in featuredBrands|default([]) %}
                <a href="{{ path('catalog_brand', { slug: brand.slug }) }}" class="brand-tag-item" title="{{ brand.name }}">
                    {% if brand.logoName %}
                        <img src="{{ vich_uploader_asset(brand, 'logoFile') }}" alt="{{ brand.name }}" loading="lazy">
                    {% else %}
                        <span class="brand-tag-fallback">{{ brand.name|slice(0, 2)|upper }}</span>
                    {% endif %}
                </a>
            {% endfor %}
        </aside>

        <div class="popular-tags-lifestyle">
            {% if adLifestyleLeft is defined and adLifestyleLeft %}
                <a {% if adLifestyleLeft.targetUrl %}href="{{ path('ads_click', { id: adLifestyleLeft.id, zoneKey: 'homepage_lifestyle_left' }) }}"{% endif %}{% if adLifestyleLeft.openInNewTab %} target="_blank" rel="noopener"{% endif %} class="lifestyle-cell lifestyle-cell--side{{ adLifestyleLeft.targetUrl ? ' ad-clickable' : '' }}">
                    <img src="{{ vich_uploader_asset(adLifestyleLeft, 'imageFile') }}" alt="{{ adLifestyleLeft.title }}" loading="lazy">
                </a>
            {% endif %}

            {% if adLifestyleCenter is defined and adLifestyleCenter %}
                <a {% if adLifestyleCenter.targetUrl %}href="{{ path('ads_click', { id: adLifestyleCenter.id, zoneKey: 'homepage_lifestyle_center' }) }}"{% endif %}{% if adLifestyleCenter.openInNewTab %} target="_blank" rel="noopener"{% endif %} class="lifestyle-cell lifestyle-cell--center{{ adLifestyleCenter.targetUrl ? ' ad-clickable' : '' }}">
                    <img src="{{ vich_uploader_asset(adLifestyleCenter, 'imageFile') }}" alt="{{ adLifestyleCenter.title }}" loading="lazy">
                </a>
            {% endif %}

            {% if adLifestyleRight is defined and adLifestyleRight %}
                <a {% if adLifestyleRight.targetUrl %}href="{{ path('ads_click', { id: adLifestyleRight.id, zoneKey: 'homepage_lifestyle_right' }) }}"{% endif %}{% if adLifestyleRight.openInNewTab %} target="_blank" rel="noopener"{% endif %} class="lifestyle-cell lifestyle-cell--side{{ adLifestyleRight.targetUrl ? ' ad-clickable' : '' }}">
                    <img src="{{ vich_uploader_asset(adLifestyleRight, 'imageFile') }}" alt="{{ adLifestyleRight.title }}" loading="lazy">
                </a>
            {% endif %}
        </div>
    </div>
</section>
