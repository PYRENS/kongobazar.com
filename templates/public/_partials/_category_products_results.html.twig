{# ==========================================================================
   Grille produits + pagination de la page /categorie — utilisée au chargement
   complet ET par le filtre en direct (une seule source, plus de divergence).
   Contexte attendu : products, reviewStats, currentPage, totalPages,
   filterParams (tous les filtres actifs + slug), categoryGridCardAd (optionnel)
   ========================================================================== #}
{% if products|length > 0 %}
    {# Carte sponsorisée : après le 10e produit (2 rangées desktop), ou en fin de liste s'il y en a moins #}
    {% set adSlot = min(10, products|length) %}
    <div class="home-product-grid" style="margin-top: 20px;">
        {% for product in products %}
            <div class="product-card">
                <div class="product-card-media">
                    <img src="{{ product.images|length > 0 ? vich_uploader_asset(product.images|first, 'imageFile') : '' }}" alt="{{ product.title }}" class="product-card-main-image" loading="lazy">
                    {% if product.activeDiscountPercent %}
                        <span class="badge-discount">-{{ product.activeDiscountPercent }}%</span>
                    {% elseif product.compareAtPrice %}
                        <span class="badge-discount">-{{ ((1 - (product.basePrice / product.compareAtPrice)) * 100)|round }}%</span>
                    {% endif %}
                    {% if product.brand and product.brand.logoName %}
                        <img src="{{ vich_uploader_asset(product.brand, 'logoFile') }}" alt="{{ product.brand.name }}" class="product-card-brand-logo">
                    {% endif %}
                    {% set stats = reviewStats[product.id]|default(null) %}
                    {% if stats and stats.count > 0 %}
                        <div class="product-card-rating-badge">
                            {% include 'public/_partials/_star_rating.html.twig' with { average: stats.average, count: stats.count } %}
                        </div>
                    {% endif %}
                    {% include 'public/_partials/_product_icons_wishlist.html.twig' with { product: product } %}
                </div>
                <div class="product-card-body">
                    <a href="{{ path('catalog_product', { slug: product.slug }) }}" class="product-card-title">{{ product.title }}</a>
                    <div class="product-card-price">
                        <span class="price-now">{{ product.displayCurrentPrice|price(product.currency) }}</span>
                        {% if product.displayOldPrice %}
                            <span class="price-old">{{ product.displayOldPrice|price(product.currency) }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            {% if loop.index == adSlot and categoryGridCardAd|default(null) and categoryGridCardAd.imageName %}
                {% set ad = categoryGridCardAd %}
                <a {% if ad.targetUrl %}href="{{ path('ads_click', { id: ad.id, zoneKey: 'category_grid_card' }) }}" rel="sponsored{{ ad.openInNewTab ? ' noopener' : '' }}"{% endif %}{% if ad.openInNewTab %} target="_blank"{% endif %} class="product-card ad-grid-card{{ ad.targetUrl ? ' ad-clickable' : '' }}">
                    <img src="{{ vich_uploader_asset(ad, 'imageFile') }}" alt="{{ ad.title }}" loading="lazy">
                    <span class="ad-sponsored-badge">Sponsorisé</span>
                </a>
            {% endif %}
        {% endfor %}
    </div>

    {% if totalPages > 1 %}
        <nav class="search-pagination" aria-label="Pages de résultats">
            {% if currentPage > 1 %}
                <a href="{{ path('catalog_category', filterParams|merge({ page: currentPage - 1 })) }}" class="search-pagination-link" data-live-filter-loadmore>
                    <i class="bi bi-chevron-left"></i>
                </a>
            {% endif %}
            {% for p in 1..totalPages %}
                {% if p == 1 or p == totalPages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                    <a href="{{ path('catalog_category', filterParams|merge({ page: p })) }}" class="search-pagination-link{{ p == currentPage ? ' active' : '' }}" data-live-filter-loadmore>
                        {{ p }}
                    </a>
                {% elseif p == currentPage - 2 or p == currentPage + 2 %}
                    <span class="search-pagination-dots">…</span>
                {% endif %}
            {% endfor %}
            {% if currentPage < totalPages %}
                <a href="{{ path('catalog_category', filterParams|merge({ page: currentPage + 1 })) }}" class="search-pagination-link" data-live-filter-loadmore>
                    <i class="bi bi-chevron-right"></i>
                </a>
            {% endif %}
        </nav>
    {% endif %}
{% else %}
    <p class="text-muted" style="margin-top:20px;">Aucun produit ne correspond à ces filtres dans cette catégorie.</p>
{% endif %}