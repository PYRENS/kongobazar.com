{# ==========================================================================
   Un "lot" de produits soldés — utilisé au chargement initial ET renvoyé par
   l'endpoint AJAX de défilement infini (avec une bannière pub aléatoire avant
   le lot, sauf pour le tout premier rendu de la page).
   Contexte : products (Product[]), ad (Advertisement|null), hasMore (bool), nextOffset (int)
   ========================================================================== #}
{% if ad and ad.imageName %}
    <a {% if ad.targetUrl %}href="{{ path('ads_click', { id: ad.id, zoneKey: 'solde_between_batches' }) }}"{% endif %}{% if ad.openInNewTab %} target="_blank" rel="noopener"{% endif %} class="solde-batch-ad{{ ad.targetUrl ? ' ad-clickable' : '' }}">
        <img src="{{ vich_uploader_asset(ad, 'imageFile') }}" alt="{{ ad.title }}" loading="lazy">
    </a>
{% endif %}

{% set model = cardModel|default(campaign.cardModel|default('classic')) %}
{% set ctype = campaignType|default(campaign.type|default('solde')) %}
{% set cEnd = campaignEnd|default(campaign.endAt|default(null)) %}
<div class="home-product-grid solde-product-grid solde-card--{{ model }}">
    {% for product in products %}
        <div class="product-card">
            {% if ctype == 'vente_flash' %}
                {% set flashEnd = product.activeDiscountEndAt ?? cEnd %}
                {% if flashEnd %}
                    <div class="home-deal-countdown flash-countdown" data-flash-end="{{ flashEnd|date('c') }}">
                        <div class="countdown-boxes">
                            <div><span data-cd-days>--</span><small>{{ 'home.days'|trans|default('Jours') }}</small></div>
                            <div><span data-cd-hours>--</span><small>{{ 'home.hours'|trans|default('Heures') }}</small></div>
                            <div><span data-cd-mins>--</span><small>{{ 'home.mins'|trans|default('Min') }}</small></div>
                            <div><span data-cd-secs>--</span><small>{{ 'home.secs'|trans|default('Sec') }}</small></div>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            <div class="product-card-media">
                <img src="{{ product.images|length > 0 ? vich_uploader_asset(product.images|first, 'imageFile') : '' }}"
                     alt="{{ product.title }}"
                     class="product-card-main-image"
                     loading="lazy">
                <span class="badge-solde">{{ ctype == 'solde' ? 'SOLDE' : (ctype == 'vente_flash' ? 'FLASH' : 'PROMO') }} -{{ product.activeDiscountPercent }}%</span>
                {% if product.brand and product.brand.logoName %}
                    <img src="{{ vich_uploader_asset(product.brand, 'logoFile') }}" alt="{{ product.brand.name }}" class="product-card-brand-logo">
                {% endif %}
            </div>
            <div class="product-card-body">
                <a href="{{ path('catalog_product', { slug: product.slug }) }}" class="product-card-title">{{ product.title }}</a>
                <div class="product-card-price">
                    <span class="price-now">{{ product.displayCurrentPrice|price(product.currency) }}</span>
                    {% if product.displayOldPrice %}
                        <span class="price-old">{{ product.displayOldPrice|price(product.currency) }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucun produit ne correspond à ces filtres pour l'instant.</p>
    {% endfor %}
</div>

{% if hasMore %}
    <div class="solde-scroll-sentinel" data-solde-sentinel data-next-offset="{{ nextOffset }}"></div>
{% endif %}
