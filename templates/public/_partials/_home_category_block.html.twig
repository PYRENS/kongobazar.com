{# ==========================================================================
   Bloc catégorie complet et autonome, géré depuis l'admin (HomeCategoryBlockSetting).
   Contexte attendu à l'inclusion :
     - block          : HomeCategoryBlockSetting (pour l'id, utilisé par l'AJAX)
     - category       : Category (celle du bloc, choisie par cascade en admin)
     - blockIcon      : classe bi bi-* pour l'icône du bandeau
     - subcategories  : HomeCategoryBlockSubcategory[] (réordonnables en admin)
     - initialProducts: Product[] (premier onglet "Meilleures ventes" par défaut)
     - blockBanner    : Advertisement|null (relatedCategory = category)
   ========================================================================== #}
<section class="home-category-block" data-block-id="{{ block.id }}" data-root-category-id="{{ category.id }}">
    <div class="category-block-grid">
        <aside class="category-block-sidebar" style="background:{{ category.effectiveThemeColor|default('#2FA8E0') }}; --block-color:{{ category.effectiveThemeColor|default('#2FA8E0') }};">
            <h5><i class="bi {{ blockIcon|default('bi-grid') }}"></i> {{ category.name|upper }}</h5>
            <ul>
                {% for item in subcategories|default([]) %}
                    <li><a href="#" class="category-block-subcat-link{{ loop.first ? ' active' : '' }}" data-subcategory-id="{{ item.category.id }}">{{ item.category.name }}</a></li>
                {% endfor %}
                <li>
                    <a href="#" class="category-block-subcat-link category-block-view-all{{ subcategories|default([])|length == 0 ? ' active' : '' }}" data-subcategory-id="{{ category.id }}">{{ 'home.see_all'|trans }}</a>
                </li>
            </ul>
        </aside>

        <div class="category-block-main">
            <div class="category-block-head">
                <div class="category-block-sort-tabs" role="tablist">
                    {% for tab in sortTabs|default([])|filter(t => t.visible) %}
                        <button type="button" class="sort-tab{{ loop.first ? ' active' : '' }}" data-sort="{{ tab.sortKey }}">{{ ('home.sort_' ~ tab.sortKey)|trans }}</button>
                    {% endfor %}
                </div>
                <div class="home-carousel-nav">
                    <button type="button" class="carousel-arrow" aria-label="{{ 'home.prev'|trans }}"><i class="bi bi-chevron-left"></i></button>
                    <button type="button" class="carousel-arrow" aria-label="{{ 'home.next'|trans }}"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>

            <div class="category-block-products" data-products-url="{{ path('public_home_category_block_products', {blockId: block.id}) }}">
                {% include 'public/_partials/_home_category_block_products.html.twig' with {products: initialProducts|default([])} %}
            </div>

            {% if blockBanner is defined and blockBanner %}
                <a {% if blockBanner.targetUrl %}href="{{ path('ads_click', { id: blockBanner.id, zoneKey: blockBanner.zoneKey }) }}"{% endif %}{% if blockBanner.openInNewTab %} target="_blank" rel="noopener"{% endif %} class="category-block-banner{{ blockBanner.targetUrl ? ' ad-clickable' : '' }}">
                    <img src="{{ vich_uploader_asset(blockBanner, 'imageFile') }}" alt="{{ blockBanner.title }}" loading="lazy">
                </a>
            {% endif %}
        </div>
    </div>
</section>
