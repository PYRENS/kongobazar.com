{# ==========================================================================
   Position dans la liste : « 1–30 sur 72 articles · Page 1 / 3 » (/categorie, onglet Produits de /recherche).
   Conteneur toujours rendu (data-listing-pageinfo) : le filtre en direct le remplace
   après chaque filtre, tri ou changement de page.
   Attendu : total, currentPage, totalPages, perPage
   ========================================================================== #}
<div class="listing-page-info" data-listing-pageinfo>
    {% set total = total|default(0) %}
    {% if total > 0 %}
        {% set first = (currentPage - 1) * perPage + 1 %}
        {% set last = min(currentPage * perPage, total) %}
        <span><strong>{{ first }}–{{ last }}</strong> sur {{ total }} article{{ total > 1 ? 's' : '' }}</span>
        {% if totalPages > 1 %}
            <span class="listing-page-info-sep">·</span>
            <span>Page <strong>{{ currentPage }}</strong> / {{ totalPages }}</span>
        {% endif %}
    {% else %}
        <span>Aucun article</span>
    {% endif %}
</div>