{# ==========================================================================
   Affichage des étoiles. Attend : average (float|null), count (int).
   N'affiche rien du tout si count vaut 0 — jamais d'étoiles inventées pour
   un produit qui n'a aucun avis.
   ========================================================================== #}
{% if count|default(0) > 0 %}
    <div class="star-rating" title="{{ average }} / 5 ({{ count }} avis)">
        {% for i in 1..5 %}
            {% if average >= i %}
                <i class="bi bi-star-fill"></i>
            {% elseif average >= i - 0.5 %}
                <i class="bi bi-star-half"></i>
            {% else %}
                <i class="bi bi-star"></i>
            {% endif %}
        {% endfor %}
        <span class="star-rating-count">({{ count }})</span>
    </div>
{% endif %}