{# ==========================================================================
   "Consulté récemment" — historique de navigation par cookie (kb_recently_viewed),
   même modèle visuel que "Les plus consultés".
   Contexte attendu :
     - recentlyViewedEnabled : bool
     - recentlyViewedProducts : Product[] (ordre = ordre de consultation, le plus récent d'abord)
   ========================================================================== #}
{% if recentlyViewedEnabled and recentlyViewedProducts|default([])|length > 0 %}
<section class="home-most-viewed home-top-categories">
    <div class="home-deals-head">
        <span class="home-section-badge">Consulté récemment</span>
        <span class="home-deals-head-line"></span>
    </div>
    <div class="home-top-categories-wrap">
        <button type="button" class="carousel-arrow carousel-arrow--edge left" data-carousel-prev aria-label="{{ 'home.prev'|trans }}"><i class="bi bi-chevron-left"></i></button>
        <div class="most-viewed-track" data-scroll-track>
            {% for product in recentlyViewedProducts %}
                <div class="most-viewed-card-wrap product-card">
                    <a href="{{ path('catalog_product', { slug: product.slug }) }}" class="most-viewed-card">
                        <div class="most-viewed-media product-card-media">
                            <img src="{{ product.images|length > 0 ? vich_uploader_asset(product.images|first, 'imageFile') : '' }}" alt="{{ product.title }}" loading="lazy">
                            {% if product.brand and product.brand.logoName %}
                                <img src="{{ vich_uploader_asset(product.brand, 'logoFile') }}" alt="{{ product.brand.name }}" class="product-card-brand-logo">
                            {% endif %}
                            {% set stats = product_review_stats(product) %}
                            {% if stats.count > 0 %}
                                <div class="product-card-rating-badge">
                                    {% include 'public/_partials/_star_rating.html.twig' with { average: stats.average, count: stats.count } %}
                                </div>
                            {% endif %}
                            {% include 'public/_partials/_product_icons_wishlist.html.twig' with { product: product, asButton: true } %}
                        </div>
                        <div class="most-viewed-info">
                            <p class="most-viewed-title">{{ product.title }}</p>
                            <div class="new-items-price">
                                <span class="price-now">{{ product.displayCurrentPrice|price(product.currency) }}</span>
                                {% if product.displayOldPrice %}
                                    <span class="price-old">{{ product.displayOldPrice|price(product.currency) }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
        <button type="button" class="carousel-arrow carousel-arrow--edge right" data-carousel-next aria-label="{{ 'home.next'|trans }}"><i class="bi bi-chevron-right"></i></button>
    </div>
</section>
{% endif %}