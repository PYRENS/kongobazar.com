{# ==========================================================================
   Bandeau "Comment ça marche" — 4 étapes du parcours d'achat.
   Affichage et emplacement pilotés en admin (/parametres/comment-ca-marche-accueil).
   Variante optionnelle (hiwVariant) :
     - 'column' : dans la colonne centrale (plus étroite)
     - 'bottom' : dans le bas de page pleine largeur (déjà sans marges négatives)
   ========================================================================== #}
<section class="home-how-it-works{{ hiwVariant is defined and hiwVariant ? ' home-how-it-works--' ~ hiwVariant : '' }}">
    <div class="how-it-works-step">
        <div class="how-it-works-icon"><i class="bi bi-search"></i></div>
        <div class="how-it-works-number">1</div>
        <h3>{{ 'home.how_it_works.step1_title'|trans }}</h3>
        <p>{{ 'home.how_it_works.step1_text'|trans }}</p>
    </div>
    <div class="how-it-works-step">
        <div class="how-it-works-icon"><i class="bi bi-credit-card"></i></div>
        <div class="how-it-works-number">2</div>
        <h3>{{ 'home.how_it_works.step2_title'|trans }}</h3>
        <p>{{ 'home.how_it_works.step2_text'|trans }}</p>
    </div>
    <div class="how-it-works-step">
        <div class="how-it-works-icon"><i class="bi bi-truck"></i></div>
        <div class="how-it-works-number">3</div>
        <h3>{{ 'home.how_it_works.step3_title'|trans }}</h3>
        <p>{{ 'home.how_it_works.step3_text'|trans }}</p>
    </div>
    <div class="how-it-works-step">
        <div class="how-it-works-icon"><i class="bi bi-box-seam"></i></div>
        <div class="how-it-works-number">4</div>
        <h3>{{ 'home.how_it_works.step4_title'|trans }}</h3>
        <p>{{ 'home.how_it_works.step4_text'|trans }}</p>
    </div>
</section>