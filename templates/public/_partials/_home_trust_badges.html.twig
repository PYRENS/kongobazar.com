{# ==========================================================================
   Bandeau de badges qualité — contenu statique, pas administrable
   (peu de raisons de changer souvent, décision actée avec l'utilisateur)
   ========================================================================== #}
<section class="home-trust-badges">
    <div class="trust-badge-item">
        <i class="bi bi-award"></i>
        <span>{{ 'home.badge.quality'|trans }}</span>
    </div>
    <div class="trust-badge-item">
        <i class="bi bi-patch-check"></i>
        <span>{{ 'home.badge.verified_sellers'|trans }}</span>
    </div>
    <div class="trust-badge-item">
        <i class="bi bi-shield-lock"></i>
        <span>{{ 'home.badge.secure_payment'|trans }}</span>
    </div>
    <div class="trust-badge-item">
        <i class="bi bi-geo-alt"></i>
        <span>{{ 'home.badge.local_delivery'|trans }}</span>
    </div>
    <div class="trust-badge-item">
        <i class="bi bi-headset"></i>
        <span>{{ 'home.badge.support'|trans }}</span>
    </div>
</section>
