{# ==========================================================================
   "Articles tendances" — onglets par catégorie (Category.featuredHomepageTab),
   grille de produits avec interactions au survol :
     - gauche de la carte : panier / aperçu rapide / wishlist
     - droite de la carte : vignettes galerie (ProductImage), le survol
       remplace temporairement l'image principale affichée
   Contexte attendu :
     - trendingTabCategories : Category[] (featuredHomepageTab = true, triées par featuredHomepagePosition)
     - trendingProductsByCategory : { categorySlug: Product[] } — un tableau de produits par catégorie
   ========================================================================== #}
{% if trendingEnabled %}
<section class="home-trending">
    <div class="home-trending-head">
        <span class="home-section-badge">{{ 'home.trending_articles'|trans }}</span>
        <span class="home-trending-head-line"></span>
        <div class="home-trending-tabs" role="tablist">
            {% for category in trendingTabCategories|default([]) %}
                <button type="button"
                        class="trending-tab{{ loop.first ? ' active' : '' }}"
                        data-tab-target="trending-panel-{{ category.id }}"
                        role="tab"
                        aria-selected="{{ loop.first ? 'true' : 'false' }}">
                    {{ category.name }}
                </button>
            {% endfor %}
        </div>
    </div>

    <div class="home-trending-panels">
        {% for category in trendingTabCategories|default([]) %}
            {% set perPage = trendingTabProductCounts[category.slug] ?? 8 %}
            {% set productPages = (trendingProductsByCategory[category.slug] ?? [])|batch(perPage) %}
            <div class="trending-panel{{ loop.first ? ' active' : '' }}" id="trending-panel-{{ category.id }}" data-desktop-per-page="{{ perPage }}">
                <div class="trending-panel-toolbar">
                    <div class="trending-page-dots">
                        {% for page in productPages %}
                            <button type="button" class="trending-page-dot{{ loop.first ? ' active' : '' }}" data-page="{{ loop.index0 }}"></button>
                        {% endfor %}
                    </div>
                    <div class="trending-panel-actions">
                        {% if productPages|length > 1 %}
                            <button type="button" class="trending-page-arrow trending-page-arrow--prev" disabled><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="trending-page-arrow trending-page-arrow--next"{{ productPages|length <= 1 ? ' disabled' : '' }}><i class="bi bi-chevron-right"></i></button>
                        {% endif %}
                        <a href="{{ path('catalog_category', { slug: category.slug }) }}" class="see-all-link">{{ 'home.see_all'|trans }}</a>
                    </div>
                </div>
                {% for page in productPages %}
                <div class="trending-product-page{{ loop.first ? ' active' : '' }}" data-page="{{ loop.index0 }}">
                <div class="home-product-grid">
                    {% for product in page %}
                        <div class="product-card">
                            <div class="product-card-media">
                                <img src="{{ product.images|length > 0 ? vich_uploader_asset(product.images|first, 'imageFile') : '' }}"
                                     alt="{{ product.title }}"
                                     class="product-card-main-image"
                                     data-main-image
                                     loading="lazy">

                                {# NOTE: le contrôleur devra fournir un simple product.isRecent (bool)
                                   calculé côté PHP plutôt que de comparer des dates ici en Twig #}
                                {% if product.isRecent is defined and product.isRecent %}
                                    <span class="badge-new">{{ 'home.new'|trans }}</span>
                                {% endif %}
                                {% if product.activeDiscountPercent %}
                                    <span class="badge-discount">-{{ product.activeDiscountPercent }}%</span>
                                {% elseif product.compareAtPrice %}
                                    <span class="badge-discount">
                                        -{{ ((1 - (product.basePrice / product.compareAtPrice)) * 100)|round }}%
                                    </span>
                                {% endif %}

                                {% if product.brand and product.brand.logoName %}
                                    <img src="{{ vich_uploader_asset(product.brand, 'logoFile') }}" alt="{{ product.brand.name }}" class="product-card-brand-logo">
                                {% endif %}
                                {% set stats = product_review_stats(product) %}
                                {% if stats.count > 0 %}
                                    <div class="product-card-rating-badge">
                                        {% include 'public/_partials/_star_rating.html.twig' with { average: stats.average, count: stats.count } %}
                                    </div>
                                {% endif %}

                                {# Actions au survol, à gauche #}
                                {# Cœur "liste de souhaits" : à part, toujours visible et rouge si déjà en liste #}
                                {% include 'public/_partials/_product_icons_wishlist.html.twig' with { product: product } %}

                                {# Vignettes galerie, à droite #}
                                {% if product.images|length > 1 %}
                                    <div class="product-card-gallery-thumbs">
                                        {% for image in product.images|slice(0, 4) %}
                                            <button type="button"
                                                    class="gallery-thumb{{ loop.first ? ' active' : '' }}"
                                                    data-swap-image="{{ vich_uploader_asset(image, 'imageFile') }}">
                                                <img src="{{ vich_uploader_asset(image, 'imageFile') }}" alt="" loading="lazy">
                                            </button>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="product-card-body">
                                <a href="{{ path('catalog_product', { slug: product.slug }) }}" class="product-card-title">{{ product.title }}</a>
                                <div class="product-card-price">
                                    <span class="price-now">{{ product.displayCurrentPrice|price(product.currency) }}</span>
                                    {% if product.displayOldPrice %}
                                        <span class="price-old">{{ product.displayOldPrice|price(product.currency) }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}
