<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="mask-icon" href="{{ asset('safari-pinned-tab.svg') }}" color="#2FA8E0">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <meta name="theme-color" content="#2FA8E0">

    {# seoData : rempli par les pages qui appellent seo('type', id, pageKey, {defaults}) — voir SeoResolver. #}
    {% set seoData = seoData ?? null %}
    <meta name="description" content="{% block meta_description %}{{ seoData and seoData.metaDescription ? seoData.metaDescription : 'KongoBazar — la marketplace de référence en RDC' }}{% endblock %}">
    {% if seoData and seoData.metaKeywords %}<meta name="keywords" content="{{ seoData.metaKeywords }}">{% endif %}
    {% if seoData and (seoData.noIndex or seoData.noFollow) %}
        <meta name="robots" content="{{ seoData.noIndex ? 'noindex' : 'index' }},{{ seoData.noFollow ? 'nofollow' : 'follow' }}">
    {% endif %}

    <title>{% block title %}{{ seoData and seoData.metaTitle ? seoData.metaTitle : 'KongoBazar' }}{% endblock %}</title>

    <link rel="canonical" href="{{ app.request.uri }}">
    <meta property="og:title" content="{% block og_title %}{{ seoData and seoData.ogTitle ? seoData.ogTitle : block('title') }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ seoData and seoData.ogDescription ? seoData.ogDescription : block('meta_description') }}{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:image" content="{% block og_image %}{{ seoData and seoData.ogImageUrl ? seoData.ogImageUrl : (app.request.schemeAndHttpHost ~ asset('images/og-default.jpg')) }}{% endblock %}">

    {# --- Bootstrap 5 (CSS) --- #}
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous">

    {# --- Bootstrap Icons (CSS) --- #}
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {# --- CDN --- #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css">

    {# --- Styles propres au projet, chargés après pour pouvoir surcharger Bootstrap --- #}
    <link rel="stylesheet" href="{{ asset('styles/public/main.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/home-content.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/footer.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/product.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/cart-page.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/cookie-consent.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/offers.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body class="site-body"{% if currentCategory is defined and currentCategory and currentCategory.effectiveThemeColor %} style="--kb-theme-color: {{ currentCategory.effectiveThemeColor }};"{% endif %}>

    {% include 'public/_partials/_header.html.twig' %}
    {% include 'public/_partials/_cart_offcanvas.html.twig' %}
    {% include 'public/_partials/_breadcrumb.html.twig' %}
    {% include 'public/_partials/_cookie_consent.html.twig' %}

    <main class="site-main">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        {% include 'public/_partials/_footer.html.twig' %}
    {% endblock %}

    {# --- Bootstrap 5 (JS bundle : inclut Popper, nécessaire pour offcanvas/dropdowns) --- #}
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>

    {# --- Scripts propres au projet --- #}
    <script src="{{ asset('js/public/main.js') }}" defer></script>
    <script src="{{ asset('js/public/home-content.js') }}" defer></script>
    <script src="{{ asset('js/public/search.js') }}" defer></script>
    <script src="{{ asset('js/public/geo-cascade.js') }}" defer></script>
    <script src="{{ asset('js/public/product.js') }}" defer></script>
    <script src="{{ asset('js/public/cart-page.js') }}" defer></script>
    <script src="{{ asset('js/public/cookie-consent.js') }}" defer></script>
    <script src="{{ asset('js/public/offers.js') }}" defer></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
