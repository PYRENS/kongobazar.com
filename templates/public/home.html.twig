{% extends 'public/base.html.twig' %}

{% block title %}{{ seoData and seoData.metaTitle ? seoData.metaTitle : 'KongoBazar — La marketplace de référence en RDC' }}{% endblock %}

{% block body %}
    {% include 'public/_partials/_hero.html.twig' %}
    {% include 'public/_partials/_home_how_it_works.html.twig' %}

    {% if promoStripBanners|default([])|length > 0 %}
        <div class="home-promo-strip" data-desktop-count="{{ promoStripDisplayCount }}">
            {% for banner in promoStripBanners %}
                <a {% if banner.targetUrl %}href="{{ banner.targetUrl }}"{% endif %}{% if banner.openInNewTab %} target="_blank" rel="noopener"{% endif %} class="home-promo-strip-item{{ loop.index > promoStripDisplayCount ? ' home-promo-strip-item--overflow' : '' }}">
                    <img src="{{ vich_uploader_asset(banner, 'imageFile') }}" alt="{{ banner.title }}" loading="lazy">
                </a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="home-layout">
        {% include 'public/_partials/_home_left_column.html.twig' %}

        <div class="home-center-col">
            {% include 'public/_partials/_home_center_top.html.twig' %}
            {% include 'public/_partials/_home_trending_tabs.html.twig' %}

            {% include 'public/_partials/_home_new_items.html.twig' %}

            {% include 'public/_partials/_home_coming_soon.html.twig' %}

            {% include 'public/_partials/_home_individual.html.twig' %}

            {% if categoryBlocksEnabled %}
                {% for row in featuredBlocks|default([]) %}
                    {% include 'public/_partials/_home_category_block.html.twig' with {
                        block: row.block,
                        category: row.category,
                        blockIcon: row.icon,
                        subcategories: row.subcategories,
                        sortTabs: row.sortTabs,
                        initialProducts: row.initialProducts,
                        blockBanner: row.banner
                    } %}
                {% endfor %}
            {% endif %}

        </div>
    </div>

    <div class="home-full-width-bottom">
        {% include 'public/_partials/_home_top_categories_vendors.html.twig' %}
        {% include 'public/_partials/_home_most_viewed.html.twig' %}
        {% include 'public/_partials/_home_latest_blogs.html.twig' %}
        {% include 'public/_partials/_home_sponsor_brands.html.twig' %}
        {% include 'public/_partials/_home_partners.html.twig' %}
    </div>
{% endblock %}
