{% extends 'public/base.html.twig' %}

{% block title %}{{ seoData and seoData.metaTitle ? seoData.metaTitle : 'KongoBazar — La marketplace de référence en RDC' }}{% endblock %}

{% block body %}
    {% include 'public/_partials/_hero.html.twig' %}
    {% include 'public/_partials/_home_how_it_works.html.twig' %}

    <div class="home-layout">
        {% include 'public/_partials/_home_left_column.html.twig' %}

        <div class="home-center-col">
            {% include 'public/_partials/_home_center_top.html.twig' %}
            {% include 'public/_partials/_home_trending_tabs.html.twig' %}

            {% if categoryBlocksEnabled %}
                {% for row in featuredBlocks|default([]) %}
                    {% include 'public/_partials/_home_category_block.html.twig' with {
                        block: row.block,
                        category: row.category,
                        blockIcon: row.icon,
                        subcategories: row.subcategories,
                        sortTabs: row.sortTabs,
                        initialProducts: row.initialProducts,
                        blockBanner: row.banner
                    } %}
                {% endfor %}
            {% endif %}

            {% include 'public/_partials/_home_top_categories_vendors.html.twig' %}
            {% include 'public/_partials/_home_popular_tags.html.twig' %}
            {% include 'public/_partials/_home_trust_badges.html.twig' %}
            {% include 'public/_partials/_home_most_viewed.html.twig' %}
        </div>
    </div>
{% endblock %}
