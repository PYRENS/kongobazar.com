<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ document.label }} — KongoBazar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('styles/public/checkbox.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/public/login.css') }}">
    <style>
        .legal-top-bar { max-width: 760px; margin: 0 auto; padding: 20px 16px 0; }
        .legal-top-bar a { text-decoration: none; font-weight: 800; font-size: 18px; }
        .legal-top-bar .is-kongo { color: #1a1a1a; }
        .legal-top-bar .is-bazar { color: var(--kb-theme-color, #2FA8E0); }
        .legal-page { max-width: 760px; margin: 0 auto; padding: 20px 16px 60px; }
        .legal-page h1 { font-size: 24px; font-weight: 800; }
        .legal-article { padding: 16px 0; border-bottom: 1px solid #eee; }
        .legal-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 16px 0 28px; }
        .legal-version-select {
            border: 1px solid #e3e6ea; border-radius: 30px; padding: 8px 16px; font-size: 13px; font-weight: 600; background: #fff;
        }
        .legal-action-btn {
            display: inline-flex; align-items: center; gap: 6px;
            border: 1px solid #e3e6ea; border-radius: 30px; padding: 8px 16px;
            background: #fff; color: #1a1a1a; font-size: 13px; font-weight: 600;
            text-decoration: none; cursor: pointer;
        }
        .legal-action-btn:hover { border-color: var(--kb-theme-color, #2FA8E0); color: var(--kb-theme-color, #2FA8E0); }
        .legal-send-form { display: none; gap: 8px; margin: -12px 0 24px; }
        .legal-send-form.is-open { display: flex; flex-wrap: wrap; }
        .legal-send-form input[type="email"] {
            flex: 1; min-width: 220px; border: 1px solid #e3e6ea; border-radius: 30px; padding: 8px 16px; font-size: 13px;
        }
        .legal-send-form button {
            border: none; border-radius: 30px; padding: 8px 18px; background: var(--kb-theme-color, #2FA8E0);
            color: #fff; font-weight: 700; font-size: 13px; cursor: pointer;
        }
        .legal-flash { border-radius: 8px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; }
        .legal-flash--success { background: #e6f4ea; color: #1e7e34; }
        .legal-flash--error { background: #fdecea; color: #b3261e; }

        @media print {
            .legal-top-bar, .legal-actions, .legal-send-form, .legal-flash { display: none !important; }
        }
    </style>
</head>
<body class="login-body">
    <div class="legal-top-bar">
        <a href="{{ path('public_home') }}"><span class="is-kongo">Kongo</span><span class="is-bazar">Bazar</span></a>
    </div>

    <div class="legal-page">
        <h1>{{ document.label }}</h1>
        <p class="text-muted" id="legalSubtitle">Version {{ version.versionNumber }}, en vigueur depuis le {{ version.publishedAt|date('d/m/Y') }}.</p>

        {% for message in app.flashes('legal_send_success') %}
            <div class="legal-flash legal-flash--success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('legal_send_error') %}
            <div class="legal-flash legal-flash--error">{{ message }}</div>
        {% endfor %}

        <div class="legal-actions">
            {% if versionsData|length > 1 %}
                <select class="legal-version-select" id="legalVersionSelect">
                    {% for v in versionsData %}
                        <option value="{{ v.id }}" {{ v.id == version.id ? 'selected' : '' }}>{{ v.label }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            <button type="button" class="legal-action-btn" onclick="window.print()"><i class="bi bi-printer"></i> Imprimer</button>
            <a href="{{ path('public_legal_document_pdf', { code: document.code, v: version.id }) }}" target="_blank" class="legal-action-btn" id="legalPdfLink"><i class="bi bi-filetype-pdf"></i> Télécharger en PDF</a>
            <button type="button" class="legal-action-btn" id="legalSendToggle"><i class="bi bi-envelope"></i> Envoyer par e-mail</button>
        </div>

        <form method="post" action="{{ path('public_legal_document_send', { code: document.code }) }}" class="legal-send-form" id="legalSendForm">
            <input type="hidden" name="version_id" id="legalSendVersionId" value="{{ version.id }}">
            <input type="email" name="email" placeholder="ton.email@exemple.com" value="{{ prefillEmail }}" required>
            <button type="submit">Envoyer</button>
        </form>

        <div id="legalArticlesContainer">
            {% for article in version.articles %}
                <div class="legal-article">
                    <strong>{{ article.title }}</strong>
                    <div class="mt-1">{{ article.body|raw }}</div>
                </div>
            {% endfor %}
        </div>
    </div>

    <script>
        document.getElementById('legalSendToggle').addEventListener('click', function () {
            document.getElementById('legalSendForm').classList.toggle('is-open');
        });

        (function () {
            const select = document.getElementById('legalVersionSelect');
            if (!select) return;

            const versions = {{ versionsData|json_encode|raw }};
            const pdfLink = document.getElementById('legalPdfLink');
            const pdfBaseUrl = '{{ path('public_legal_document_pdf', { code: document.code }) }}';

            select.addEventListener('change', function () {
                const data = versions.find((v) => String(v.id) === this.value);
                if (!data) return;

                document.getElementById('legalSubtitle').textContent = data.subtitle;
                document.getElementById('legalArticlesContainer').innerHTML = data.articlesHtml;
                document.getElementById('legalSendVersionId').value = data.id;
                pdfLink.href = pdfBaseUrl + '?v=' + data.id;
            });
        })();
    </script>
</body>
</html>