{% extends 'manage/base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}
{% block page_icon %}bi-people{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    {% set avatarColors = ['ctb-av-blue', 'ctb-av-green', 'ctb-av-purple', 'ctb-av-orange', 'ctb-av-pink'] %}
    {% set typeBadgeMap = {
        'Particulier': 'ctb-dept-badge-ops',
        'Vendeur Pro': 'ctb-dept-badge-eng',
        'Boutique': 'ctb-dept-badge-sales',
        'Point Relais': 'ctb-dept-badge-hr',
    } %}
    {% set typePillMap = {
        'Particulier': 'ctb-dept-ops',
        'Vendeur Pro': 'ctb-dept-eng',
        'Boutique': 'ctb-dept-sales',
        'Point Relais': 'ctb-dept-hr',
    } %}

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-people-fill"></i></div>
                <div class="ctb-stat-val">{{ totalUsersCount }}</div>
                <div class="ctb-stat-label">Utilisateurs inscrits</div>
                <div class="ctb-stat-chg ctb-chg-up"><i class="bi bi-arrow-up-short"></i>+{{ newThisMonth }} ce mois-ci</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-person-check-fill"></i></div>
                <div class="ctb-stat-val">{{ activeSellersCount }}</div>
                <div class="ctb-stat-label">Vendeurs actifs</div>
                <div class="ctb-stat-chg ctb-chg-neutral">Statut "active"</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-person-plus-fill"></i></div>
                <div class="ctb-stat-val">{{ newThisMonth }}</div>
                <div class="ctb-stat-label">Nouveaux ce mois-ci</div>
                <div class="ctb-stat-chg ctb-chg-neutral">Toutes inscriptions</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-list-ul"></i></div>
                <div class="ctb-stat-val">{{ rows|length }}</div>
                <div class="ctb-stat-label">Résultats affichés</div>
                <div class="ctb-stat-chg ctb-chg-neutral">Selon filtres actifs</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="sw-card">
                <div class="card-body py-3">
                    <form method="get" class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <input type="hidden" name="sort" value="{{ currentSort }}">
                        <input type="hidden" name="dir" value="{{ currentDir }}">
                        <input type="hidden" name="type" value="{{ currentType }}">

                        <div class="ctb-search-wrap">
                            <i class="bi bi-search ctb-search-icon"></i>
                            <input type="text" name="q" class="ctb-search-input" style="width:280px;" placeholder="Rechercher par email, téléphone ou nom..." value="{{ currentTerm }}">
                        </div>

                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <select name="minRating" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                                <option value="">Toutes notations</option>
                                <option value="4" {{ currentMinRating == '4' ? 'selected' : '' }}>4 étoiles et +</option>
                                <option value="3" {{ currentMinRating == '3' ? 'selected' : '' }}>3 étoiles et +</option>
                                <option value="2" {{ currentMinRating == '2' ? 'selected' : '' }}>2 étoiles et +</option>
                            </select>
                            <select name="unit" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                                <option value="">Toutes localisations</option>
                                {% for province in provinces %}
                                    <option value="{{ province.id }}" {{ currentUnit == province.id ? 'selected' : '' }}>{{ province.name }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Rechercher</button>
                            {% if currentType or currentMinRating or currentUnit or currentTerm %}
                                <a href="{{ path('manage_users_index') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-circle me-1"></i>Réinitialiser</a>
                            {% endif %}
                        </div>
                    </form>

                    <div class="ctb-dept-pills mt-3">
                        <a href="{{ path('manage_users_index', { q: currentTerm, sort: currentSort, dir: currentDir, minRating: currentMinRating, unit: currentUnit }) }}"
                           class="ctb-dept-pill ctb-dept-all {{ currentType ? '' : 'ctb-dept-active' }}">Tous</a>
                        {% for t in ['Particulier', 'Vendeur Pro', 'Boutique', 'Point Relais'] %}
                            <a href="{{ path('manage_users_index', { q: currentTerm, sort: currentSort, dir: currentDir, minRating: currentMinRating, unit: currentUnit, type: t }) }}"
                               class="ctb-dept-pill {{ typePillMap[t] }} {{ currentType == t ? 'ctb-dept-active' : '' }}">{{ t }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% macro sortLink(field, label, currentSort, currentDir, currentTerm) %}
        {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
        <a href="?sort={{ field }}&dir={{ nextDir }}&q={{ currentTerm }}" class="admin-sort-link">
            {{ label }}
            {% if currentSort == field %}<i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>{% endif %}
        </a>
    {% endmacro %}
    {% import _self as self %}

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="sw-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table ctb-table mb-0">
                            <thead>
                                <tr>
                                    <th>{{ self.sortLink('email', 'Contact', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('localisation', 'Localisation', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('typeLabel', 'Type', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('rating', 'Notation', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('ordersCount', 'Commandes', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('productsSold', 'Vendus', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('productsActive', 'En cours', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('createdAt', 'Inscrit le', currentSort, currentDir, currentTerm) }}</th>
                                    <th>{{ self.sortLink('status', 'Statut', currentSort, currentDir, currentTerm) }}</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in rows %}
                                    {% set user = row.user %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                {% if user.avatarName %}
                                                    <img src="{{ vich_uploader_asset(user, 'avatarFile') }}" class="ctb-avatar" style="object-fit:cover;" alt="">
                                                {% else %}
                                                    <div class="ctb-avatar {{ avatarColors[user.id % 5] }}">{{ user.initials }}</div>
                                                {% endif %}
                                                <div>
                                                    <div class="ctb-contact-name">{{ user.getFullName()|default(user.email) }}</div>
                                                    <div class="ctb-contact-role">{{ user.email }}{{ user.phone ? ' · ' ~ user.phone : '' }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>{{ row.localisation|default('—') }}</td>
                                        <td><span class="ctb-dept-badge {{ typeBadgeMap[row.typeLabel]|default('ctb-dept-badge-ops') }}">{{ row.typeLabel }}</span></td>
                                        <td>{{ row.rating ? row.rating|number_format(1) ~ ' / 5' : '—' }}</td>
                                        <td>
                                            {% if row.ordersCount > 0 %}
                                                <a href="{{ path('manage_negotiations_index', { buyer: user.id }) }}">{{ row.ordersCount }}</a>
                                            {% else %}0{% endif %}
                                        </td>
                                        <td>
                                            {% if row.sellerProfileId and row.productsSold > 0 %}
                                                <a href="{{ path('manage_products_index', { sellerProfile: row.sellerProfileId, status: 'sold' }) }}">{{ row.productsSold }}</a>
                                            {% else %}{{ row.productsSold }}{% endif %}
                                        </td>
                                        <td>
                                            {% if row.sellerProfileId and row.productsActive > 0 %}
                                                <a href="{{ path('manage_products_index', { sellerProfile: row.sellerProfileId, status: 'active' }) }}">{{ row.productsActive }}</a>
                                            {% else %}{{ row.productsActive }}{% endif %}
                                        </td>
                                        <td>{{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</td>
                                        <td>
                                            <span class="ctb-status-badge {{ user.status == 'banned' ? 'ctb-status-banned' : (user.status == 'suspended' ? 'ctb-status-pending' : 'ctb-status-active') }}">
                                                {{ user.status|default('active') }}
                                            </span>
                                        </td>
                                        <td>
                                            <div class="ctb-act-row">
                                                <a href="{{ path('manage_users_show', { id: user.id }) }}" class="ctb-act-btn" title="Détails"><i class="bi bi-eye"></i></a>
                                                <a href="{{ path('manage_users_message', { id: user.id }) }}" class="ctb-act-btn" title="Message"><i class="bi bi-envelope"></i></a>
                                                <form action="{{ path('manage_users_toggle_disable', { id: user.id }) }}" method="post">
                                                    <button type="submit" class="ctb-act-btn {{ user.status == 'suspended' ? '' : 'ctb-act-danger' }}" title="{{ user.status == 'suspended' ? 'Réactiver' : 'Désactiver' }}">
                                                        <i class="bi {{ user.status == 'suspended' ? 'bi-check-circle' : 'bi-slash-circle' }}"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="10" class="text-muted text-center py-4">Aucun utilisateur ne correspond à ces critères.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="ctb-table-footer">
                        <span class="ctb-footer-info">{{ rows|length }} utilisateur{{ rows|length != 1 ? 's' : '' }} affiché{{ rows|length != 1 ? 's' : '' }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}