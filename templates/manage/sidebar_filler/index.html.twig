{% extends 'manage/base.html.twig' %}
{% block title %}Bannières bouche-trou{% endblock %}
{% block page_icon %}bi-images{% endblock %}
{% block page_title %}Bannières bouche-trou (largeur {{ requiredWidth }}px imposée, hauteur libre){% endblock %}
{% block body %}
    <div class="d-flex justify-content-end mb-3">
        <a href="{{ path('manage_sidebar_filler_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Ajouter une bannière</a>
    </div>

    <form method="get" id="sfFilterForm" class="mb-3 d-flex align-items-center gap-2 flex-wrap">
        <input type="text" name="q" id="sfSearchInput" class="form-control" style="max-width:220px;" placeholder="Titre..." value="{{ searchTerm }}" autocomplete="off">

        <div class="d-flex align-items-center gap-2" data-category-picker>
            <select data-category-level="1" class="form-select" style="max-width:220px;">
                <option value="">— Toutes catégories —</option>
                {% for cat in rootCategories %}
                    <option value="{{ cat.id }}" {{ currentCategory == cat.id ? 'selected' : '' }}>{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>
        <input type="hidden" name="category" id="sfCategoryFinal" data-category-final-value value="{{ currentCategory ?? '' }}">

        <select name="status" id="sfStatusSelect" class="form-select" style="max-width:160px;">
            <option value="">— Tous statuts —</option>
            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }}>Actif</option>
            <option value="inactive" {{ currentStatus == 'inactive' ? 'selected' : '' }}>Inactif</option>
        </select>

        <select name="perPage" id="sfPerPageSelect" class="form-select" style="max-width:130px;">
            {% for n in [10, 20, 50, 100] %}
                <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
            {% endfor %}
        </select>

        <a href="{{ path('manage_sidebar_filler_index') }}" class="btn btn-outline-secondary btn-sm">Réinitialiser</a>
    </form>

    <div class="text-muted small mb-2">{{ total }} bannière{{ total != 1 ? 's' : '' }} au total — page {{ page }} / {{ pages }}</div>

    {% macro sortLink(field, label, currentSort, currentDir, currentParams) %}
        {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
        {% set params = currentParams|merge({sort: field, dir: nextDir}) %}
        <a href="?{{ params|url_encode(true) }}" class="admin-sort-link">
            {{ label }}
            {% if currentSort == field %}
                <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
            {% else %}
                <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
            {% endif %}
        </a>
    {% endmacro %}
    {% import _self as self %}

    <div class="sw-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Aperçu</th>
                        <th>{{ self.sortLink('title', 'Titre', currentSort, currentDir, app.request.query.all) }}</th>
                        <th>{{ self.sortLink('targetUrl', 'Lien', currentSort, currentDir, app.request.query.all) }}</th>
                        <th>{{ self.sortLink('categories', 'Catégories dédiées', currentSort, currentDir, app.request.query.all) }}</th>
                        <th>{{ self.sortLink('active', 'Actif', currentSort, currentDir, app.request.query.all) }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="sfRowsBody">
                    {% include 'manage/sidebar_filler/_index_rows.html.twig' %}
                </tbody>
            </table>
        </div>
    </div>

    {% if pages > 1 %}
        <nav class="mt-3" id="sfPagination">
            {% for p in 1..pages %}
                <a href="?{{ app.request.query.all|merge({page: p}) }}" class="btn btn-sm {{ p == page ? 'btn-primary' : 'btn-outline-secondary' }}">{{ p }}</a>
            {% endfor %}
        </nav>
    {% endif %}

    <script src="{{ asset('js/manage/category-picker.js') }}"></script>
    <script>
        function wireSfToggles() {
            document.querySelectorAll('.sf-toggle').forEach((sw) => {
                sw.addEventListener('change', function () {
                    fetch(this.dataset.toggleUrl, { method: 'POST' })
                        .then((r) => r.json())
                        .then((data) => { this.checked = data.active; });
                });
            });
        }
        wireSfToggles();

        (function () {
            const form = document.getElementById('sfFilterForm');
            const searchInput = document.getElementById('sfSearchInput');
            const categorySelect = document.getElementById('sfCategorySelect');
            const statusSelect = document.getElementById('sfStatusSelect');
            const rowsBody = document.getElementById('sfRowsBody');
            let debounceTimer = null;

            function refresh() {
                const params = new URLSearchParams(new FormData(form));
                window.history.replaceState({}, '', `?${params.toString()}`);

                fetch(`{{ path('manage_sidebar_filler_index_fragment') }}?${params.toString()}`)
                    .then((r) => r.json())
                    .then((data) => {
                        rowsBody.innerHTML = data.rowsHtml;
                        wireSfToggles();
                    });
            }

            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(refresh, 300);
            });
            document.getElementById('sfCategoryFinal').addEventListener('change', refresh);
            document.getElementById('sfPerPageSelect').addEventListener('change', refresh);
            form.addEventListener('change', (e) => {
                if (e.target.matches('select[data-category-level]')) {
                    setTimeout(refresh, 50); // laisse le picker écrire la valeur finale avant de lire le formulaire
                }
            });
            statusSelect.addEventListener('change', refresh);

            form.addEventListener('submit', (e) => e.preventDefault());
        })();
    </script>
{% endblock %}