{% extends 'manage/base.html.twig' %}

{% block title %}{{ unit ? 'Modifier' : 'Ajouter' }} — Entités admin.{% endblock %}
{% block page_icon %}bi-geo-alt{% endblock %}
{% block page_title %}{{ unit ? 'Modifier' : 'Ajouter' }} une entité administrative{% endblock %}

{% block body %}
    <div class="sw-card" style="max-width:560px;">
        <div class="card-header">
            <h6 class="mb-0 fw-bold">{{ unit ? 'Modifier « ' ~ unit.name ~ ' »' : 'Nouvelle entité' }}</h6>
            {% if unit %}<p class="text-muted mb-0 fs-13">Rattachée à : <strong>{{ unit.parent ? unit.parent.name : 'Aucune (niveau 1)' }}</strong></p>{% endif %}
        </div>
        <div class="card-body">
            <form method="post" action="{{ unit ? path('manage_geo_update', { id: unit.id }) : path('manage_geo_create') }}" class="row g-3">

                {% if not unit %}
                    <div class="col-12">
                        <label class="acc-form-label">Entité parente (laisser vide pour créer une province de niveau 1)</label>
                        <div class="geo-picker" data-geo-picker>
                            <select data-geo-level="1" class="acc-form-select">
                                <option value="">— Aucune (créer une province) —</option>
                                {% for province in provinces %}
                                    <option value="{{ province.id }}" {{ parent and parent.id == province.id ? 'selected' : '' }}>{{ province.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <input type="hidden" name="parent_id" data-geo-final-value value="{{ parent ? parent.id : '' }}">
                        <small class="text-muted">Choisissez le niveau le plus profond auquel rattacher la nouvelle entité — par exemple, sélectionnez "Kinshasa" puis "Kinshasa Ville" pour ajouter une nouvelle commune.</small>
                    </div>
                {% endif %}

                <div class="col-12">
                    <label class="acc-form-label">Nom</label>
                    <input type="text" name="name" class="acc-form-input" value="{{ unit ? unit.name : '' }}" required>
                </div>

                <div class="col-12">
                    <label class="acc-form-label">Type</label>
                    <input type="text" name="type_label" class="acc-form-input" value="{{ unit ? unit.typeLabel : '' }}"
                           list="typeLabelSuggestions" placeholder="Province, Ville, Territoire, Commune, Secteur, Chefferie, Groupement, Quartier...">
                    <datalist id="typeLabelSuggestions">
                        <option value="Province">
                        <option value="Ville">
                        <option value="Territoire">
                        <option value="Commune">
                        <option value="Secteur">
                        <option value="Chefferie">
                        <option value="Groupement">
                        <option value="Quartier">
                    </datalist>
                </div>

                <div class="col-12 form-check form-switch">
                    <input type="checkbox" name="active" value="1" class="form-check-input" id="activeSwitch"
                           {{ (unit is null or unit.active) ? 'checked' : '' }}>
                    <label class="form-check-label" for="activeSwitch">Actif</label>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-2"></i>Enregistrer</button>
                    <a href="{{ path('manage_geo_index', parent ? { parent: parent.id } : {}) }}" class="btn btn-outline-secondary ms-2">Annuler</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}