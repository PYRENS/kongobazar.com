{% extends 'manage/base.html.twig' %}

{% block title %}Entités admin.{% endblock %}
{% block page_icon %}bi-geo-alt{% endblock %}
{% block page_title %}Entités administratives{% endblock %}

{% block body %}
    {% set typeBadgeColors = ['ctb-dept-badge-eng', 'ctb-dept-badge-des', 'ctb-dept-badge-mkt', 'ctb-dept-badge-hr', 'ctb-dept-badge-fin', 'ctb-dept-badge-sales', 'ctb-dept-badge-ops'] %}

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-diagram-3-fill"></i></div>
                <div class="ctb-stat-val">{{ totalUnitsCount }}</div>
                <div class="ctb-stat-label">Entités au total</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div class="ctb-stat-val">{{ activeUnitsCount }}</div>
                <div class="ctb-stat-label">Entités actives</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-flag-fill"></i></div>
                <div class="ctb-stat-val">{{ rootUnitsCount }}</div>
                <div class="ctb-stat-label">Provinces (racine)</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-list-ul"></i></div>
                <div class="ctb-stat-val">{{ rows|length }}</div>
                <div class="ctb-stat-label">{{ isSearchMode ? 'Résultats de recherche' : 'À ce niveau' }}</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="sw-card">
                <div class="card-body py-3">
                    <form method="get" class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="ctb-search-wrap">
                            <i class="bi bi-search ctb-search-icon"></i>
                            <input type="text" name="q" class="ctb-search-input" style="width:320px;" placeholder="Rechercher une entité (ex: Lemba, Salongo...)" value="{{ searchTerm }}">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Rechercher</button>
                            {% if isSearchMode %}
                                <a href="{{ path('manage_geo_index') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-circle me-1"></i>Effacer</a>
                            {% endif %}
                            {% if not isSearchMode %}
                                <a href="{{ path('manage_geo_new', parent ? { parent: parent.id } : {}) }}" class="btn btn-primary btn-sm">
                                    <i class="bi bi-plus-lg me-1"></i>Ajouter {{ parent ? 'sous ' ~ parent.name : 'une entité' }}
                                </a>
                            {% endif %}
                        </div>
                    </form>

                    {% if not isSearchMode %}
                        <nav class="admin-breadcrumb mt-3">
                            <a href="{{ path('manage_geo_index') }}"><i class="bi bi-house"></i> Racine</a>
                            {% for unit in breadcrumb %}
                                <i class="bi bi-chevron-right"></i>
                                <a href="{{ path('manage_geo_index', { parent: unit.id }) }}">{{ unit.name }}</a>
                            {% endfor %}
                        </nav>
                    {% else %}
                        <p class="text-muted mt-3 mb-0">{{ rows|length }} résultat(s) pour "{{ searchTerm }}"</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% macro sortLink(field, label, currentSort, currentDir) %}
        {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
        <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
            {{ label }}
            {% if currentSort == field %}<i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>{% endif %}
        </a>
    {% endmacro %}
    {% import _self as self %}

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="sw-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table ctb-table mb-0">
                            <thead>
                                <tr>
                                    <th>{{ self.sortLink('name', 'Nom', currentSort, currentDir) }}</th>
                                    {% if isSearchMode %}<th>Chemin complet</th>{% endif %}
                                    <th>{{ self.sortLink('typeLabel', 'Type', currentSort, currentDir) }}</th>
                                    <th>{{ self.sortLink('active', 'Statut', currentSort, currentDir) }}</th>
                                    <th>{{ self.sortLink('childrenCount', 'Sous-entités', currentSort, currentDir) }}</th>
                                    <th><i class="bi bi-person"></i> {{ self.sortLink('countParticulier', 'Particuliers', currentSort, currentDir) }}</th>
                                    <th><i class="bi bi-briefcase"></i> {{ self.sortLink('countPro', 'Pro', currentSort, currentDir) }}</th>
                                    <th><i class="bi bi-shop"></i> {{ self.sortLink('countStore', 'Magasin', currentSort, currentDir) }}</th>
                                    <th><i class="bi bi-geo-alt"></i> {{ self.sortLink('countRelay', 'Relais', currentSort, currentDir) }}</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in rows %}
                                    {% set unit = row.unit %}
                                    <tr>
                                        <td class="ctb-contact-name">{{ unit.name }}</td>
                                        {% if isSearchMode %}<td class="text-muted" style="font-size:12px;">{{ unit.getFullPath() }}</td>{% endif %}
                                        <td>
                                            {% if unit.typeLabel %}
                                                <span class="ctb-dept-badge {{ typeBadgeColors[unit.typeLabel|length % 7] }}">{{ unit.typeLabel }}</span>
                                            {% else %}—{% endif %}
                                        </td>
                                        <td><span class="ctb-status-badge {{ unit.active ? 'ctb-status-active' : 'ctb-status-inactive' }}">{{ unit.active ? 'Actif' : 'Désactivé' }}</span></td>
                                        <td>
                                            {% if row.childrenCount > 0 %}
                                                <a href="{{ path('manage_geo_index', { parent: unit.id }) }}">{{ row.childrenCount }} <i class="bi bi-box-arrow-in-right"></i></a>
                                            {% else %}
                                                <span class="text-muted">0</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if row.countParticulier > 0 %}
                                                <a href="{{ path('manage_users_index', { province: unit.getAncestorAtLevel(1).id|default(unit.id) }) }}">{{ row.countParticulier }}</a>
                                            {% else %}0{% endif %}
                                        </td>
                                        <td>
                                            {% if row.countPro > 0 %}
                                                <a href="{{ path('manage_users_index', { type: 'Vendeur Pro', province: unit.getAncestorAtLevel(1).id|default(unit.id) }) }}">{{ row.countPro }}</a>
                                            {% else %}0{% endif %}
                                        </td>
                                        <td>
                                            {% if row.countStore > 0 %}
                                                <a href="{{ path('manage_users_index', { type: 'Boutique', province: unit.getAncestorAtLevel(1).id|default(unit.id) }) }}">{{ row.countStore }}</a>
                                            {% else %}0{% endif %}
                                        </td>
                                        <td>
                                            {% if row.countRelay > 0 %}
                                                <a href="{{ path('manage_users_index', { type: 'Point Relais', province: unit.getAncestorAtLevel(1).id|default(unit.id) }) }}">{{ row.countRelay }}</a>
                                            {% else %}0{% endif %}
                                        </td>
                                        <td>
                                            <div class="ctb-act-row">
                                                <a href="{{ path('manage_geo_edit', { id: unit.id }) }}" class="ctb-act-btn" title="Modifier"><i class="bi bi-pencil"></i></a>
                                                <form action="{{ path('manage_geo_toggle', { id: unit.id }) }}" method="post">
                                                    <button type="submit" class="ctb-act-btn" title="{{ unit.active ? 'Désactiver' : 'Activer' }}">
                                                        <i class="bi {{ unit.active ? 'bi-slash-circle' : 'bi-check-circle' }}"></i>
                                                    </button>
                                                </form>
                                                <form action="{{ path('manage_geo_delete', { id: unit.id }) }}" method="post"
                                                      onsubmit="return confirm('Supprimer {{ unit.name }} et TOUS ses descendants ? Cette action est irréversible.');">
                                                    <button type="submit" class="ctb-act-btn ctb-act-danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="10" class="text-muted text-center py-4">Aucune entité trouvée.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="ctb-table-footer">
                        <span class="ctb-footer-info">{{ rows|length }} entité{{ rows|length != 1 ? 's' : '' }} affichée{{ rows|length != 1 ? 's' : '' }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}