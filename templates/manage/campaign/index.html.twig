{% extends 'manage/base.html.twig' %}
{% block title %}Campagnes{% endblock %}
{% block page_icon %}bi-megaphone{% endblock %}
{% block page_title %}Campagnes d'accueil{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">La page d'accueil par défaut ne s'affiche que si aucune campagne n'est "En cours" à l'instant présent.</p>
        <a href="{{ path('manage_campaign_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouvelle campagne</a>
    </div>

    <div class="sw-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Bannière</th>
                        <th>Type</th>
                        <th>Titre</th>
                        <th>Période</th>
                        <th>Statut</th>
                        <th>Articles concernés</th>
                        <th>Vendus (période)</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for campaign in campaigns %}
                        <tr>
                            <td>
                                {% if campaign.bannerImageName %}
                                    <img src="{{ vich_uploader_asset(campaign, 'bannerImageFile') }}" style="width:90px;height:40px;object-fit:cover;border-radius:4px;cursor:zoom-in;" alt="" class="campaign-banner-thumb" data-full="{{ vich_uploader_asset(campaign, 'bannerImageFile') }}">
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>{{ campaign.typeLabel }}</td>
                            <td>{{ campaign.title }}</td>
                            <td>{{ campaign.startAt|date('d/m/Y H:i') }} → {{ campaign.endAt|date('d/m/Y H:i') }}</td>
                            <td>
                                {% set status = campaign.statusLabel %}
                                <span class="badge bg-{{ status == 'En cours' ? 'success' : (status == 'À venir' ? 'info' : (status == 'Terminée' ? 'secondary' : 'dark')) }}">{{ status }}</span>
                            </td>
                            <td>{{ stats[campaign.id].articleCount ?? '—' }}</td>
                            <td>{{ stats[campaign.id].soldCount }}</td>
                            <td>
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input campaign-toggle" role="switch" {{ campaign.active ? 'checked' : '' }} data-toggle-url="{{ path('manage_campaign_toggle', { id: campaign.id }) }}">
                                </div>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('manage_campaign_edit', { id: campaign.id }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                <form method="post" action="{{ path('manage_campaign_remove', { id: campaign.id }) }}" style="display:inline;" onsubmit="return confirm('Supprimer cette campagne ?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-center text-muted py-4">Aucune campagne créée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="kb-panel-overlay" id="campaignBannerZoom">
        <div class="kb-panel-box" style="max-width:900px;padding:12px;">
            <img id="campaignBannerZoomImg" src="" style="width:100%;height:auto;display:block;" alt="">
        </div>
    </div>

    <script>
        document.querySelectorAll('.campaign-banner-thumb').forEach((thumb) => {
            thumb.addEventListener('click', () => {
                document.getElementById('campaignBannerZoomImg').src = thumb.dataset.full;
                document.getElementById('campaignBannerZoom').classList.add('kb-panel-open');
            });
        });
        document.getElementById('campaignBannerZoom').addEventListener('click', function () {
            this.classList.remove('kb-panel-open');
        });

        document.querySelectorAll('.campaign-toggle').forEach((sw) => {
            sw.dataset.campaignId = sw.closest('tr').querySelector('a[href*="modifier"]')?.href.match(/\/campagnes\/(\d+)\//)?.[1] || '';
            sw.addEventListener('change', function () {
                fetch(this.dataset.toggleUrl, { method: 'POST' })
                    .then((r) => r.json())
                    .then((data) => {
                        this.checked = data.active;
                        (data.deactivatedIds || []).forEach((id) => {
                            const otherSw = document.querySelector('.campaign-toggle[data-campaign-id="' + id + '"]');
                            if (otherSw) otherSw.checked = false;
                        });
                    });
            });
        });
    </script>
{% endblock %}
