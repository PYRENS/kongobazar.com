{% set pld = product ? product.partListingDetails : null %}
{% set compatibleBrandIds = pld ? pld.compatibilities|map(c => c.brand.id) : [] %}
{% set existingEngineCompats = pld ? pld.engineCompatibilities : [] %}

<div class="sw-card">
    <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-gear text-primary me-2"></i>Détails pièce / accessoire</h6></div>
    <div class="card-body">

    <div class="mb-3">
        <label class="form-label">Lier à une pièce du catalogue (optionnel)</label>
        <input type="text" id="catalogEntrySearchInput" class="form-control" style="max-width:420px;" placeholder="Rechercher par titre, EAN ou réf. fabricant..."
            value="{{ pld and pld.partCatalogEntry ? pld.partCatalogEntry.name : '' }}" autocomplete="off">
        <div id="catalogEntrySearchResults" class="list-group mt-1" style="max-width:420px;position:relative;z-index:10;"></div>
        <input type="hidden" name="catalog_entry_id" id="catalogEntryIdInput" value="{{ pld and pld.partCatalogEntry ? pld.partCatalogEntry.id : '' }}">
        <small class="text-muted d-block">Si liée, les infos de la fiche catalogue remplacent la saisie manuelle ci-dessous, et restent synchronisées si le catalogue est mis à jour plus tard.</small>
        {% if pld and pld.partCatalogEntry %}
            <button type="button" id="catalogEntryClearBtn" class="btn btn-sm btn-outline-danger mt-1"><i class="bi bi-x-lg"></i> Retirer le lien</button>
        {% endif %}
    </div>

    <div id="catalogEntrySummaryWrap" style="{{ pld and pld.partCatalogEntry ? '' : 'display:none;' }}" class="mb-3">
        {% if pld and pld.partCatalogEntry %}
            {% include 'manage/_partials/_product_catalog_entry_summary.html.twig' with {entry: pld.partCatalogEntry} %}
        {% endif %}
    </div>

    <div id="partManualFieldsWrap" style="{{ pld and pld.partCatalogEntry ? 'display:none;' : '' }}">

    <p class="text-muted small mb-3"><i class="bi bi-info-circle"></i> Le champ "Marque" est maintenant dans la carte "Classification" en haut du formulaire (le fabricant de la pièce elle-même, ex: GATES — pas la marque du véhicule compatible).</p>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Code(s) OEM</label>
            <textarea name="oem_codes" class="form-control" rows="4" placeholder="Soit : 7711134567, 9801234580&#10;Soit collé directement : OE 38920-RSR-E02 — HONDA (une ligne par code)">{% if pld and pld.oemCodes %}{% for entry in pld.oemCodes %}{{ entry.code }}{{ entry.brand ? ' — ' ~ entry.brand : '' }}
{% endfor %}{% endif %}</textarea>
            <small class="text-muted">Un code par ligne. Marque optionnelle après un tiret long (—) — sinon laisse juste le code seul, ou plusieurs codes séparés par des virgules sur une ligne.</small>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">EAN</label>
            <input type="text" name="ean" class="form-control" value="{{ pld ? pld.ean : '' }}">
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Référence fabricant</label>
            <input type="text" name="manufacturer_ref" class="form-control" value="{{ pld ? pld.manufacturerRef : '' }}">
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Marque(s) compatible(s)</label>
        <select name="compatible_brand_ids[]" class="form-select" multiple size="6">
            {% for brand in brands %}
                <option value="{{ brand.id }}" {{ brand.id in compatibleBrandIds ? 'selected' : '' }}>{{ brand.name }}</option>
            {% endfor %}
        </select>
        <small class="text-muted">Maintiens Ctrl (ou Cmd sur Mac) pour sélectionner plusieurs marques.</small>
    </div>

    <div class="mb-3">
        <button type="button" id="toggleCompatBtn" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-circle"></i> Associer à des motorisations précises
        </button>

        <div id="compatTextBlock" style="display:none;" class="mt-2">
            <textarea id="compatRawText" class="form-control" rows="10" placeholder="Colle ici le texte brut (marques/modèles/motorisations)..."></textarea>
            <button type="button" id="compatAnalyzeBtn" class="btn btn-sm btn-primary mt-2">Analyser</button>
            <div id="compatErrors" class="alert alert-danger mt-2" style="display:none;"></div>
            <div id="compatResult" class="mt-2"></div>
        </div>

        <div class="mt-2">
            {% if existingEngineCompats|length > 0 %}
                <button type="button" id="toggleCompatListBtn" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="bi bi-chevron-down"></i> Afficher {{ existingEngineCompats|length }} motorisation{{ existingEngineCompats|length > 1 ? 's' : '' }} associée{{ existingEngineCompats|length > 1 ? 's' : '' }}
                </button>
            {% endif %}
            <div id="compatSelectedList" style="{{ existingEngineCompats|length > 0 ? 'display:none;' : '' }}">
                {% for ec in existingEngineCompats %}
                    <span class="badge bg-secondary me-1 mb-1" data-compat-badge="{{ ec.vehicleEngine.id }}">
                        {{ ec.vehicleEngine.brandNameCache }} {{ ec.vehicleEngine.modelNameCache }} {{ ec.vehicleEngine.variantNameCache }} {{ ec.vehicleEngine.label }}
                        <button type="button" class="btn-close btn-close-white btn-sm" style="font-size:8px;" data-remove-compat="{{ ec.vehicleEngine.id }}"></button>
                        <input type="hidden" name="compatible_engine_ids[]" value="{{ ec.vehicleEngine.id }}">
                    </span>
                {% endfor %}
            </div>
        </div>
    </div>

    </div>
    </div>
</div>
