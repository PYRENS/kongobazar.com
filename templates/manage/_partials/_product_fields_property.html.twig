{% set details = product ? product.propertyListingDetails : null %}

<div class="admin-card">
    <h6><i class="bi bi-house-door"></i> Détails immobilier</h6>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Surface (m²)</label>
            <input type="number" step="0.01" name="surface" class="form-control" value="{{ details ? details.surface : '' }}">
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Pièces</label>
            <input type="number" name="rooms" class="form-control" value="{{ details ? details.rooms : '' }}">
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Chambres</label>
            <input type="number" name="bedrooms" class="form-control" value="{{ details ? details.bedrooms : '' }}">
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Salles de bain</label>
            <input type="number" name="bathrooms" class="form-control" value="{{ details ? details.bathrooms : '' }}">
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Étage</label>
            <input type="number" name="floor" class="form-control" value="{{ details ? details.floor : '' }}">
        </div>
        {% if isRental %}
            <div class="col-md-3 mb-3">
                <label class="form-label">Période de location</label>
                <select name="rental_period_id" class="form-select">
                    <option value="">— Choisir —</option>
                    {% for rp in rentalPeriods %}
                        <option value="{{ rp.id }}" {{ details and details.rentalPeriod and details.rentalPeriod.id == rp.id ? 'selected' : '' }}>{{ rp.name }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}
    </div>
</div>