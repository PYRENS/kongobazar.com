{% extends 'manage/base.html.twig' %}

{% block title %}{{ pageTitleText }}{% endblock %}
{% block page_icon %}bi-gear-wide-connected{% endblock %}
{% block page_title %}{{ pageTitleHtml|raw }}{% endblock %}

{% block body %}
    <div class="sw-card mb-3">
        <div class="card-body py-3">
            <a href="{{ path('manage_vehicle_search') }}" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-left me-1"></i>Retour à la recherche</a>

            <div id="partsFilterRoot" class="d-flex align-items-start flex-wrap gap-2">
                <div class="ctb-search-wrap" style="width:220px;">
                    <i class="bi bi-search ctb-search-icon"></i>
                    <input type="text" id="partSearchInput" class="ctb-search-input" placeholder="Rechercher une pièce..." value="{{ currentTerm }}" autocomplete="off">
                    <div class="header-search-results" id="partSuggestions"></div>
                </div>

                <select id="conditionSelect" class="form-select form-select-sm" style="width:auto;">
                    <option value="">Tout état</option>
                    <option value="new" {{ currentCondition == 'new' ? 'selected' : '' }}>Neuf</option>
                    <option value="used" {{ currentCondition == 'used' ? 'selected' : '' }}>Occasion</option>
                </select>

                <select id="sortSelect" class="form-select form-select-sm" style="width:auto;">
                    <option value="createdAt" {{ currentSort == 'createdAt' ? 'selected' : '' }}>Plus récent</option>
                    <option value="basePrice" {{ currentSort == 'basePrice' ? 'selected' : '' }}>Prix</option>
                    <option value="salesCount" {{ currentSort == 'salesCount' ? 'selected' : '' }}>Ventes</option>
                    <option value="title" {{ currentSort == 'title' ? 'selected' : '' }}>Titre</option>
                </select>

                <div class="geo-picker" data-geo-picker style="flex-direction:row;gap:6px;">
                    <select data-geo-level="1" class="form-select form-select-sm" style="width:auto;">
                        <option value="">— Toutes les provinces —</option>
                        {% for province in provinces %}
                            <option value="{{ province.id }}" {{ currentLocationUnit and currentLocationUnit.id == province.id ? 'selected' : '' }}>{{ province.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <input type="hidden" id="locationFinalInput" data-geo-final-value value="{{ currentLocationId }}">

                <div class="d-flex gap-2 ms-auto">
                    <select id="perPageSelect" class="form-select form-select-sm" style="width:auto;">
                        {% for n in [10, 20, 50, 100] %}
                            <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
                        {% endfor %}
                    </select>
                    <button type="button" id="resetFiltersBtn" class="btn btn-outline-warning btn-sm">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-3">
            {% include 'manage/vehicle_engines/_parts_sidebar.html.twig' %}
        </div>
        <div class="col-xl-9" id="resultsColumnWrap">
            {% include 'manage/vehicle_engines/_parts_results.html.twig' %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/js/manage/geo-picker.js') }}"></script>
    <script>
        const allPartTitles = {{ allTitles|json_encode|raw }};
        const fragmentUrl = '{{ path("manage_vehicle_engine_parts_fragment", {id: engine.id}) }}';

        const state = {
            q: '{{ currentTerm|e('js') }}',
            location: '{{ currentLocationId }}',
            brands: {{ currentBrandIds|json_encode|raw }},
            condition: '{{ currentCondition }}',
            sort: '{{ currentSort }}',
            dir: '{{ currentDir }}',
            perPage: {{ perPage }},
            category: '{{ currentCategory }}',
            priceMin: {{ currentPriceMin is not null ? currentPriceMin : 0 }},
            priceMax: {{ currentPriceMax is not null ? currentPriceMax : maxPriceAvailable|round(0, 'ceil') }},
            page: {{ page }},
        };

        let debounceTimer;

        function load() {
            const params = new URLSearchParams();
            params.set('q', state.q);
            params.set('location', state.location);
            params.set('brand', state.brands.join(','));
            params.set('condition', state.condition);
            params.set('sort', state.sort);
            params.set('dir', state.dir);
            params.set('perPage', state.perPage);
            params.set('category', state.category);
            params.set('price_min', state.priceMin);
            params.set('price_max', state.priceMax);
            params.set('page', state.page);

            fetch(fragmentUrl + '?' + params.toString())
                .then((r) => r.text())
                .then((html) => {
                    const temp = document.createElement('div');
                    temp.innerHTML = html;

                    document.getElementById('sidebarFragment').outerHTML = temp.querySelector('#sidebarFragment').outerHTML;

                    const resultsCol = document.getElementById('resultsColumnWrap');
                    resultsCol.innerHTML = '';
                    resultsCol.appendChild(temp.querySelector('#resultsFragment'));
                    resultsCol.appendChild(temp.querySelector('#paginationFragment'));

                    bindPriceSlider();
                    bindViewToggle();
                    bindBrandPicker();
                });
        }

        // --- Délégation d'événements : catégories, pagination, tags fabricant (contenu régénéré à chaque reload) ---
        document.body.addEventListener('click', function (e) {
            const catLink = e.target.closest('.js-category-link');
            if (catLink) {
                e.preventDefault();
                state.category = catLink.dataset.category || '';
                state.page = 1;
                load();
                return;
            }
            const pageLink = e.target.closest('.js-page-link');
            if (pageLink && !pageLink.classList.contains('disabled')) {
                e.preventDefault();
                state.page = parseInt(pageLink.dataset.page, 10);
                load();
                return;
            }
            const tagRemove = e.target.closest('.js-brand-tag-remove');
            if (tagRemove) {
                const tag = tagRemove.closest('.js-brand-tag');
                const brandId = parseInt(tag.dataset.brandId, 10);
                state.brands = state.brands.filter((id) => id !== brandId);
                state.page = 1;
                load();
            }
        });

        // --- Recherche avec autocomplétion ---
        const partSearchInput = document.getElementById('partSearchInput');
        const partSuggestions = document.getElementById('partSuggestions');
        function renderPartSuggestions(term) {
            partSuggestions.innerHTML = '';
            if (!term) { partSuggestions.classList.remove('active'); return; }
            const matches = allPartTitles.filter((t) => t.toLowerCase().includes(term.toLowerCase())).slice(0, 8);
            if (matches.length === 0) { partSuggestions.classList.remove('active'); return; }
            matches.forEach((title) => {
                const item = document.createElement('div');
                item.className = 'header-search-result-item';
                item.innerHTML = '<i class="bi bi-box-seam"></i><span>' + title + '</span>';
                item.addEventListener('click', () => {
                    partSearchInput.value = title;
                    partSuggestions.classList.remove('active');
                    state.q = title;
                    state.page = 1;
                    load();
                });
                partSuggestions.appendChild(item);
            });
            partSuggestions.classList.add('active');
        }
        partSearchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            renderPartSuggestions(this.value.trim());
            debounceTimer = setTimeout(() => { state.q = this.value.trim(); state.page = 1; load(); }, 300);
        });
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.ctb-search-wrap')) {
                partSuggestions.classList.remove('active');
                const brandSuggestions = document.getElementById('brandPickerSuggestions');
                if (brandSuggestions) brandSuggestions.classList.remove('active');
            }
        });

        // --- Fabricant : champ texte, filtre dès le focus, clic pour ajouter ---
        function bindBrandPicker() {
            const input = document.getElementById('brandPickerInput');
            const suggestions = document.getElementById('brandPickerSuggestions');
            if (!input || !suggestions) return;

            function getAvailable() {
                try { return JSON.parse(suggestions.dataset.available || '[]'); } catch (e) { return []; }
            }

            function renderBrandPickerSuggestions(term) {
                suggestions.innerHTML = '';
                const available = getAvailable().filter((b) => !state.brands.includes(b.id));
                const matches = (term ? available.filter((b) => b.name.toLowerCase().includes(term.toLowerCase())) : available).slice(0, 10);
                if (matches.length === 0) { suggestions.classList.remove('active'); return; }
                matches.forEach((b) => {
                    const item = document.createElement('div');
                    item.className = 'header-search-result-item';
                    item.innerHTML = '<i class="bi bi-award"></i><span>' + b.name + '</span>';
                    item.addEventListener('click', () => {
                        if (!state.brands.includes(b.id)) {
                            state.brands.push(b.id);
                            state.page = 1;
                            load();
                        }
                        input.value = '';
                        suggestions.classList.remove('active');
                    });
                    suggestions.appendChild(item);
                });
                suggestions.classList.add('active');
            }

            input.addEventListener('focus', function () { renderBrandPickerSuggestions(this.value.trim()); });
            input.addEventListener('input', function () { renderBrandPickerSuggestions(this.value.trim()); });
        }
        bindBrandPicker();

        // --- Localisation (cascade province → ... ) ---
        document.querySelector('[data-geo-picker]').addEventListener('change', function () {
            state.location = document.getElementById('locationFinalInput').value;
            state.page = 1;
            load();
        });

        // --- État / tri / par page ---
        document.getElementById('conditionSelect').addEventListener('change', function () { state.condition = this.value; state.page = 1; load(); });
        document.getElementById('sortSelect').addEventListener('change', function () { state.sort = this.value; state.page = 1; load(); });
        document.getElementById('perPageSelect').addEventListener('change', function () { state.perPage = parseInt(this.value, 10); state.page = 1; load(); });

        // --- Reset complet ---
        document.getElementById('resetFiltersBtn').addEventListener('click', function () {
            window.location.href = window.location.pathname;
        });

        // --- Curseur de prix double ---
        function bindPriceSlider() {
            const minRange = document.getElementById('priceMinRange');
            const maxRange = document.getElementById('priceMaxRange');
            const fill = document.getElementById('priceRangeFill');
            const minLabel = document.getElementById('priceMinLabel');
            const maxLabel = document.getElementById('priceMaxLabel');
            if (!minRange || !maxRange) return;

            const ceilVal = parseFloat(minRange.max);

            function updateFill() {
                const minVal = parseFloat(minRange.value);
                const maxVal = parseFloat(maxRange.value);
                const left = ceilVal > 0 ? (minVal / ceilVal * 100) : 0;
                const right = ceilVal > 0 ? (maxVal / ceilVal * 100) : 100;
                fill.style.left = left + '%';
                fill.style.width = Math.max(0, right - left) + '%';
                minLabel.textContent = minVal;
                maxLabel.textContent = maxVal;
            }
            updateFill();

            let sliderDebounce;
            function onSliderChange() {
                if (parseFloat(minRange.value) > parseFloat(maxRange.value)) {
                    const tmp = minRange.value;
                    minRange.value = maxRange.value;
                    maxRange.value = tmp;
                }
                updateFill();
                clearTimeout(sliderDebounce);
                sliderDebounce = setTimeout(() => {
                    state.priceMin = parseFloat(minRange.value);
                    state.priceMax = parseFloat(maxRange.value);
                    state.page = 1;
                    load();
                }, 400);
            }

            minRange.addEventListener('input', updateFill);
            maxRange.addEventListener('input', updateFill);
            minRange.addEventListener('change', onSliderChange);
            maxRange.addEventListener('change', onSliderChange);
        }
        bindPriceSlider();

        // --- Bascule grille / liste ---
        function bindViewToggle() {
            const gridBtn = document.getElementById('gridViewBtn');
            const listBtn = document.getElementById('listViewBtn');
            const resultsBox = document.getElementById('resultsFragment');
            if (!gridBtn || !listBtn) return;

            function setViewMode(mode) {
                resultsBox.classList.toggle('parts-list-mode', mode === 'list');
                gridBtn.classList.toggle('active', mode === 'grid');
                listBtn.classList.toggle('active', mode === 'list');
            }
            gridBtn.addEventListener('click', () => setViewMode('grid'));
            listBtn.addEventListener('click', () => setViewMode('list'));
        }
        bindViewToggle();
    </script>
{% endblock %}