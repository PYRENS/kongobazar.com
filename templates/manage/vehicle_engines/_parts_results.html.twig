<div id="resultsFragment">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="btn-group">
            <button type="button" id="gridViewBtn" class="btn btn-sm btn-outline-secondary active" title="Vue grille"><i class="bi bi-grid-3x3-gap"></i></button>
            <button type="button" id="listViewBtn" class="btn btn-sm btn-outline-secondary" title="Vue liste"><i class="bi bi-list-ul"></i></button>
        </div>
        <span class="text-muted">{{ total }} pièce{{ total != 1 ? 's' : '' }} compatible{{ total != 1 ? 's' : '' }} — page {{ page }} / {{ pages }}</span>
    </div>

    {% for catName, products in grouped %}
        <div class="mb-4">
            <h6 class="fw-bold mb-3">{{ catName }} <span class="text-muted fw-normal">({{ products|length }})</span></h6>
            <div class="row g-3 parts-grid">
                {% for product in products %}
                    {% set firstImage = product.images|first %}
                    <div class="col-xl-3 col-md-4 col-6 part-card-col">
                        <div class="sw-card h-100 part-card">
                            <div class="part-card-image" style="height:150px;background:var(--body-bg);display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:12px 12px 0 0;flex-shrink:0;">
                                {% if firstImage %}
                                    <img src="{{ vich_uploader_asset(firstImage, 'imageFile') }}" style="max-width:100%;max-height:100%;object-fit:contain;">
                                {% else %}
                                    <i class="bi bi-box-seam text-muted" style="font-size:36px;"></i>
                                {% endif %}
                            </div>
                            <div class="card-body part-card-body">
                                <h6 class="mb-1" style="font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="{{ product.title }}">{{ product.title }}</h6>
                                <p class="text-muted mb-2" style="font-size:11px;">{{ product.brand ? product.brand.name : '—' }} · {{ product.condition == 'new' ? 'Neuf' : 'Occasion' }}</p>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>{{ product.basePrice }} {{ product.currency }}</strong>
                                    <span class="text-muted" style="font-size:11px;">{{ product.salesCount }} vente{{ product.salesCount != 1 ? 's' : '' }}</span>
                                </div>
                                <div class="d-flex gap-1">
                                    <a href="{{ path('manage_products_show', {id: product.id}) }}" class="btn btn-outline-secondary btn-sm flex-fill"><i class="bi bi-eye"></i></a>
                                    <a href="{{ path('manage_products_edit', {id: product.id}) }}" class="btn btn-outline-primary btn-sm flex-fill"><i class="bi bi-pencil"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="sw-card">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size:40px;"></i>
                <p class="mt-2 mb-0">Aucune pièce ne correspond à ces critères.</p>
            </div>
        </div>
    {% endfor %}
</div>

<div id="paginationFragment">
    {% if pages > 1 %}
        <div class="d-flex justify-content-center mt-3">
            <div class="ctb-pagination">
                <a href="#" data-page="{{ max(1, page - 1) }}" class="js-page-link ctb-page-btn {{ page <= 1 ? 'disabled' : '' }}"><i class="bi bi-chevron-left"></i></a>
                {% for p in max(1, page - 2)..min(pages, page + 2) %}
                    <a href="#" data-page="{{ p }}" class="js-page-link ctb-page-btn {{ p == page ? 'ctb-page-active' : '' }}">{{ p }}</a>
                {% endfor %}
                <a href="#" data-page="{{ min(pages, page + 1) }}" class="js-page-link ctb-page-btn {{ page >= pages ? 'disabled' : '' }}"><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>
    {% endif %}
</div>