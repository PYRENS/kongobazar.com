{% extends 'manage/base.html.twig' %}

{% block body %}
    <h1 class="h4 mb-3">{{ engine ? 'Modifier la motorisation' : 'Nouvelle motorisation' }}</h1>

    <form method="post" action="{{ engine ? path('manage_vehicle_engines_update', {id: engine.id}) : path('manage_vehicle_engines_new') }}">
        <div class="mb-3">
            <label class="form-label d-block">Type</label>
            <div class="form-check form-check-inline">
                <input type="radio" name="vehicle_type" value="auto" class="form-check-input" id="typeAuto" data-vehicle-type-radio
                    {{ (engine is null or engine.variant) ? 'checked' : '' }}>
                <label class="form-check-label" for="typeAuto">Auto (Variante requise)</label>
            </div>
            <div class="form-check form-check-inline">
                <input type="radio" name="vehicle_type" value="moto" class="form-check-input" id="typeMoto" data-vehicle-type-radio
                    {{ (engine and engine.model) ? 'checked' : '' }}>
                <label class="form-check-label" for="typeMoto">Moto (Modèle direct, sans Variante)</label>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Marque</label>
                <select class="form-select" data-vehicle-brand-select>
                    <option value="">— Choisir —</option>
                    {% set currentBrand = engine ? (engine.variant ? engine.variant.model.brand : engine.model.brand) : null %}
                    {% for brand in brands %}
                        <option value="{{ brand.id }}" {{ currentBrand and currentBrand.id == brand.id ? 'selected' : '' }}>{{ brand.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Modèle</label>
                {% set currentModel = engine ? (engine.variant ? engine.variant.model : engine.model) : null %}
                <select name="model_id" class="form-select" data-vehicle-model-select data-preselected="{{ currentModel ? currentModel.id : '' }}" required>
                    <option value="">— Choisissez d'abord une marque —</option>
                </select>
            </div>
            <div class="col-md-4 mb-3" data-vehicle-variant-block>
                <label class="form-label">Variante</label>
                <select name="variant_id" class="form-select" data-vehicle-variant-select data-preselected="{{ engine and engine.variant ? engine.variant.id : '' }}">
                    <option value="">— Choisissez d'abord un modèle —</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Libellé moteur</label>
            <input type="text" name="label" class="form-control" value="{{ engine ? engine.label : '' }}" placeholder="ex: 1.2 TCe ou 101ccm" required>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">Puissance CV</label>
                <input type="number" name="power_cv" class="form-control" value="{{ engine ? engine.powerCv : '' }}">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Puissance kW</label>
                <input type="number" name="power_kw" class="form-control" value="{{ engine ? engine.powerKw : '' }}">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Cylindrée (cm³, Moto)</label>
                <input type="number" name="displacement_cc" class="form-control" value="{{ engine ? engine.displacementCc : '' }}">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Énergie</label>
                <select name="fuel_type_id" class="form-select">
                    <option value="">— Aucune —</option>
                    {% for fuelType in fuelTypes %}
                        <option value="{{ fuelType.id }}" {{ engine and engine.fuelType and engine.fuelType.id == fuelType.id ? 'selected' : '' }}>{{ fuelType.name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">Mois début</label>
                <input type="text" name="month_start" class="form-control" maxlength="2" placeholder="MM" value="{{ engine ? engine.monthStart : '' }}">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Année début</label>
                <input type="number" name="year_start" class="form-control" value="{{ engine ? engine.yearStart : '' }}">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Mois fin</label>
                <input type="text" name="month_end" class="form-control" maxlength="2" placeholder="vide = en cours" value="{{ engine ? engine.monthEnd : '' }}">
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Année fin</label>
                <input type="number" name="year_end" class="form-control" placeholder="vide = en cours" value="{{ engine ? engine.yearEnd : '' }}">
            </div>
        </div>

        <button type="submit" class="btn btn-success">Enregistrer</button>
        <a href="{{ path('manage_vehicle_engines_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </form>
{% endblock %}