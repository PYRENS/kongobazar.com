<div id="sidebarFragment">
    <div class="sw-card mb-3">
        <div class="card-header"><h6 class="mb-0 fw-bold" style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;">Catégories</h6></div>
        <div class="card-body p-2">
            <a href="#" data-category="" class="js-category-link d-flex justify-content-between align-items-center px-2 py-1 rounded mb-1 {{ not currentCategory ? 'fw-bold' : '' }}" style="text-decoration:none;color:inherit;">
                Toutes <span class="text-muted">{{ total }}</span>
            </a>

            <div class="accordion" id="categoryFacetAccordion">
                {% for group in groupedFacets %}
                    {% set groupContainsCurrent = currentCategory == group.id or group.children|filter(c => c.id == currentCategory)|length > 0 %}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            {% if group.children|length > 0 %}
                                <button class="accordion-button {{ groupContainsCurrent ? '' : 'collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#facetGroup{{ group.id }}">
                                    {{ group.name }} <span class="text-muted ms-1">({{ group.total }})</span>
                                </button>
                            {% else %}
                                <a href="#" data-category="{{ group.id }}" class="js-category-link accordion-button collapsed d-flex justify-content-between {{ currentCategory == group.id ? 'fw-bold text-primary' : '' }}" style="text-decoration:none;">
                                    {{ group.name }} <span class="text-muted">({{ group.total }})</span>
                                </a>
                            {% endif %}
                        </h2>
                        {% if group.children|length > 0 %}
                            <div id="facetGroup{{ group.id }}" class="accordion-collapse collapse {{ groupContainsCurrent ? 'show' : '' }}" data-bs-parent="#categoryFacetAccordion">
                                <div class="accordion-body p-2">
                                    {% for child in group.children %}
                                        <a href="#" data-category="{{ child.id }}" class="js-category-link d-flex justify-content-between align-items-center px-2 py-1 rounded {{ currentCategory == child.id ? 'fw-bold text-primary' : '' }}" style="text-decoration:none;color:inherit;font-size:13px;">
                                            {{ child.name }} <span class="text-muted">({{ child.total }})</span>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="sw-card mb-3">
        <div class="card-header"><h6 class="mb-0 fw-bold" style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;">Trier par prix</h6></div>
        <div class="card-body p-3">
            {% set priceCeil = maxPriceAvailable|round(0, 'ceil') %}
            {% set effMin = currentPriceMin is not null ? currentPriceMin : 0 %}
            {% set effMax = currentPriceMax is not null ? currentPriceMax : priceCeil %}
            <div class="price-range-wrap" data-price-ceil="{{ priceCeil }}">
                <div class="price-range-track">
                    <div class="price-range-fill" id="priceRangeFill"></div>
                </div>
                <input type="range" id="priceMinRange" min="0" max="{{ priceCeil }}" value="{{ effMin }}" step="1">
                <input type="range" id="priceMaxRange" min="0" max="{{ priceCeil }}" value="{{ effMax }}" step="1">
            </div>
            <div class="d-flex justify-content-between mt-2" style="font-size:12px;">
                <span><strong id="priceMinLabel">{{ effMin }}</strong> $</span>
                <span><strong id="priceMaxLabel">{{ effMax }}</strong> $</span>
            </div>
        </div>
    </div>

    <div class="sw-card">
        <div class="card-header"><h6 class="mb-0 fw-bold" style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;">Fabricant</h6></div>
        <div class="card-body p-3">
            <div class="ctb-search-wrap mb-2" style="width:100%;">
                <i class="bi bi-award ctb-search-icon"></i>
                <input type="text" id="brandPickerInput" class="ctb-search-input" placeholder="Rechercher / choisir un fabricant..." autocomplete="off" style="width:100%;">
                <div class="header-search-results" id="brandPickerSuggestions" data-available='{{ availableBrands|json_encode }}'></div>
            </div>
            <div id="brandTagsWrap" class="d-flex flex-wrap gap-1">
                {% for id in currentBrandIds %}
                    {% for b in availableBrands %}
                        {% if b.id == id %}
                            <span class="ctb-status-badge ctb-status-active js-brand-tag" data-brand-id="{{ b.id }}" style="cursor:default;">
                                {{ b.name }} <i class="bi bi-x-circle ms-1 js-brand-tag-remove" style="cursor:pointer;"></i>
                            </span>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>