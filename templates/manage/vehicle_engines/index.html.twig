{% extends 'manage/base.html.twig' %}

{% block title %}Motorisations{% endblock %}
{% block page_icon %}bi-gear{% endblock %}
{% block page_title %}Motorisations{% endblock %}

{% macro sortLink(field, label, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Motorisations</h1>
        <a href="{{ path('manage_vehicle_engines_new') }}" class="btn btn-primary btn-sm">+ Nouvelle motorisation</a>
    </div>

    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <input type="text" name="q" class="form-control" style="max-width: 300px;" placeholder="Rechercher (marque, modèle, variante, moteur)..." value="{{ searchTerm }}">
        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
        {% if searchTerm %}
            <a href="{{ path('manage_vehicle_engines_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        {% endif %}
    </form>

    <p class="text-muted mb-2">{{ engines|length }} motorisation{{ engines|length > 1 ? 's' : '' }} au total</p>

    <table class="table admin-table">
        <thead>
            <tr>
                <th>Logo</th>
                <th>{{ self.sortLink('brand', 'Marque / Modèle / Variante', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('label', 'Moteur', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('power', 'CV / kW', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('fuelType', 'Énergie', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('period', 'Période', currentSort, currentDir) }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for engine in engines %}
                {% set brand = engine.variant ? engine.variant.model.brand : (engine.model ? engine.model.brand : null) %}
                <tr>
                    <td>
                        {% if brand and brand.logoName %}
                            <img src="{{ vich_uploader_asset(brand, 'logoFile') }}" alt="" style="width:28px;height:28px;object-fit:contain;">
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ engine.brandNameCache }} {{ engine.modelNameCache }} {{ engine.variantNameCache }}</td>
                    <td>{{ engine.label }}</td>
                    <td>{{ engine.powerCv ?: '-' }} CV / {{ engine.powerKw ?: '-' }} kW</td>
                    <td>{{ engine.fuelType ? engine.fuelType.name : '-' }}</td>
                    <td>{{ engine.periodLabel ?: '-' }}</td>
                    <td class="text-end">
                        <a href="{{ path('manage_vehicle_engines_edit', {id: engine.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form action="{{ path('manage_vehicle_engines_delete', {id: engine.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer cette motorisation ?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-muted">Aucune motorisation pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}