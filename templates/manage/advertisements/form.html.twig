{% extends 'manage/base.html.twig' %}

{% block title %}{{ ad ? 'Modifier' : 'Nouvelle' }} publicité{% endblock %}
{% block page_icon %}bi-megaphone{% endblock %}
{% block page_title %}{{ ad ? 'Modifier' : 'Nouvelle' }} publicité{% endblock %}

{% block body %}
    <form method="post" enctype="multipart/form-data" action="{{ ad ? path('manage_ads_update', {id: ad.id}) : path('manage_ads_create') }}">
        <div class="admin-card">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Titre (interne)</label>
                    <input type="text" name="title" class="form-control" value="{{ ad ? ad.title : '' }}" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Description (note libre pour l'admin, jamais affichée publiquement)</label>
                <textarea name="description" class="form-control" rows="2">{{ ad ? ad.description : '' }}</textarea>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label">Zones d'affichage (une même bannière ne peut être placée que sur des zones de même dimension)</label>
                    <select name="zone_keys[]" id="adZoneMultiSelect" class="form-select" multiple size="8" required>
                        {% for key, info in zoneKeys %}
                            <option value="{{ key }}" data-width="{{ info.width }}" data-height="{{ info.height }}" {{ key in selectedZoneKeys ? 'selected' : '' }}>
                                {{ info.label }}{{ info.width and info.height ? ' (' ~ info.width ~ '×' ~ info.height ~ ')' : '' }}
                            </option>
                        {% endfor %}
                    </select>
                    <small class="text-muted">Maintiens Ctrl (ou Cmd sur Mac) pour sélectionner plusieurs zones.</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Espace cible</label>
                    <select name="target_space" class="form-select">
                        <option value="public" {{ ad and ad.targetSpace == 'public' ? 'selected' : '' }}>Site public</option>
                        <option value="pro" {{ ad and ad.targetSpace == 'pro' ? 'selected' : '' }}>Espace Pro</option>
                        <option value="store" {{ ad and ad.targetSpace == 'store' ? 'selected' : '' }}>Espace Boutique</option>
                        <option value="relay" {{ ad and ad.targetSpace == 'relay' ? 'selected' : '' }}>Espace Relais</option>
                        <option value="manage" {{ ad and ad.targetSpace == 'manage' ? 'selected' : '' }}>Back-office admin</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Position (ordre dans la zone)</label>
                    <input type="number" name="position" class="form-control" value="{{ ad ? ad.position : 0 }}">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Statut</label>
                    <select name="status" class="form-select">
                        <option value="scheduled" {{ ad and ad.status == 'scheduled' ? 'selected' : '' }}>Programmée</option>
                        <option value="active" {{ ad and ad.status == 'active' ? 'selected' : '' }}>Active</option>
                        <option value="paused" {{ ad and ad.status == 'paused' ? 'selected' : '' }}>En pause</option>
                        <option value="expired" {{ ad and ad.status == 'expired' ? 'selected' : '' }}>Expirée</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Lien de destination</label>
                <input type="url" name="target_url" class="form-control" placeholder="https://..." value="{{ ad ? ad.targetUrl : '' }}">
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Début</label>
                    <input type="date" name="start_at" class="form-control" value="{{ ad and ad.startAt ? ad.startAt|date('Y-m-d') : '' }}" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fin (optionnel)</label>
                    <input type="date" name="end_at" class="form-control" value="{{ ad and ad.endAt ? ad.endAt|date('Y-m-d') : '' }}">
                    <small class="text-muted">Laisse vide pour que la publicité reste active indéfiniment.</small>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Catégorie liée (optionnel — pour la zone "Bannière bas de bloc catégorie")</label>
                <select name="related_category_id" class="form-select" style="max-width:400px;">
                    <option value="">— Aucune —</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {{ ad and ad.relatedCategory and ad.relatedCategory.id == cat.id ? 'selected' : '' }}>{{ cat.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" name="is_paid" value="1" class="form-check-input" id="isPaid" {{ ad and ad.isPaid ? 'checked' : '' }}>
                <label class="form-check-label" for="isPaid">Emplacement payant (achat vendeur)</label>
            </div>
            <div class="mb-3">
                <label class="form-label">Montant (USD, si payant)</label>
                <input type="number" step="0.01" name="price_amount_usd" class="form-control" style="max-width:200px;" value="{{ ad ? ad.priceAmountUsd : '' }}">
            </div>

            <div class="mb-3">
                <label class="form-label">Image de la bannière</label>

                <div class="admin-file-upload-group">
                    <div class="admin-upload-thumb" id="adImageThumb" style="{{ ad and ad.imageName ? '' : 'display:none;' }}">
                        <span class="admin-upload-thumb-label" id="adImageThumbLabel">{{ ad and ad.imageName ? 'Actuelle' : '' }}</span>
                        <div class="admin-upload-thumb-inner">
                            <img id="adImagePreview" src="{{ ad and ad.imageName ? vich_uploader_asset(ad, 'imageFile') : '' }}">
                            <button type="button" id="adImageRemoveBtn" class="admin-upload-remove"><i class="bi bi-x"></i></button>
                        </div>
                    </div>

                    <div class="admin-upload-thumb">
                        <span class="admin-upload-thumb-label">&nbsp;</span>
                        <label class="admin-upload-dropzone" for="adImageInput">
                            <i class="bi bi-camera"></i>
                            <span>Upload</span>
                        </label>
                    </div>
                    <input type="file" name="image_file" id="adImageInput" accept="image/*" class="admin-upload-input-hidden" {{ ad and ad.imageName ? '' : 'required' }}>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Enregistrer</button>
        <a href="{{ path('manage_ads_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </form>

    <script>
        (function () {
            const input = document.getElementById('adImageInput');
            const thumb = document.getElementById('adImageThumb');
            const preview = document.getElementById('adImagePreview');
            const label = document.getElementById('adImageThumbLabel');
            const removeBtn = document.getElementById('adImageRemoveBtn');

            input.addEventListener('change', function () {
                const file = this.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    label.textContent = 'Nouvelle';
                    thumb.style.display = '';
                };
                reader.readAsDataURL(file);
            });

            removeBtn.addEventListener('click', function () {
                input.value = '';
                preview.src = '';
                thumb.style.display = 'none';
                input.required = true;
            });
        })();
    </script>
{% endblock %}