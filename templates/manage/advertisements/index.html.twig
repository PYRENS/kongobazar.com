{% extends 'manage/base.html.twig' %}

{% block title %}Publicités{% endblock %}
{% block page_icon %}bi-megaphone{% endblock %}
{% block page_title %}Publicités{% endblock %}

{% block body %}
    {% set statusLabels = {
        'scheduled': 'Programmée',
        'active': 'Active',
        'paused': 'En pause',
        'expired': 'Expirée',
    } %}

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Publicités</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('manage_ads_stats') }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-bar-chart-line"></i> Statistiques</a>
            <a href="{{ path('manage_ad_zones_index') }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-shuffle"></i> Zones publicitaires</a>
            <a href="{{ path('manage_ads_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nouvelle publicité</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-megaphone"></i></div>
                <div class="ctb-stat-val">{{ stats.total }}</div>
                <div class="ctb-stat-label">Publicités au total</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div class="ctb-stat-val">{{ stats.active }}</div>
                <div class="ctb-stat-label">Actives</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-clock-history"></i></div>
                <div class="ctb-stat-val">{{ stats.scheduled }}</div>
                <div class="ctb-stat-label">Programmées</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-pause-circle"></i></div>
                <div class="ctb-stat-val">{{ stats.expired }}</div>
                <div class="ctb-stat-label">Expirées / En pause</div>
            </div>
        </div>
    </div>

    <form method="get" id="adsFilterForm" class="mb-3 d-flex align-items-center gap-2 flex-wrap">
        <div class="position-relative" style="max-width:220px;">
            <input type="text" name="q" id="adsSearchInput" class="form-control" placeholder="Titre..." value="{{ searchTerm }}" autocomplete="off">
            <div id="adsSearchResults" class="list-group position-absolute w-100" style="z-index:20;"></div>
        </div>

        <select name="sitePage" id="adsSitePageSelect" class="form-select" style="max-width: 220px;">
            <option value="">— Toutes pages —</option>
            {% for p in allSitePages %}
                <option value="{{ p }}" {{ currentSitePage == p ? 'selected' : '' }}>{{ p }}</option>
            {% endfor %}
        </select>

        <select name="zone" id="adsZoneSelect" class="form-select" style="max-width: 260px;">
            <option value="">— Toutes zones —</option>
            {% for key, info in zoneKeys %}
                <option value="{{ key }}" data-page="{{ info.page }}" {{ currentZone == key ? 'selected' : '' }}>{{ info.label }}</option>
            {% endfor %}
        </select>

        <select name="status" id="adsStatusSelect" class="form-select" style="max-width: 160px;">
            <option value="">— Tous statuts —</option>
            <option value="scheduled" {{ currentStatus == 'scheduled' ? 'selected' : '' }}>Programmée</option>
            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }}>Active</option>
            <option value="paused" {{ currentStatus == 'paused' ? 'selected' : '' }}>En pause</option>
            <option value="expired" {{ currentStatus == 'expired' ? 'selected' : '' }}>Expirée</option>
        </select>

        <select name="perPage" id="adsPerPageSelect" class="form-select" style="max-width: 130px;">
            {% for n in [10, 20, 50, 100] %}
                <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i> Filtrer</button>
        {% if searchTerm or currentZone or currentStatus or currentSitePage %}
            <a href="{{ path('manage_ads_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        {% endif %}
    </form>

    {% macro sortLink(field, label, currentSort, currentDir, currentParams) %}
        {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
        {% set params = currentParams|merge({sort: field, dir: nextDir}) %}
        <a href="?{{ params|url_encode(true) }}" class="admin-sort-link">
            {{ label }}
            {% if currentSort == field %}
                <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
            {% else %}
                <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
            {% endif %}
        </a>
    {% endmacro %}
    {% import _self as self %}

    <div class="sw-card">
        <div class="card-body p-0">
            <div class="table-responsive">
    <table class="table ctb-table mb-0">
        <thead>
            <tr>
                <th>Image</th>
                <th>Titre</th>
                <th>{{ self.sortLink('dimension', 'Dimensions', currentSort, currentDir, app.request.query.all) }}</th>
                <th>Description</th>
                <th>{{ self.sortLink('sitePage', 'Page', currentSort, currentDir, app.request.query.all) }}</th>
                <th>{{ self.sortLink('zoneKey', 'Zone', currentSort, currentDir, app.request.query.all) }}</th>
                <th>{{ self.sortLink('position', 'Position', currentSort, currentDir, app.request.query.all) }}</th>
                <th>{{ self.sortLink('targetSpace', 'Espace', currentSort, currentDir, app.request.query.all) }}</th>
                <th>{{ self.sortLink('startAt', 'Période', currentSort, currentDir, app.request.query.all) }}</th>
                <th>{{ self.sortLink('status', 'Statut', currentSort, currentDir, app.request.query.all) }}</th>
                <th>{{ self.sortLink('clicks', 'Clics', currentSort, currentDir, app.request.query.all) }}</th>
                <th>{{ self.sortLink('isPaid', 'Payant', currentSort, currentDir, app.request.query.all) }}</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="adsTableBody">
            {% include 'manage/advertisements/_index_rows.html.twig' %}
        </tbody>
    </table>
            </div>
        </div>
    </div>

    <div class="ctb-table-footer">
        <span class="ctb-footer-info" id="adsFooterInfo">{{ total }} publicité{{ total != 1 ? 's' : '' }} au total — page {{ page }} / {{ pages }}</span>
        <div id="adsPaginationWrap">
            {% include 'manage/advertisements/_index_pagination.html.twig' %}
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('adsFilterForm');
            const tbody = document.getElementById('adsTableBody');
            const footerInfo = document.getElementById('adsFooterInfo');
            const paginationWrap = document.getElementById('adsPaginationWrap');
            let currentPage = {{ page }};

            function refreshList() {
                const params = new URLSearchParams(new FormData(form));
                params.set('page', currentPage);
                fetch('{{ path("manage_ads_index_fragment") }}?' + params.toString())
                    .then((r) => r.json())
                    .then((data) => {
                        tbody.innerHTML = data.rowsHtml;
                        footerInfo.textContent = data.footerInfo;
                        paginationWrap.innerHTML = data.paginationHtml;
                    });
            }

            // Filtres en direct : tout changement de select relance la liste sans recharger la page.
            // Synchronise le select Zone selon la Page choisie : ne montre que les zones de cette page.
            const sitePageSelect = document.getElementById('adsSitePageSelect');
            const zoneSelect = document.getElementById('adsZoneSelect');
            function syncZoneOptionsToPage() {
                const chosenPage = sitePageSelect.value;
                let currentZoneStillValid = false;
                Array.from(zoneSelect.options).forEach((opt) => {
                    if ('' === opt.value) {
                        opt.hidden = false;
                        return;
                    }
                    const matches = !chosenPage || opt.dataset.page === chosenPage;
                    opt.hidden = !matches;
                    if (matches && opt.selected) currentZoneStillValid = true;
                });
                if (!currentZoneStillValid) {
                    zoneSelect.value = '';
                }
            }
            syncZoneOptionsToPage();
            sitePageSelect.addEventListener('change', syncZoneOptionsToPage);

            ['adsSitePageSelect', 'adsZoneSelect', 'adsStatusSelect', 'adsPerPageSelect'].forEach((id) => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener('change', function () {
                        currentPage = 1;
                        refreshList();
                    });
                }
            });

            // Recherche en direct (avec un léger débounce), indépendamment de l'autocomplétion.
            let searchTimeout;
            const searchInput = document.getElementById('adsSearchInput');
            searchInput.addEventListener('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentPage = 1;
                    refreshList();
                }, 400);
            });

            // Autocomplétion sur le titre.
            const searchResults = document.getElementById('adsSearchResults');
            let autocompleteTimeout;
            searchInput.addEventListener('input', function () {
                clearTimeout(autocompleteTimeout);
                const term = this.value.trim();
                if (term.length < 1) {
                    searchResults.innerHTML = '';
                    return;
                }
                autocompleteTimeout = setTimeout(() => {
                    fetch('{{ path("manage_ads_search_titles") }}?q=' + encodeURIComponent(term))
                        .then((r) => r.json())
                        .then((data) => {
                            searchResults.innerHTML = '';
                            data.results.forEach((item) => {
                                const btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'list-group-item list-group-item-action';
                                btn.textContent = item.title;
                                btn.addEventListener('click', () => {
                                    searchInput.value = item.title;
                                    searchResults.innerHTML = '';
                                    currentPage = 1;
                                    refreshList();
                                });
                                searchResults.appendChild(btn);
                            });
                        });
                }, 250);
            });

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                    searchResults.innerHTML = '';
                }
            });

            // Pagination en direct (les liens sont régénérés à chaque actualisation).
            paginationWrap.addEventListener('click', function (e) {
                const link = e.target.closest('.ctb-page-btn');
                if (!link || link.classList.contains('disabled')) return;
                e.preventDefault();
                currentPage = parseInt(link.dataset.page, 10);
                refreshList();
            });
        });
    </script>
{% endblock %}