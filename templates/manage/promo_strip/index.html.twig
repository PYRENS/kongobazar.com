{% extends 'manage/base.html.twig' %}
{% block title %}Bandeau promo — Accueil{% endblock %}
{% block page_icon %}bi-images{% endblock %}
{% block page_title %}Bandeau promo (accueil) — 3 bannières côte à côte en desktop{% endblock %}
{% block body %}
    <div class="sw-card mb-3">
        <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-sliders text-primary me-2"></i>Réglages</h6></div>
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input type="checkbox" class="form-check-input" id="promoStripEnabledSwitch" role="switch" {{ setting.enabled ? 'checked' : '' }} data-toggle-url="{{ path('manage_promo_strip_toggle_enabled') }}">
                <label class="form-check-label" for="promoStripEnabledSwitch">Afficher le bandeau promo sur la page d'accueil</label>
            </div>
            <form method="post" action="{{ path('manage_promo_strip_update_count') }}" class="d-flex align-items-center gap-2">
                <label class="form-label mb-0">Nombre de bannières affichées à la fois</label>
                <input type="number" name="display_count" class="form-control" style="max-width:120px;" min="1" value="{{ setting.displayCount }}">
                <button type="submit" class="btn btn-success">Enregistrer</button>
            </form>
            <small class="text-muted">Sur mobile, si plus de bannières que ce nombre existent, l'utilisateur peut les faire glisser.</small>
        </div>
    </div>

    <div class="sw-card mb-3">
        <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Ajouter une bannière</h6></div>
        <div class="card-body">
            <form method="post" action="{{ path('manage_promo_strip_add') }}" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Image (434×150px recommandé)</label>
                        <small class="text-muted d-block mb-1" id="promoImageStatus">Aucune image choisie</small>
                        <div class="kb-image-uploader" id="promoImageUploader">
                            <div class="kb-image-uploader-thumb" id="promoImageCurrent" style="display:none;">
                                <img id="promoImagePreview" src="" alt="">
                                <button type="button" class="kb-image-uploader-remove" id="promoImageRemove" aria-label="Retirer">×</button>
                            </div>
                            <label class="kb-image-uploader-dropzone" id="promoImageDropzone" for="promoImageInput">
                                <i class="bi bi-camera"></i>
                                <span>Upload</span>
                            </label>
                            <input type="file" name="image" id="promoImageInput" accept="image/*" required hidden>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Titre (texte alternatif)</label>
                        <input type="text" name="title" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Lien cible (optionnel)</label>
                        <div class="d-flex align-items-center gap-3">
                            <input type="url" name="target_url" class="form-control" placeholder="https://...">
                            <div class="form-check text-nowrap mb-0">
                                <input type="checkbox" name="open_in_new_tab" value="1" class="form-check-input" id="openNewTab">
                                <label class="form-check-label" for="openNewTab">Nouvel onglet</label>
                            </div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-success mt-3">Ajouter</button>
            </form>
        </div>
    </div>

    <div class="sw-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Aperçu</th>
                        <th>Titre</th>
                        <th>Lien</th>
                        <th>Actif</th>
                        <th>Ordre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for banner in banners %}
                        <tr>
                            <td><img src="{{ vich_uploader_asset(banner, 'imageFile') }}" style="width:120px;height:auto;border-radius:4px;" alt=""></td>
                            <td>{{ banner.title }}</td>
                            <td>{{ banner.targetUrl }}</td>
                            <td>
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input promo-toggle" role="switch" {{ banner.active ? 'checked' : '' }} data-toggle-url="{{ path('manage_promo_strip_toggle', { id: banner.id }) }}">
                                </div>
                            </td>
                            <td>
                                <form method="post" action="{{ path('manage_promo_strip_move', { id: banner.id, direction: 'up' }) }}" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">↑</button>
                                </form>
                                <form method="post" action="{{ path('manage_promo_strip_move', { id: banner.id, direction: 'down' }) }}" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">↓</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" action="{{ path('manage_promo_strip_remove', { id: banner.id }) }}" onsubmit="return confirm('Retirer cette bannière ?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">Aucune bannière.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.getElementById('promoStripEnabledSwitch').addEventListener('change', function () {
            const wasChecked = this.checked;
            fetch(this.dataset.toggleUrl, { method: 'POST' })
                .then((r) => r.json())
                .then((data) => { this.checked = data.enabled; })
                .catch(() => { this.checked = !wasChecked; });
        });

        (function () {
            const input = document.getElementById('promoImageInput');
            const currentBlock = document.getElementById('promoImageCurrent');
            const preview = document.getElementById('promoImagePreview');
            const removeBtn = document.getElementById('promoImageRemove');
            const status = document.getElementById('promoImageStatus');

            input.addEventListener('change', function () {
                const file = this.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (e) => {
                    preview.src = e.target.result;
                    currentBlock.style.display = 'block';
                    status.textContent = 'Nouvelle image sélectionnée';
                };
                reader.readAsDataURL(file);
            });

            removeBtn.addEventListener('click', () => {
                input.value = '';
                preview.src = '';
                currentBlock.style.display = 'none';
                status.textContent = 'Aucune image choisie';
            });
        })();

        document.querySelectorAll('.promo-toggle').forEach((sw) => {
            sw.addEventListener('change', function () {
                fetch(this.dataset.toggleUrl, { method: 'POST' })
                    .then((r) => r.json())
                    .then((data) => { this.checked = data.active; });
            });
        });
    </script>
{% endblock %}
