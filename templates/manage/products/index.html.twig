{% extends 'manage/base.html.twig' %}

{% block title %}Produits{% endblock %}
{% block page_icon %}bi-box-seam{% endblock %}
{% block page_title %}Produits{% endblock %}

{% macro sortLink(field, label, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Produits</h1>
        <a href="{{ path('manage_products_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nouveau produit</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-box-seam"></i></div>
                <div class="ctb-stat-val">{{ stats.total }}</div>
                <div class="ctb-stat-label">Produits au total</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div class="ctb-stat-val">{{ stats.active }}</div>
                <div class="ctb-stat-label">Actifs</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-file-earmark-text"></i></div>
                <div class="ctb-stat-val">{{ stats.draft }}</div>
                <div class="ctb-stat-label">Brouillons</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-pause-circle"></i></div>
                <div class="ctb-stat-val">{{ stats.suspended }}</div>
                <div class="ctb-stat-label">Suspendus</div>
            </div>
        </div>
    </div>

    <form method="get" id="productsFilterForm" class="d-flex align-items-center gap-2 flex-wrap">
        <input type="text" name="q" id="productsSearchInput" class="form-control" style="max-width: 240px;" placeholder="Titre, référence ou KBZ..." value="{{ searchTerm }}">

        <div class="position-relative" style="max-width:240px;">
            <input type="text" id="productsSellerSearchInput" class="form-control" placeholder="Vendeur..." value="{{ currentSellerName }}" autocomplete="off">
            <div id="productsSellerSearchResults" class="list-group position-absolute w-100" style="z-index:20;"></div>
            <input type="hidden" name="sellerProfile" id="productsSellerIdInput" value="{{ currentSellerProfile }}">
        </div>

        <select name="status" id="productsStatusSelect" class="form-select" style="max-width: 180px;">
            <option value="">— Tous statuts —</option>
            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }}>Actif</option>
            <option value="draft" {{ currentStatus == 'draft' ? 'selected' : '' }}>Brouillon</option>
            <option value="sold" {{ currentStatus == 'sold' ? 'selected' : '' }}>Vendu</option>
            <option value="suspended" {{ currentStatus == 'suspended' ? 'selected' : '' }}>Suspendu</option>
        </select>

        <select name="condition" id="productsConditionSelect" class="form-select" style="max-width: 160px;">
            <option value="">— Neuf/Occasion —</option>
            <option value="new" {{ currentCondition == 'new' ? 'selected' : '' }}>Neuf</option>
            <option value="used" {{ currentCondition == 'used' ? 'selected' : '' }}>Occasion</option>
        </select>

        <select name="perPage" id="productsPerPageSelect" class="form-select" style="max-width: 130px;">
            {% for n in [10, 20, 50, 100] %}
                <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
            {% endfor %}
        </select>

        <a href="{{ path('manage_products_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>

        <div class="w-100"></div>

        <small class="text-muted">Par cascade :</small>
        <div class="category-picker" data-category-picker id="productListCategoryPicker" style="flex-direction:row;gap:6px;">
            <select data-category-level="1" class="form-select" style="max-width:220px;">
                <option value="">— Choisir —</option>
                {% for root in rootCategories %}
                    <option value="{{ root.id }}">{{ root.name }}</option>
                {% endfor %}
            </select>
        </div>
        <input type="hidden" name="category" id="productListCategoryFilterInput" data-category-final-value value="{{ currentCategory }}">

        <div class="w-100"></div>

        <small class="text-muted">Par province :</small>
        <div id="productsProvincePicker" style="display:flex;flex-direction:row;gap:6px;flex-wrap:wrap;"></div>
        <input type="hidden" name="province" id="productsProvinceFilterInput" value="{{ currentProvince }}">
    </form>

    <div class="mb-4"></div>

    <div class="sw-card">
        <div class="card-body p-0">
            <div class="table-responsive">
    <table class="table ctb-table mb-0">
        <thead>
            <tr>
                <th>Image</th>
                <th>{{ self.sortLink('kongobazarReference', 'Réf. KongoBazar', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('title', 'Titre', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('category', 'Catégorie', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('brand', 'Marque', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('seller', 'Vendeur', currentSort, currentDir) }}</th>
                <th>Province</th>
                <th>{{ self.sortLink('basePrice', 'Prix', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('condition', 'État', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('authenticityStatus', 'Authenticité', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('status', 'Statut', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('salesCount', 'Ventes', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('createdAt', 'Créé le', currentSort, currentDir) }}</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="productsTableBody">
            {% include 'manage/products/_index_rows.html.twig' %}
        </tbody>
    </table>
            </div>
        </div>
    </div>

    <div class="ctb-table-footer">
        <span class="ctb-footer-info" id="productsFooterInfo">{{ total }} produit{{ total != 1 ? 's' : '' }} au total — page {{ page }} / {{ pages }}</span>
        <div id="productsPaginationWrap">
            {% include 'manage/products/_index_pagination.html.twig' %}
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('productsFilterForm');
            const tbody = document.getElementById('productsTableBody');
            const footerInfo = document.getElementById('productsFooterInfo');
            const paginationWrap = document.getElementById('productsPaginationWrap');
            let currentPage = {{ page }};

            function refreshList() {
                const params = new URLSearchParams(new FormData(form));
                params.set('page', currentPage);
                fetch('{{ path("manage_products_index_fragment") }}?' + params.toString())
                    .then((r) => r.json())
                    .then((data) => {
                        tbody.innerHTML = data.rowsHtml;
                        footerInfo.textContent = data.footerInfo;
                        paginationWrap.innerHTML = data.paginationHtml;
                    });
            }

            // Cascade catégorie : actualise la liste en direct, sans recharger la page.
            document.getElementById('productListCategoryPicker').addEventListener('change', function (e) {
                if (e.target.tagName !== 'SELECT') return;
                currentPage = 1;
                refreshList();
            });

            ['productsStatusSelect', 'productsConditionSelect', 'productsPerPageSelect'].forEach((id) => {
                document.getElementById(id).addEventListener('change', function () {
                    currentPage = 1;
                    refreshList();
                });
            });

            let searchTimeout;
            document.getElementById('productsSearchInput').addEventListener('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentPage = 1;
                    refreshList();
                }, 400);
            });

            const sellerSearchInput = document.getElementById('productsSellerSearchInput');
            const sellerSearchResults = document.getElementById('productsSellerSearchResults');
            const sellerIdInput = document.getElementById('productsSellerIdInput');
            let sellerTimeout;
            sellerSearchInput.addEventListener('input', function () {
                clearTimeout(sellerTimeout);
                sellerIdInput.value = '';
                const term = this.value.trim();
                if (term.length < 1) {
                    sellerSearchResults.innerHTML = '';
                    return;
                }
                sellerTimeout = setTimeout(() => {
                    fetch('/remises/rechercher-vendeurs?q=' + encodeURIComponent(term))
                        .then((r) => r.json())
                        .then((data) => {
                            sellerSearchResults.innerHTML = '';
                            data.results.forEach((seller) => {
                                const btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'list-group-item list-group-item-action';
                                btn.textContent = seller.name;
                                btn.addEventListener('click', () => {
                                    sellerSearchInput.value = seller.name;
                                    sellerIdInput.value = seller.id;
                                    sellerSearchResults.innerHTML = '';
                                    currentPage = 1;
                                    refreshList();
                                });
                                sellerSearchResults.appendChild(btn);
                            });
                        });
                }, 250);
            });
            document.addEventListener('click', function (e) {
                if (!sellerSearchInput.contains(e.target) && !sellerSearchResults.contains(e.target)) {
                    sellerSearchResults.innerHTML = '';
                }
            });

            const provincePicker = document.getElementById('productsProvincePicker');
            const provinceFilterInput = document.getElementById('productsProvinceFilterInput');
            function loadProvinceLevel(parentId, isRoot) {
                const url = isRoot ? '/geo/enfants/0' : '/geo/enfants/' + parentId;
                fetch(url)
                    .then((r) => r.json())
                    .then((data) => {
                        if (data.results.length === 0) return;
                        const select = document.createElement('select');
                        select.className = 'form-select';
                        select.style.maxWidth = '220px';
                        select.innerHTML = '<option value="">— Choisir —</option>' +
                            data.results.map((u) => '<option value="' + u.id + '">' + u.name + ' (' + u.typeLabel + ')</option>').join('');
                        select.addEventListener('change', function () {
                            let next = select.nextElementSibling;
                            while (next) {
                                const toRemove = next;
                                next = next.nextElementSibling;
                                toRemove.remove();
                            }
                            provinceFilterInput.value = this.value;
                            if (this.value) {
                                loadProvinceLevel(this.value, false);
                                currentPage = 1;
                                refreshList();
                            }
                        });
                        provincePicker.appendChild(select);
                    });
            }
            loadProvinceLevel(null, true);

            // Pagination : déléguée (les liens sont régénérés à chaque actualisation).
            paginationWrap.addEventListener('click', function (e) {
                const link = e.target.closest('.ctb-page-btn');
                if (!link || link.classList.contains('disabled')) return;
                e.preventDefault();
                currentPage = parseInt(link.dataset.page, 10);
                refreshList();
            });
        });
    </script>
{% endblock %}