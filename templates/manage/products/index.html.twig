{% extends 'manage/base.html.twig' %}

{% block title %}Produits{% endblock %}
{% block page_icon %}bi-box-seam{% endblock %}
{% block page_title %}Produits{% endblock %}

{% macro sortLink(field, label, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Produits</h1>
        <a href="{{ path('manage_products_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nouveau produit</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-box-seam"></i></div>
                <div class="ctb-stat-val">{{ stats.total }}</div>
                <div class="ctb-stat-label">Produits au total</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div class="ctb-stat-val">{{ stats.active }}</div>
                <div class="ctb-stat-label">Actifs</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-file-earmark-text"></i></div>
                <div class="ctb-stat-val">{{ stats.draft }}</div>
                <div class="ctb-stat-label">Brouillons</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-pause-circle"></i></div>
                <div class="ctb-stat-val">{{ stats.suspended }}</div>
                <div class="ctb-stat-label">Suspendus</div>
            </div>
        </div>
    </div>

    <form method="get" class="mb-2 d-flex align-items-center gap-2 flex-wrap">
        <input type="text" name="q" class="form-control" style="max-width: 240px;" placeholder="Titre ou référence..." value="{{ searchTerm }}">

        <select name="category" class="form-select" style="max-width: 220px;">
            <option value="">— Toutes catégories —</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}" {{ currentCategory == cat.id ? 'selected' : '' }}>
                    {{ cat.parent ? cat.parent.name ~ ' > ' : '' }}{{ cat.name }}
                </option>
            {% endfor %}
        </select>

        <select name="status" class="form-select" style="max-width: 180px;">
            <option value="">— Tous statuts —</option>
            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }}>Actif</option>
            <option value="draft" {{ currentStatus == 'draft' ? 'selected' : '' }}>Brouillon</option>
            <option value="sold" {{ currentStatus == 'sold' ? 'selected' : '' }}>Vendu</option>
            <option value="suspended" {{ currentStatus == 'suspended' ? 'selected' : '' }}>Suspendu</option>
        </select>

        <select name="condition" class="form-select" style="max-width: 160px;">
            <option value="">— Neuf/Occasion —</option>
            <option value="new" {{ currentCondition == 'new' ? 'selected' : '' }}>Neuf</option>
            <option value="used" {{ currentCondition == 'used' ? 'selected' : '' }}>Occasion</option>
        </select>

        <select name="perPage" class="form-select" style="max-width: 130px;" onchange="this.form.submit()">
            {% for n in [10, 20, 50, 100] %}
                <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i> Filtrer</button>
        {% if searchTerm or currentCategory or currentStatus or currentCondition %}
            <a href="{{ path('manage_products_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        {% endif %}
    </form>

    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <small class="text-muted">Ou par cascade :</small>
        <div class="category-picker" data-category-picker id="productListCategoryPicker">
            <select data-category-level="1" class="form-select" style="max-width:220px;">
                <option value="">— Choisir —</option>
                {% for root in rootCategories %}
                    <option value="{{ root.id }}">{{ root.name }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    <div class="sw-card">
        <div class="card-body p-0">
            <div class="table-responsive">
    <table class="table ctb-table mb-0">
        <thead>
            <tr>
                <th>Image</th>
                <th>{{ self.sortLink('kongobazarReference', 'Réf. KongoBazar', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('title', 'Titre', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('category', 'Catégorie', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('brand', 'Marque', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('seller', 'Vendeur', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('basePrice', 'Prix', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('condition', 'État', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('authenticityStatus', 'Authenticité', currentSort, currentDir) }}</th
                <th>{{ self.sortLink('status', 'Statut', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('salesCount', 'Ventes', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('createdAt', 'Créé le', currentSort, currentDir) }}</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                {% set firstImage = product.images.first %}
                <tr>
                    <td>
                        {% if firstImage %}
                            <img src="{{ vich_uploader_asset(firstImage, 'imageFile') }}" alt="" style="width:40px;height:40px;object-fit:cover;border-radius:4px;">
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="text-muted" style="font-size:12px;">{{ product.kongobazarReference }}</td>
                    <td title="{{ product.title }}">{{ product.title|length > 50 ? product.title|slice(0, 50) ~ '…' : product.title }}</td>
                    <td>{{ product.category ? (product.category.parent ? product.category.parent.name ~ ' / ' ~ product.category.name : product.category.name) : '—' }}</td>
                    <td>{{ product.brand ? product.brand.name : '—' }}</td>
                    <td>{{ product.sellerProfile ? product.sellerProfile.user.email : '—' }}</td>
                    <td>{{ product.basePrice }} {{ product.currency }}</td>
                    <td>{{ product.condition == 'new' ? 'Neuf' : 'Occasion' }}</td>
                    <td>
                        {% if product.authenticityStatus == 'original' %}
                            <span class="ctb-status-badge ctb-status-active"><i class="bi bi-patch-check"></i> Original</span>
                        {% elseif product.authenticityStatus == 'replica' %}
                            <span class="ctb-status-badge ctb-status-pending"><i class="bi bi-info-circle"></i> Réplique</span>
                        {% else %}<span class="text-muted">—</span>{% endif %}
                    </td>
                    <td>{{ product.status }}</td>
                    <td>{{ product.salesCount }}</td>
                    <td>{{ product.createdAt ? product.createdAt|date('d/m/Y') : '—' }}</td>
                    <td class="admin-actions">
                        <a href="{{ path('manage_products_show', {id: product.id}) }}" class="admin-btn admin-btn--outline" title="Voir détails (Dashboard)"><i class="bi bi-eye"></i></a>
                        <a href="{{ path('catalog_product', {slug: product.slug}) }}" target="_blank" class="admin-btn admin-btn--outline" title="Voir sur le site"><i class="bi bi-box-arrow-up-right"></i></a>
                        <a href="{{ path('manage_products_edit', {id: product.id}) }}" class="admin-btn admin-btn--outline" title="Modifier"><i class="bi bi-pencil"></i></a>
                        <form action="{{ path('manage_products_delete', {id: product.id}) }}" method="post" onsubmit="return confirm('Supprimer ' ~ product.title ~ ' ?');">
                            <button type="submit" class="admin-btn admin-btn--outline"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="12" class="text-muted">Aucun produit.</td></tr>
        {% endfor %}
        </tbody>
    </table>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const picker = document.getElementById('productListCategoryPicker');
            picker.addEventListener('change', function (e) {
                if (e.target.tagName !== 'SELECT' || !e.target.value) return;
                const url = new URL(window.location.href);
                url.searchParams.set('category', e.target.value);
                url.searchParams.delete('page');
                window.location.href = url.toString();
            });
        })();
    </script>

    <div class="ctb-table-footer">
        <span class="ctb-footer-info">{{ total }} produit{{ total != 1 ? 's' : '' }} au total — page {{ page }} / {{ pages }}</span>
        {% if pages > 1 %}
            <div class="ctb-pagination">
                <a href="{{ path('manage_products_index', app.request.query.all|merge({page: max(1, page - 1)})) }}" class="ctb-page-btn {{ page <= 1 ? 'disabled' : '' }}"><i class="bi bi-chevron-left"></i></a>
                {% for p in max(1, page - 2)..min(pages, page + 2) %}
                    <a href="{{ path('manage_products_index', app.request.query.all|merge({page: p})) }}" class="ctb-page-btn {{ p == page ? 'ctb-page-active' : '' }}">{{ p }}</a>
                {% endfor %}
                <a href="{{ path('manage_products_index', app.request.query.all|merge({page: min(pages, page + 1)})) }}" class="ctb-page-btn {{ page >= pages ? 'disabled' : '' }}"><i class="bi bi-chevron-right"></i></a>
            </div>
        {% endif %}
    </div>
{% endblock %}