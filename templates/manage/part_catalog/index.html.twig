{% extends 'manage/base.html.twig' %}

{% block title %}Catalogue Pièces{% endblock %}
{% block page_icon %}bi-collection{% endblock %}
{% block page_title %}Catalogue Pièces{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Catalogue Pièces</h1>
        <a href="{{ path('manage_part_catalog_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nouvelle fiche</a>
    </div>

    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <input type="text" name="q" class="form-control" style="max-width: 260px;" placeholder="Nom, EAN, référence..." value="{{ searchTerm }}">
        <select name="status" class="form-select" style="max-width: 200px;">
            <option value="">— Tous statuts —</option>
            <option value="pending_review" {{ currentStatus == 'pending_review' ? 'selected' : '' }}>En attente</option>
            <option value="validated" {{ currentStatus == 'validated' ? 'selected' : '' }}>Validée</option>
        </select>
        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
    </form>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Catégorie</th>
                <th>Marque</th>
                <th>EAN</th>
                <th>Réf. fabricant</th>
                <th>Statut</th>
                <th>Créée le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in entries %}
                <tr>
                    <td><a href="{{ path('manage_part_catalog_show', {id: entry.id}) }}">{{ entry.name }}</a></td>
                    <td>{{ entry.category.name }}</td>
                    <td>{{ entry.brand ? entry.brand.name : '—' }}</td>
                    <td>{{ entry.ean ?: '—' }}</td>
                    <td>{{ entry.manufacturerRef ?: '—' }}</td>
                    <td>
                        {% if entry.status == 'validated' %}
                            <span class="admin-badge admin-badge--active">Validée</span>
                        {% else %}
                            <span class="admin-badge admin-badge--disabled">En attente</span>
                        {% endif %}
                    </td>
                    <td>{{ entry.createdAt|date('d/m/Y') }}</td>
                    <td class="admin-actions">
                        <a href="{{ path('manage_part_catalog_show', {id: entry.id}) }}" class="admin-btn admin-btn--outline"><i class="bi bi-eye"></i></a>
                        <form action="{{ path('manage_part_catalog_delete', {id: entry.id}) }}" method="post" onsubmit="return confirm('Supprimer cette fiche catalogue ?');">
                            <button type="submit" class="admin-btn admin-btn--outline"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-muted">Aucune fiche catalogue.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}