{% extends 'manage/base.html.twig' %}

{% block title %}Catalogue Pièces{% endblock %}
{% block page_icon %}bi-collection{% endblock %}
{% block page_title %}Catalogue Pièces{% endblock %}

{% macro sortLink(field, label, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="#" class="admin-sort-link js-sort" data-sort="{{ field }}" data-dir="{{ nextDir }}">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Catalogue Pièces</h1>
        <a href="{{ path('manage_part_catalog_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nouvelle fiche</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-collection"></i></div>
                <div class="ctb-stat-val">{{ stats.total }}</div>
                <div class="ctb-stat-label">Fiches au total</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-car-front"></i></div>
                <div class="ctb-stat-val">{{ stats.auto }}</div>
                <div class="ctb-stat-label">Pièces Auto</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-motorcycle"></i></div>
                <div class="ctb-stat-val">{{ stats.moto }}</div>
                <div class="ctb-stat-label">Pièces Moto</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-patch-check"></i></div>
                <div class="ctb-stat-val">{{ stats.validated }}</div>
                <div class="ctb-stat-label">Validées</div>
            </div>
        </div>
    </div>

    <div id="catalogFilterRoot" class="mb-3 d-flex align-items-center flex-wrap gap-2">
        <input type="text" id="catalogSearchInput" class="form-control" style="max-width: 260px;" placeholder="Nom, EAN, réf. fabricant..." value="{{ searchTerm }}" autocomplete="off">
        <div class="ms-auto"></div>

        <div class="form-check form-check-inline mb-0">
            <input type="checkbox" id="showAutoCheck" class="form-check-input" checked>
            <label class="form-check-label" for="showAutoCheck">Pièces Auto</label>
        </div>
        <div class="form-check form-check-inline mb-0">
            <input type="checkbox" id="showMotoCheck" class="form-check-input" checked>
            <label class="form-check-label" for="showMotoCheck">Pièces Moto</label>
        </div>

        <div class="category-picker" data-category-picker id="categoryFilterPickerRoot" style="flex-direction:row;gap:6px;">
            <select data-category-level="1" class="form-select" style="width:auto;">
                <option value="">— Toutes catégories —</option>
                {% for cat in partFilterCategories %}
                    <option value="{{ cat.id }}">{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>
        <input type="hidden" id="categoryFilterIdInput" data-category-final-value value="{{ currentCategoryId }}">

        <select id="catalogStatusSelect" class="form-select" style="max-width: 200px;">
            <option value="">— Tous statuts —</option>
            <option value="draft" {{ currentStatus == 'draft' ? 'selected' : '' }}>Brouillon</option>
            <option value="pending_review" {{ currentStatus == 'pending_review' ? 'selected' : '' }}>En attente</option>
            <option value="validated" {{ currentStatus == 'validated' ? 'selected' : '' }}>Validée</option>
        </select>

        <select id="catalogPerPageSelect" class="form-select ms-auto" style="max-width: 140px;">
            {% for n in [10, 20, 50, 100] %}
                <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
            {% endfor %}
        </select>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Logo</th>
                    <th>{{ self.sortLink('name', 'Nom', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('partType', 'Type', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('rootCategoryName', 'Catégorie', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('subcategory', 'Sous-catégorie', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('brand', 'Marque', currentSort, currentDir) }}</th>
                    <th>EAN</th>
                    <th>Réf. fabricant</th>
                    <th>{{ self.sortLink('sellerCount', 'Vendeurs', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('engineCount', 'Motorisations', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('productCount', 'Produits', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('totalQuantity', 'Qté totale', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('status', 'Statut', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('updatedAt', 'Mise à jour', currentSort, currentDir) }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="catalogTableBody">
                {% include 'manage/part_catalog/_index_rows.html.twig' %}
            </tbody>
        </table>
    </div>

    <div id="catalogFooter" class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted" id="catalogFooterInfo">{{ total }} fiche{{ total != 1 ? 's' : '' }} — page {{ page }} / {{ pages }}</span>
        <div class="ctb-pagination" id="catalogPagination">
            {% include 'manage/part_catalog/_index_pagination.html.twig' %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/manage/category-picker.js') }}"></script>
    <script>
        const state = {
            q: '{{ searchTerm|e('js') }}',
            category: '{{ currentCategoryId }}',
            status: '{{ currentStatus }}',
            sort: '{{ currentSort|default('name') }}',
            dir: '{{ currentDir|default('ASC') }}',
            showAuto: '1',
            showMoto: '1',
            perPage: {{ perPage|default(20) }},
            page: {{ page|default(1) }},
        };

        const tableBody = document.getElementById('catalogTableBody');
        const footerInfo = document.getElementById('catalogFooterInfo');
        const pagination = document.getElementById('catalogPagination');
        let debounceTimer;

        function load() {
            const params = new URLSearchParams(state);
            fetch('{{ path("manage_part_catalog_index_fragment") }}?' + params.toString())
                .then((r) => r.json())
                .then((data) => {
                    tableBody.innerHTML = data.rowsHtml;
                    footerInfo.textContent = data.footerInfo;
                    pagination.innerHTML = data.paginationHtml;
                    bindSortLinks();
                    bindPaginationLinks();
                });
        }

        function bindSortLinks() {
            document.querySelectorAll('.js-sort').forEach((link) => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    state.sort = this.dataset.sort;
                    state.dir = this.dataset.dir;
                    state.page = 1;
                    load();
                });
            });
        }
        bindSortLinks();

        function bindPaginationLinks() {
            document.querySelectorAll('.js-page').forEach((link) => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (this.classList.contains('disabled')) return;
                    state.page = parseInt(this.dataset.page, 10);
                    load();
                });
            });
        }
        bindPaginationLinks();

        const searchInput = document.getElementById('catalogSearchInput');
        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => { state.q = this.value.trim(); state.page = 1; load(); }, 300);
        });

        document.getElementById('catalogStatusSelect').addEventListener('change', function () {
            state.status = this.value;
            state.page = 1;
            load();
        });

        document.getElementById('categoryFilterPickerRoot').addEventListener('change', function () {
            state.category = document.getElementById('categoryFilterIdInput').value;
            state.page = 1;
            load();
        });

        document.getElementById('showAutoCheck').addEventListener('change', function () {
            state.showAuto = this.checked ? '1' : '0';
            state.page = 1;
            load();
        });
        document.getElementById('showMotoCheck').addEventListener('change', function () {
            state.showMoto = this.checked ? '1' : '0';
            state.page = 1;
            load();
        });

        document.getElementById('catalogPerPageSelect').addEventListener('change', function () {
            state.perPage = parseInt(this.value, 10);
            state.page = 1;
            load();
        });
    </script>
{% endblock %}