{% for row in rows %}
    {% set entry = row.entry %}
    <tr>
        <td>
            {% if entry.brand and entry.brand.logoName %}
                <img src="{{ vich_uploader_asset(entry.brand, 'logoFile') }}" style="width:32px;height:32px;object-fit:contain;">
            {% else %}<span class="text-muted">—</span>{% endif %}
        </td>
        <td>
            <a href="{{ path('manage_part_catalog_view', {id: entry.id}) }}">{{ entry.name }}</a>
            {% if entry.blocked %}<span class="admin-badge admin-badge--disabled">Bloquée</span>{% endif %}
        </td>
        <td>{{ row.rootCategoryName ?: '—' }}</td>
        <td>{{ entry.category.name }}</td>
        <td>{{ entry.brand ? entry.brand.name : '—' }}</td>
        <td>{{ entry.ean ?: '—' }}</td>
        <td>{{ entry.manufacturerRef ?: '—' }}</td>
        <td>
            {% if row.sellerCount > 0 %}
                <a href="{{ path('manage_part_catalog_view', {id: entry.id}) }}#sellers">{{ row.sellerCount }}</a>
            {% else %}0{% endif %}
        </td>
        <td>
            {% if row.engineCount > 0 %}
                <a href="{{ path('manage_part_catalog_view', {id: entry.id}) }}#vehicles">{{ row.engineCount }}</a>
            {% else %}0{% endif %}
        </td>
        <td>
            {% if row.productCount > 0 %}
                <a href="{{ path('manage_part_catalog_view', {id: entry.id}) }}#products">{{ row.productCount }}</a>
            {% else %}0{% endif %}
        </td>
        <td>{{ row.totalQuantity }}</td>
        <td>
            {% if entry.status == 'validated' %}
                <span class="admin-badge admin-badge--active">Validée</span>
            {% elseif entry.status == 'draft' %}
                <span class="admin-badge admin-badge--disabled">Brouillon</span>
            {% else %}
                <span class="admin-badge admin-badge--disabled">En attente</span>
            {% endif %}
        </td>
        <td>{{ entry.updatedAt ? entry.updatedAt|date('d/m/Y H:i') : '—' }}</td>
        <td class="admin-actions">
            <a href="{{ path('manage_part_catalog_view', {id: entry.id}) }}" class="admin-btn admin-btn--outline" title="Voir"><i class="bi bi-eye"></i></a>
            <a href="{{ path('manage_part_catalog_show', {id: entry.id}) }}" class="admin-btn admin-btn--outline" title="Modifier"><i class="bi bi-pencil"></i></a>
            <form action="{{ path('manage_part_catalog_toggle_block', {id: entry.id}) }}" method="post" class="d-inline">
                <button type="submit" class="admin-btn admin-btn--outline" title="{{ entry.blocked ? 'Débloquer' : 'Bloquer' }}">
                    <i class="bi {{ entry.blocked ? 'bi-check-circle' : 'bi-slash-circle' }}"></i>
                </button>
            </form>
            <form action="{{ path('manage_part_catalog_delete', {id: entry.id}) }}" method="post" onsubmit="return confirm('Supprimer cette fiche catalogue ?');" class="d-inline">
                <button type="submit" class="admin-btn admin-btn--outline" title="Supprimer"><i class="bi bi-trash"></i></button>
            </form>
        </td>
    </tr>
{% else %}
    <tr><td colspan="14" class="text-muted">Aucune fiche catalogue.</td></tr>
{% endfor %}