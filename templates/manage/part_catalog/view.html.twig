{% extends 'manage/base.html.twig' %}

{% block title %}{{ entry.name }} — Voir{% endblock %}
{% block page_icon %}bi-collection{% endblock %}
{% block page_title %}{{ entry.name }}{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="{{ path('manage_part_catalog_index') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Retour à la liste</a>
        <div class="d-flex gap-2">
            <a href="{{ path('manage_part_catalog_show', {id: entry.id}) }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Modifier</a>
            <form action="{{ path('manage_part_catalog_toggle_block', {id: entry.id}) }}" method="post">
                <button type="submit" class="btn btn-outline-{{ entry.blocked ? 'success' : 'warning' }} btn-sm">
                    <i class="bi {{ entry.blocked ? 'bi-check-circle' : 'bi-slash-circle' }} me-1"></i>{{ entry.blocked ? 'Débloquer' : 'Bloquer' }}
                </button>
            </form>
            <form action="{{ path('manage_part_catalog_delete', {id: entry.id}) }}" method="post" onsubmit="return confirm('Supprimer cette fiche catalogue ?');">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>Supprimer</button>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-people"></i></div>
                <div class="ctb-stat-val">{{ sellerStats|length }}</div>
                <div class="ctb-stat-label">Vendeur(s) rattaché(s)</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-box-seam"></i></div>
                <div class="ctb-stat-val">{{ attachedProducts|length }}</div>
                <div class="ctb-stat-label">Produit(s) rattaché(s)</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-car-front"></i></div>
                <div class="ctb-stat-val">{{ entry.engineCompatibilities|length }}</div>
                <div class="ctb-stat-label">Motorisation(s) compatible(s)</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-diagram-3"></i></div>
                <div class="ctb-stat-val">{{ (similarCatalogEntries|length) + (similarProducts|length) }}</div>
                <div class="ctb-stat-label">Pièce(s) similaire(s) (même OEM)</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-xl-5">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold">Images</h6></div>
                <div class="card-body">
                    {% if entry.images|length > 0 %}
                        <div class="mb-3" style="border-radius:8px;overflow:hidden;background:var(--body-bg,#f5f5f5);">
                            <img id="viewMainImage" src="{{ vich_uploader_asset(entry.images|first, 'imageFile') }}" style="width:100%;max-height:420px;aspect-ratio:1;object-fit:contain;">
                        </div>
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            {% for image in entry.images %}
                                <img src="{{ vich_uploader_asset(image, 'imageFile') }}" class="view-thumb-item {{ loop.first ? 'active' : '' }}" data-full="{{ vich_uploader_asset(image, 'imageFile') }}" style="width:56px;height:56px;object-fit:cover;border-radius:6px;cursor:pointer;border:2px solid {{ loop.first ? 'var(--primary,#0d6efd)' : 'transparent' }};">
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">Aucune image.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="sw-card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h6 class="mb-0 fw-bold">Informations</h6>
                    {% if entry.status == 'validated' %}
                        <span class="ctb-status-badge ctb-status-active">Validée</span>
                    {% elseif entry.status == 'draft' %}
                        <span class="ctb-status-badge ctb-status-inactive">Brouillon</span>
                    {% else %}
                        <span class="ctb-status-badge ctb-status-pending">En attente</span>
                    {% endif %}
                    {% if entry.blocked %}<span class="ctb-status-badge ctb-status-banned ms-1">Bloquée</span>{% endif %}
                </div>
                <div class="card-body">
                    <table class="table mb-0">
                        <tr><td class="text-muted" style="width:180px;">Catégorie</td><td>{{ entry.category.name }}</td></tr>
                        <tr><td class="text-muted">Fabricant</td>
                            <td>
                                {% if entry.brand %}
                                    {{ entry.brand.name }}
                                    {% if entry.brand.logoName %}
                                        {% if entry.brand.url %}<a href="{{ entry.brand.url }}" target="_blank" rel="noopener">{% endif %}
                                        <img src="{{ vich_uploader_asset(entry.brand, 'logoFile') }}" style="height:24px;vertical-align:middle;margin-left:6px;">
                                        {% if entry.brand.url %}</a>{% endif %}
                                    {% endif %}
                                {% else %}—{% endif %}
                            </td>
                        </tr>
                        <tr><td class="text-muted">EAN</td><td>{{ entry.ean ?: '—' }}</td></tr>
                        <tr><td class="text-muted">Réf. fabricant</td><td>{{ entry.manufacturerRef ?: '—' }}</td></tr>
                        <tr><td class="text-muted">Vérifiée / Complétée</td><td>{{ entry.verified ? 'Oui' : 'Non' }} / {{ entry.complete ? 'Oui' : 'Non' }}</td></tr>
                        <tr><td class="text-muted">Créée le</td><td>{{ entry.createdAt ? entry.createdAt|date('d/m/Y H:i') : '—' }}</td></tr>
                    </table>
                    {% if entry.description %}
                        <hr>
                        <p class="mb-0" style="white-space:pre-line;">{{ entry.description }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if entry.oemCodes|length > 0 %}
        <div class="sw-card mb-3">
            <div class="card-header"><h6 class="mb-0 fw-bold">Codes OEM ({{ entry.oemCodes|length }})</h6></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    {% for oem in entry.oemCodes %}
                        <span class="ctb-status-badge ctb-status-inactive" style="font-weight:400;">
                            {{ oem.code }}{{ oem.brand ? ' (' ~ oem.brand.name ~ ')' : '' }}
                        </span>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    {% if entry.attributeValues|length > 0 %}
        <div class="sw-card mb-3">
            <div class="card-header"><h6 class="mb-0 fw-bold">Caractéristiques</h6></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        {% for v in entry.attributeValues %}
                            {% set charac = v.categoryAttribute.characteristic %}
                            <tr>
                                <td class="text-muted">{{ charac.name }}{{ charac.unit ? ' [' ~ charac.unit ~ ']' : '' }}</td>
                                <td><strong>{{ v.textValue }}</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {% if groupedVehicles|length > 0 %}
        <div class="sw-card mb-3" id="vehicles">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold"><i class="bi bi-car-front me-2"></i>Véhicules compatibles</h6>
                <button type="button" id="toggleViewEngineListBtn" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-chevron-down"></i> Afficher la liste
                </button>
            </div>
            <div class="card-body p-0">
                <div id="viewEngineListWrap" style="display:none;">
                <div class="accordion" id="vehicleAccordion">
                    {% for brandName, modelVariants in groupedVehicles %}
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#vBrand{{ loop.index }}">
                                    {{ brandName }}
                                </button>
                            </h2>
                            <div id="vBrand{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#vehicleAccordion">
                                <div class="accordion-body p-0">
                                    {% for modelVariantName, fuels in modelVariants %}
                                        <div class="p-3 border-bottom">
                                            <div class="fw-bold mb-1">{{ modelVariantName }}</div>
                                            {% for fuelName, engines in fuels %}
                                                <div class="ms-3 mb-1">
                                                    <span class="text-muted" style="font-size:12px;"><i class="bi bi-fuel-pump me-1"></i>{{ fuelName }}</span>
                                                    <ul class="mb-0 ps-4" style="font-size:13px;">
                                                        {% for engine in engines %}
                                                            <li>{{ engine.label }} <span class="text-muted">({{ engine.periodLabel }})</span></li>
                                                        {% endfor %}
                                                    </ul>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if attachedProducts|length > 0 %}
        <div class="sw-card mb-3" id="products">
            <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Produits rattachés</h6></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Produit</th><th>Vendeur</th><th>Prix</th><th>Statut</th></tr></thead>
                    <tbody>
                        {% for p in attachedProducts %}
                            <tr>
                                <td><a href="{{ path('manage_products_show', {id: p.id}) }}">{{ p.title }}</a></td>
                                <td>{{ p.sellerProfile ? p.sellerProfile.displayName : '—' }}</td>
                                <td>{{ p.basePrice }} {{ p.currency }}</td>
                                <td>{{ p.status }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="row g-3">
        <div class="col-xl-6" id="sellers">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold">Vendeurs utilisant cette fiche</h6></div>
                <div class="card-body p-0">
                    {% if sellerStats|length > 0 %}
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Vendeur</th><th>Produits</th></tr></thead>
                            <tbody>
                                {% for s in sellerStats %}
                                    <tr><td>{{ s.sellerName }}</td><td>{{ s.productCount }}</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-muted p-3 mb-0">Aucun vendeur ne s'est encore rattaché à cette fiche.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold">Pièces similaires (même OEM)</h6></div>
                <div class="card-body p-0">
                    {% if similarCatalogEntries|length == 0 and similarProducts|length == 0 %}
                        <p class="text-muted p-3 mb-0">Aucune pièce similaire trouvée.</p>
                    {% else %}
                        <ul class="list-group list-group-flush">
                            {% for e in similarCatalogEntries %}
                                <li class="list-group-item">
                                    <a href="{{ path('manage_part_catalog_view', {id: e.id}) }}">{{ e.name }}</a>
                                    <span class="text-muted" style="font-size:11px;">(catalogue)</span>
                                </li>
                            {% endfor %}
                            {% for p in similarProducts %}
                                <li class="list-group-item">
                                    <a href="{{ path('manage_products_show', {id: p.id}) }}">{{ p.title }}</a>
                                    <span class="text-muted" style="font-size:11px;">(produit)</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mainImage = document.getElementById('viewMainImage');
            if (mainImage) {
                document.querySelectorAll('.view-thumb-item').forEach((thumb) => {
                    thumb.addEventListener('click', function () {
                        mainImage.src = this.dataset.full;
                        document.querySelectorAll('.view-thumb-item').forEach((t) => {
                            t.classList.remove('active');
                            t.style.borderColor = 'transparent';
                        });
                        this.classList.add('active');
                        this.style.borderColor = 'var(--primary, #0d6efd)';
                    });
                });
            }

            const toggleViewEngineListBtn = document.getElementById('toggleViewEngineListBtn');
            const viewEngineListWrap = document.getElementById('viewEngineListWrap');
            if (toggleViewEngineListBtn && viewEngineListWrap) {
                toggleViewEngineListBtn.addEventListener('click', function () {
                    const hidden = viewEngineListWrap.style.display === 'none';
                    viewEngineListWrap.style.display = hidden ? '' : 'none';
                    this.innerHTML = hidden
                        ? '<i class="bi bi-chevron-up"></i> Masquer la liste'
                        : '<i class="bi bi-chevron-down"></i> Afficher la liste';
                });
            }
        });
    </script>
{% endblock %}