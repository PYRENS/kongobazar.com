{% extends 'manage/base.html.twig' %}

{% block title %}Sous-catégories — {{ rayon.name }}{% endblock %}
{% block page_icon %}bi-list-check{% endblock %}
{% block page_title %}Méga-menu — {{ rayon.name }}{% endblock %}

{% block body %}
    <a href="{{ path('manage_mega_menu_index') }}" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-left me-1"></i>Retour au méga-menu</a>

    <div class="sw-card mb-3">
        <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-pin-angle text-primary me-2"></i>Sous-catégories épinglées <small class="text-muted fw-normal">(affichées dans cet ordre — 5 max recommandé)</small></h6></div>
        <div class="card-body p-0">
            {% if featured|length == 0 %}
                <p class="text-muted p-3 mb-0">Aucune sous-catégorie épinglée pour l'instant : le méga-menu affiche automatiquement les 5 premières de "{{ rayon.name }}" par défaut.</p>
            {% else %}
                <table class="table ctb-table mb-0">
                    <tbody>
                        {% for child in featured %}
                            <tr>
                                <td style="width: 60px;">
                                    <form method="post" action="{{ path('manage_mega_menu_child_move', { id: child.id, direction: 'up' }) }}" style="display:inline;">
                                        <button type="submit" class="admin-btn admin-btn--outline"{{ loop.first ? ' disabled' }}><i class="bi bi-arrow-up"></i></button>
                                    </form>
                                    <form method="post" action="{{ path('manage_mega_menu_child_move', { id: child.id, direction: 'down' }) }}" style="display:inline;">
                                        <button type="submit" class="admin-btn admin-btn--outline"{{ loop.last ? ' disabled' }}><i class="bi bi-arrow-down"></i></button>
                                    </form>
                                </td>
                                <td>{{ child.name }}</td>
                                <td style="width: 120px;">
                                    <form method="post" action="{{ path('manage_mega_menu_child_toggle', { id: child.id }) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

    <div class="sw-card">
        <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-list-ul text-primary me-2"></i>Toutes les sous-catégories de "{{ rayon.name }}"</h6></div>
        <div class="card-body p-0">
            <table class="table ctb-table mb-0">
                <tbody>
                    {% for child in children %}
                        {% if not child.megaMenuChildFeatured %}
                            <tr>
                                <td>{{ child.name }}</td>
                                <td style="width: 120px;">
                                    <form method="post" action="{{ path('manage_mega_menu_child_toggle', { id: child.id }) }}">
                                        <button type="submit" class="btn btn-sm btn-primary">Épingler</button>
                                    </form>
                                </td>
                            </tr>
                        {% endif %}
                    {% else %}
                        <tr><td class="text-muted">Aucune sous-catégorie.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
