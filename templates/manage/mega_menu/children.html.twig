{% extends 'manage/base.html.twig' %}

{% block title %}Sous-catégories — {{ rayon.name }}{% endblock %}
{% block page_icon %}bi-list-check{% endblock %}
{% block page_title %}Méga-menu — {{ rayon.name }}{% endblock %}

{% block body %}
<a href="{{ path('manage_mega_menu_index') }}" class="admin-btn admin-btn--outline mb-3"><i class="bi bi-arrow-left"></i> Retour au méga-menu</a>

<div class="admin-card">
    <h5 class="mb-3">Sous-catégories épinglées <small class="text-muted">(affichées dans cet ordre — 5 max recommandé)</small></h5>

    {% if featured|length == 0 %}
        <p class="text-muted">Aucune sous-catégorie épinglée pour l'instant : le méga-menu affiche automatiquement les 5 premières de "{{ rayon.name }}" par défaut.</p>
    {% endif %}

    <table class="table admin-table">
        <tbody>
            {% for child in featured %}
                <tr>
                    <td style="width: 60px;">
                        <form method="post" action="{{ path('manage_mega_menu_child_move', { id: child.id, direction: 'up' }) }}" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-light"{{ loop.first ? ' disabled' }}><i class="bi bi-arrow-up"></i></button>
                        </form>
                        <form method="post" action="{{ path('manage_mega_menu_child_move', { id: child.id, direction: 'down' }) }}" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-light"{{ loop.last ? ' disabled' }}><i class="bi bi-arrow-down"></i></button>
                        </form>
                    </td>
                    <td>{{ child.name }}</td>
                    <td style="width: 120px;">
                        <form method="post" action="{{ path('manage_mega_menu_child_toggle', { id: child.id }) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <hr class="my-4">

    <h6>Toutes les sous-catégories de "{{ rayon.name }}"</h6>
    <table class="table admin-table">
        <tbody>
            {% for child in children %}
                {% if not child.megaMenuChildFeatured %}
                    <tr>
                        <td>{{ child.name }}</td>
                        <td style="width: 120px;">
                            <form method="post" action="{{ path('manage_mega_menu_child_toggle', { id: child.id }) }}">
                                <button type="submit" class="btn btn-sm btn-primary">Épingler</button>
                            </form>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}