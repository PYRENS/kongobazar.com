{% extends 'manage/base.html.twig' %}

{% block title %}Méga-menu{% endblock %}
{% block page_icon %}bi-grid-3x3-gap{% endblock %}
{% block page_title %}Méga-menu — Catalogue{% endblock %}

{% block body %}
    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-grid-3x3-gap"></i></div>
                <div class="ctb-stat-val">{{ stats.total }}</div>
                <div class="ctb-stat-label">Rayons au total</div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-eye"></i></div>
                <div class="ctb-stat-val">{{ stats.visible }}</div>
                <div class="ctb-stat-label">Affichés dans le menu</div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-eye-slash"></i></div>
                <div class="ctb-stat-val">{{ stats.hidden }}</div>
                <div class="ctb-stat-label">Masqués</div>
            </div>
        </div>
    </div>

    <div class="sw-card">
        <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-grid-3x3-gap text-primary me-2"></i>Rayons du méga-menu</h6></div>
        <div class="card-body p-0">
            <p class="text-muted p-3 mb-0">
                Coche/décoche pour afficher ou masquer un rayon dans le méga-menu du "Catalogue" (navbar du haut), et utilise les flèches pour changer l'ordre des colonnes.
                Clique sur un rayon pour choisir ses sous-catégories mises en avant.
            </p>

            <div id="megaMenuTable" data-live-table>
                {% include 'manage/mega_menu/_table.html.twig' %}
            </div>
        </div>
    </div>
{% endblock %}
