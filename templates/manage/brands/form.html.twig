{% extends 'manage/base.html.twig' %}

{% block title %}{{ brand ? 'Modifier la marque' : 'Nouvelle marque' }}{% endblock %}
{% block page_icon %}bi-award{% endblock %}
{% block page_title %}{{ brand ? 'Modifier « ' ~ brand.name ~ ' »' : 'Nouvelle marque' }}{% endblock %}

{% block body %}
    <div class="sw-card" style="max-width:620px;">
        <div class="card-header"><h6 class="mb-0 fw-bold">{{ brand ? 'Modifier la marque' : 'Nouvelle marque' }}</h6></div>
        <div class="card-body">
            <form method="post" action="{{ brand ? path('manage_brands_update', {id: brand.id}) : path('manage_brands_new') }}" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="acc-form-label">Logo</label>
                    <div class="admin-file-upload-group">
                        <div class="admin-upload-thumb" id="newLogoPreviewBox" style="display:none;">
                            <span class="admin-upload-thumb-label">{% if brand and brand.logoName %}Nouveau{% endif %}</span>
                            <div class="admin-upload-thumb-inner">
                                <img src="" id="newLogoPreview" alt="Nouveau logo">
                                <button type="button" class="admin-upload-remove" id="removeNewLogo" aria-label="Retirer le nouveau logo">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>

                        <div class="admin-upload-thumb">
                            <span class="admin-upload-thumb-label">&nbsp;</span>
                            <label class="admin-upload-dropzone" for="logoInput">
                                <i class="bi bi-camera"></i>
                                <span>Upload</span>
                            </label>
                        </div>
                        <input type="file" name="logo" id="logoInput" accept="image/*" class="admin-upload-input-hidden">

                        {% if brand and brand.logoName %}
                            <div class="admin-upload-thumb">
                                <span class="admin-upload-thumb-label">Actuel</span>
                                <div class="admin-upload-thumb-inner">
                                    <img src="{{ vich_uploader_asset(brand, 'logoFile') }}" alt="Logo actuel">
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="mb-3">
                    <label class="acc-form-label">Nom</label>
                    <input type="text" name="name" class="acc-form-input" value="{{ brand ? brand.name : '' }}" required>
                </div>

                <div class="mb-3">
                    <label class="acc-form-label">Sigle (optionnel)</label>
                    <input type="text" name="sigle" class="acc-form-input" value="{{ brand ? brand.sigle : '' }}" maxlength="20" placeholder="ex: BMW, VW">
                </div>

                <div class="mb-3">
                    <label class="acc-form-label">Site officiel de la marque (optionnel)</label>
                    <input type="url" name="url" class="acc-form-input" value="{{ brand ? brand.url : '' }}" placeholder="https://www.marque.com" maxlength="255">
                    <small class="text-muted d-block">Si renseigné, le logo de la marque devient cliquable (ouvre ce lien dans un nouvel onglet) partout où il s'affiche.</small>
                </div>

                <div class="mb-3">
                    <label class="acc-form-label d-block">Domaine(s) d'usage</label>
                    <div class="form-check form-check-inline">
                        <input type="checkbox" name="type[]" value="auto" class="form-check-input" id="typeAuto"
                            {{ brand and brand.hasType('auto') ? 'checked' : '' }}>
                        <label class="form-check-label" for="typeAuto">Auto</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="checkbox" name="type[]" value="moto" class="form-check-input" id="typeMoto"
                            {{ brand and brand.hasType('moto') ? 'checked' : '' }}>
                        <label class="form-check-label" for="typeMoto">Moto</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="checkbox" name="type[]" value="piece" class="form-check-input" id="typePiece"
                            {{ brand and brand.hasType('piece') ? 'checked' : '' }}>
                        <label class="form-check-label" for="typePiece">Pièce détachée (ex: Bosch, Gates...)</label>
                    </div>
                    <small class="text-muted d-block">Laisser toutes les cases décochées pour une marque générique (mode, électronique...).</small>
                </div>

                <div class="mb-3">
                    <label class="acc-form-label">Pays</label>
                    {% set selectedPays = brand and brand.pays ? brand.pays : null %}
                    <div class="admin-country-picker" id="paysPicker">
                        <button type="button" class="admin-country-picker-toggle" id="paysPickerToggle">
                            <span class="admin-country-picker-toggle-label">
                                {% if selectedPays %}
                                    <span class="fi fi-{{ selectedPays.iso2|lower }}"></span> {{ selectedPays.name }}
                                {% else %}
                                    <span class="text-muted">— Aucun —</span>
                                {% endif %}
                            </span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="admin-country-picker-panel" id="paysPickerPanel" style="display:none;">
                            <input type="text" class="admin-country-picker-search" id="paysPickerSearch" placeholder="Rechercher un pays...">
                            <div class="admin-country-picker-list">
                                <button type="button" class="admin-country-picker-row" data-pays-id="" data-pays-flag="" data-pays-name="— Aucun —">
                                    <span class="text-muted">— Aucun —</span>
                                </button>
                                {% for pays in paysList %}
                                    <button type="button" class="admin-country-picker-row" data-pays-id="{{ pays.id }}" data-pays-flag="fi-{{ pays.iso2|lower }}" data-pays-name="{{ pays.name }}">
                                        <span class="fi fi-{{ pays.iso2|lower }}"></span> {{ pays.name }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="pays_id" id="paysIdInput" value="{{ selectedPays ? selectedPays.id : '' }}">
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" name="verified" value="1" class="form-check-input" id="verified"
                        {{ brand and brand.verified ? 'checked' : '' }}>
                    <label class="form-check-label" for="verified">Marque vérifiée</label>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" name="premium" value="1" class="form-check-input" id="premium"
                        {{ brand and brand.premium ? 'checked' : '' }}>
                    <label class="form-check-label" for="premium">Marque premium</label>
                    <small class="text-muted d-block">Apparaît en tête (par ordre alphabétique) dans les listes de marques, avant les autres.</small>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" name="active" value="1" class="form-check-input" id="active"
                        {{ brand is null or brand.active ? 'checked' : '' }}>
                    <label class="form-check-label" for="active">Marque active</label>
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-2"></i>Enregistrer</button>
                <a href="{{ path('manage_brands_index') }}" class="btn btn-outline-secondary ms-2">Annuler</a>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const logoInput = document.getElementById('logoInput');
        const logoPreviewBox = document.getElementById('newLogoPreviewBox');
        const logoPreview = document.getElementById('newLogoPreview');
        const removeLogoBtn = document.getElementById('removeNewLogo');

        logoInput.addEventListener('change', function (e) {
            const file = e.target.files[0];

            if (!file) {
                logoPreviewBox.style.display = 'none';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (ev) {
                logoPreview.src = ev.target.result;
                logoPreviewBox.style.display = 'flex';
            };
            reader.readAsDataURL(file);
        });

        removeLogoBtn.addEventListener('click', function () {
            logoInput.value = '';
            logoPreview.src = '';
            logoPreviewBox.style.display = 'none';
        });

        const paysPicker = document.getElementById('paysPicker');
        const paysPickerToggle = document.getElementById('paysPickerToggle');
        const paysPickerPanel = document.getElementById('paysPickerPanel');
        const paysPickerSearch = document.getElementById('paysPickerSearch');
        const paysIdInput = document.getElementById('paysIdInput');
        const paysRows = paysPickerPanel.querySelectorAll('.admin-country-picker-row');

        paysPickerToggle.addEventListener('click', function (e) {
            e.stopPropagation();
            const isOpen = paysPickerPanel.style.display !== 'none';
            paysPickerPanel.style.display = isOpen ? 'none' : 'block';
            if (!isOpen) {
                paysPickerSearch.value = '';
                paysRows.forEach((r) => { r.style.display = ''; });
                paysPickerSearch.focus();
            }
        });

        document.addEventListener('click', function (e) {
            if (!paysPicker.contains(e.target)) {
                paysPickerPanel.style.display = 'none';
            }
        });

        paysPickerSearch.addEventListener('input', function () {
            const term = paysPickerSearch.value.toLowerCase();
            paysRows.forEach((row) => {
                const name = (row.dataset.paysName || '').toLowerCase();
                row.style.display = name.includes(term) ? '' : 'none';
            });
        });

        const paysPickerLabel = paysPickerToggle.querySelector('.admin-country-picker-toggle-label');

        paysRows.forEach((row) => {
            row.addEventListener('click', function () {
                paysIdInput.value = row.dataset.paysId || '';
                paysPickerLabel.innerHTML = row.dataset.paysId
                    ? '<span class="fi ' + row.dataset.paysFlag + '"></span> ' + row.dataset.paysName
                    : '<span class="text-muted">— Aucun —</span>';
                paysPickerPanel.style.display = 'none';
            });
        });
    </script>
{% endblock %}