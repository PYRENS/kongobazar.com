{% extends 'manage/base.html.twig' %}

{% block title %}Produits — {{ brand.name }}{% endblock %}
{% block page_icon %}bi-box-seam{% endblock %}
{% block page_title %}Produits de {{ brand.name }}{% endblock %}

{% block body %}
    <nav class="admin-breadcrumb">
        <a href="{{ path('manage_brands_index') }}"><i class="bi bi-award"></i> Marques</a>
        <i class="bi bi-chevron-right"></i>
        <a href="{{ path('manage_brands_show', {id: brand.id}) }}">{{ brand.name }}</a>
        <i class="bi bi-chevron-right"></i>
        <span>Produits</span>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
        <h1 class="h4 mb-0">Produits de {{ brand.name }}</h1>
        <a href="{{ path('manage_brands_show', {id: brand.id}) }}" class="btn btn-outline-secondary btn-sm">Retour à la marque</a>
    </div>

    <form method="get" class="mb-3 d-flex align-items-center gap-2 flex-wrap">
        <input type="text" name="q" class="form-control" style="max-width: 260px;" placeholder="Rechercher un titre, une référence..." value="{{ currentTerm }}">

        <select name="status" class="form-select" style="max-width: 200px;">
            <option value="">— Tous statuts —</option>
            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }}>Actif</option>
            <option value="draft" {{ currentStatus == 'draft' ? 'selected' : '' }}>Brouillon</option>
            <option value="sold" {{ currentStatus == 'sold' ? 'selected' : '' }}>Vendu</option>
            <option value="suspended" {{ currentStatus == 'suspended' ? 'selected' : '' }}>Suspendu</option>
        </select>

        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i> Filtrer</button>
        {% if currentTerm or currentStatus %}
            <a href="{{ path('manage_brands_products', {id: brand.id}) }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        {% endif %}
    </form>

    <p class="text-muted mb-2">{{ total }} produit{{ total > 1 ? 's' : '' }} au total</p>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Titre</th>
                <th>Catégorie</th>
                <th>Prix</th>
                <th>État</th>
                <th>Statut</th>
                <th>Ventes</th>
                <th>Créé le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                {% set firstImage = product.images.first %}
                <tr>
                    <td>
                        {% if firstImage %}
                            <img src="{{ vich_uploader_asset(firstImage, 'imageFile') }}" alt="" class="admin-zoomable-thumb" style="width:48px;height:48px;object-fit:cover;border-radius:4px;cursor:zoom-in;">
                        {% else %}
                            <span class="text-muted">N/A</span>
                        {% endif %}
                    </td>
                    <td>{{ product.title }}</td>
                    <td>{{ product.category ? product.category.name : '—' }}</td>
                    <td>{{ product.basePrice }} {{ product.currency }}</td>
                    <td>{{ product.condition == 'new' ? 'Neuf' : 'Occasion' }}</td>
                    <td>{{ product.status }}</td>
                    <td>{{ product.salesCount }}</td>
                    <td>{{ product.createdAt ? product.createdAt|date('d/m/Y') : '—' }}</td>
                    <td class="admin-actions">
                        <a href="#" class="admin-btn admin-btn--outline"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9" class="text-muted p-3">Aucun produit pour cette marque.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% if pages > 1 %}
        <div class="d-flex justify-content-between align-items-center mt-2">
            <a href="?page={{ max(1, page - 1) }}{{ currentStatus ? '&status=' ~ currentStatus : '' }}{{ currentTerm ? '&q=' ~ currentTerm : '' }}" class="admin-btn admin-btn--outline {{ page <= 1 ? 'disabled' : '' }}">‹ Précédent</a>
            <span class="text-muted">Page {{ page }} / {{ pages }}</span>
            <a href="?page={{ min(pages, page + 1) }}{{ currentStatus ? '&status=' ~ currentStatus : '' }}{{ currentTerm ? '&q=' ~ currentTerm : '' }}" class="admin-btn admin-btn--outline {{ page >= pages ? 'disabled' : '' }}">Suivant ›</a>
        </div>
    {% endif %}

    {# --- Lightbox zoom image --- #}
    <div id="imageZoomOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:1000;align-items:center;justify-content:center;cursor:zoom-out;">
        <img id="imageZoomFull" src="" style="max-width:90%;max-height:90%;border-radius:6px;">
    </div>

    <script>
        document.querySelectorAll('.admin-zoomable-thumb').forEach(function (img) {
            img.addEventListener('click', function () {
                const overlay = document.getElementById('imageZoomOverlay');
                const full = document.getElementById('imageZoomFull');
                full.src = img.src;
                overlay.style.display = 'flex';
            });
        });
        document.getElementById('imageZoomOverlay').addEventListener('click', function () {
            this.style.display = 'none';
        });
    </script>
{% endblock %}