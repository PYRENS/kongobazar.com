            ['bi-earbuds', 'écouteurs'], ['bi-speaker', 'enceinte'], ['bi-controller', 'jeux vidéo'], ['bi-printer', 'imprimante'],
            ['bi-router', 'routeur'], ['bi-wifi', 'wifi'], ['bi-bluetooth', 'bluetooth'], ['bi-hdd', 'disque dur'],
            ['bi-sd-card', 'carte mémoire'], ['bi-motherboard', 'carte mère'], ['bi-gpu-card', 'carte graphique'],
