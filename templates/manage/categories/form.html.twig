{% extends 'manage/base.html.twig' %}

{% block title %}{{ category ? 'Modifier' : 'Ajouter' }} — Catégorie{% endblock %}
{% block page_icon %}bi-tags{% endblock %}
{% block page_title %}{{ category ? 'Modifier' : 'Ajouter' }} une catégorie{% endblock %}

{% block body %}
    <div class="sw-card" style="max-width:560px;">
        <div class="card-header">
            <h6 class="mb-0 fw-bold">{{ category ? 'Modifier « ' ~ category.name ~ ' »' : 'Nouvelle catégorie' }}</h6>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" class="row g-3"
                  action="{{ category ? path('manage_categories_update', { id: category.id }) : path('manage_categories_create') }}">

                {% if not category %}
                    <div class="col-12">
                        <label class="acc-form-label">Catégorie parente (laisser vide pour créer un rayon racine)</label>
                        <div class="category-picker" data-category-picker>
                            <select data-category-level="1" class="acc-form-select">
                                <option value="">— Aucune (créer un rayon racine) —</option>
                                {% for root in rootCategories %}
                                    <option value="{{ root.id }}" {{ parent and parent.parent is null and parent.id == root.id ? 'selected' : '' }}>{{ root.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <input type="hidden" name="parent_id" data-category-final-value value="{{ parent ? parent.id : '' }}">
                        <small class="text-muted">Choisissez le niveau le plus profond auquel rattacher la nouvelle catégorie — par exemple, sélectionnez "Électronique" puis "Téléphones" pour ajouter une nouvelle sous-catégorie.</small>
                    </div>
                {% else %}
                    <div class="col-12">
                        <label class="acc-form-label">Catégorie parente</label>
                        <div class="category-picker" data-category-picker data-category-exclude="{{ category.id }}">
                            <select data-category-level="1" class="acc-form-select">
                                <option value="">— Aucune (rayon racine) —</option>
                                {% for root in rootCategories %}
                                    <option value="{{ root.id }}" {{ parent and parent.parent is null and parent.id == root.id ? 'selected' : '' }}>{{ root.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <input type="hidden" name="parent_id" data-category-final-value value="{{ parent ? parent.id : '' }}">
                        <small class="text-muted">Elle ne peut pas être rattachée à elle-même ni à l'une de ses sous-catégories.</small>
                    </div>
                {% endif %}

                <div class="col-md-8">
                    <label class="acc-form-label">Nom</label>
                    <input type="text" name="name" class="acc-form-input" value="{{ category ? category.name : '' }}" required>
                </div>

                <div class="col-md-4">
                    <label class="acc-form-label">Position (ordre)</label>
                    <input type="number" name="position" class="acc-form-input" value="{{ category ? category.position : 0 }}">
                </div>

                <div class="col-md-8">
                    <label class="acc-form-label">Icône (classe Bootstrap Icons, ex: bi-cpu)</label>
                    <div class="d-flex gap-2">
                        <input type="text" name="icon" id="iconInput" class="acc-form-input" value="{{ category ? category.icon : '' }}" placeholder="bi-tag" readonly style="cursor:pointer;">
                        <button type="button" class="btn btn-outline-secondary" id="openIconPicker" style="flex-shrink:0;">
                            <i class="bi {{ category and category.icon ? category.icon : 'bi-grid-3x3-gap' }}" id="iconPreviewGlyph"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="acc-form-label">Couleur de thème</label>
                    <input type="color" name="theme_color" class="form-control form-control-color" value="{{ category and category.themeColor ? category.themeColor : '#2FA8E0' }}">
                </div>

                <div class="col-12 form-check form-switch">
                    <input type="checkbox" name="requires_model" value="1" class="form-check-input" id="requiresModel"
                        {{ category and category.requiresModel ? 'checked' : '' }}>
                    <label class="form-check-label" for="requiresModel">Nécessite un modèle</label>
                    <small class="text-muted d-block">À activer pour les catégories où les produits se déclinent par modèle (ex: Smartphones, Ordinateurs) — permettra plus tard d'afficher un champ "Modèle" sur la fiche produit pour cette catégorie.</small>
                </div>

                <div class="col-12 form-check form-switch">
                    <input type="checkbox" name="authenticity_relevant" value="1" class="form-check-input" id="authenticityRelevant"
                        {{ category and category.authenticityRelevant ? 'checked' : '' }}>
                    <label class="form-check-label" for="authenticityRelevant">Authenticité pertinente</label>
                    <small class="text-muted d-block">À activer pour les catégories exposées à la contrefaçon (électronique, mode, montres/bijoux, parfums, pièces auto...). Permet au vendeur de déclarer si son produit est original ou une réplique — c'est une déclaration du vendeur, pas une certification KongoBazar.</small>
                </div>

                <div class="col-12">
                    <label class="acc-form-label">Image</label>
                    <div class="admin-file-upload-group">
                        <div class="admin-upload-thumb" id="newImagePreviewBox" style="display:none;">
                            <span class="admin-upload-thumb-label">Nouvelle</span>
                            <div class="admin-upload-thumb-inner">
                                <img src="" id="newImagePreview" alt="Nouvelle image">
                                <button type="button" class="admin-upload-remove" id="removeNewImage" aria-label="Retirer la nouvelle image">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>

                        <div class="admin-upload-thumb">
                            <span class="admin-upload-thumb-label">&nbsp;</span>
                            <label class="admin-upload-dropzone" for="imageInput">
                                <i class="bi bi-camera"></i>
                                <span>Upload</span>
                            </label>
                        </div>
                        <input type="file" name="image" id="imageInput" accept="image/*" class="admin-upload-input-hidden">

                        {% if category and category.imageName %}
                            <div class="admin-upload-thumb">
                                <span class="admin-upload-thumb-label">Ancienne</span>
                                <div class="admin-upload-thumb-inner">
                                    <img src="{{ vich_uploader_asset(category, 'imageFile') }}" alt="Image actuelle">
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-2"></i>Enregistrer</button>
                    <a href="{{ path('manage_categories_index', parent ? { parent: parent.id } : {}) }}" class="btn btn-outline-secondary ms-2">Annuler</a>
                </div>
            </form>
        </div>
    </div>

    <div class="custom-modal-overlay" id="iconPickerOverlay">
        <div class="custom-modal-box">
            <div class="custom-modal-header">
                <h6 class="mb-0 fw-bold">Choisir une icône</h6>
                <button type="button" class="btn-close" id="closeIconPicker" onclick="document.getElementById('iconPickerOverlay').classList.remove('active')"></button>
            </div>
            <div class="custom-modal-body">
                <input type="text" id="iconSearchInput" class="acc-form-input mb-3" placeholder="Rechercher une icône (ex: voiture, maison, panier...)">
                <div id="iconGrid" class="icon-picker-grid"></div>
            </div>
        </div>
    </div>
{% endblock %}
