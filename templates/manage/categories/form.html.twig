            ['bi-car-front', 'voiture'], ['bi-car-front-fill', 'voiture pleine'], ['bi-truck', 'camion'],
            ['bi-truck-front', 'camionnette'], ['bi-bicycle', 'vélo'], ['bi-scooter', 'moto scooter'], ['bi-moped', 'mobylette'],
            ['bi-bus-front', 'bus'], ['bi-taxi-front', 'taxi'], ['bi-fuel-pump', 'carburant'], ['bi-fuel-pump-diesel', 'diesel'],
            ['bi-airplane', 'avion voyage'], ['bi-train-front', 'train'], ['bi-ev-station', 'borne électrique'],
            ['bi-signpost-split', 'panneau route'], ['bi-cone-striped', 'cône chantier'],
            // Maison / immobilier
            ['bi-house', 'maison'], ['bi-house-door', 'porte maison'], ['bi-house-heart', 'maison coeur'],
            ['bi-building', 'immeuble'], ['bi-buildings', 'immeubles'], ['bi-shop', 'boutique'], ['bi-shop-window', 'vitrine'],
            ['bi-door-open', 'porte ouverte'], ['bi-window', 'fenêtre'], ['bi-stairs', 'escalier'], ['bi-lamp', 'lampe'],
            ['bi-thermometer-half', 'chauffage clim'], ['bi-fan', 'ventilateur'], ['bi-brightness-high', 'luminosité'],
            // Outils / bricolage
            ['bi-tools', 'outils'], ['bi-wrench', 'clé outil'], ['bi-wrench-adjustable', 'clé réglable'],
            ['bi-hammer', 'marteau'], ['bi-brush', 'peinture pinceau'], ['bi-lightbulb', 'ampoule lumière'],
            ['bi-plug', 'prise électrique'], ['bi-plug-fill', 'prise pleine'], ['bi-nut', 'écrou boulon'],
            ['bi-screwdriver', 'tournevis'], ['bi-ladder', 'échelle'], ['bi-paint-bucket', 'pot peinture'],
            // Alimentation
            ['bi-cup-hot', 'boisson chaude'], ['bi-cup-straw', 'boisson froide'], ['bi-egg-fried', 'nourriture'],
            ['bi-basket', 'panier courses'], ['bi-basket2', 'panier alternatif'], ['bi-cart', 'panier achat'],
            ['bi-cart-fill', 'panier plein'], ['bi-cart-plus', 'ajouter panier'], ['bi-bag', 'sac'], ['bi-bag-fill', 'sac plein'],
            ['bi-bag-heart', 'sac coeur'], ['bi-apple', 'fruit'], ['bi-cake2', 'gâteau'], ['bi-cup', 'tasse'],
            // Mode / accessoires
            ['bi-gift', 'cadeau'], ['bi-shirt', 'vêtement'], ['bi-badge-tm', 'marque étiquette'], ['bi-tag', 'étiquette prix'],
            ['bi-tags', 'étiquettes'], ['bi-gem', 'bijou'], ['bi-watch', 'montre'], ['bi-sunglasses', 'lunettes'],
            ['bi-bag-check', 'sac vérifié'], ['bi-handbag', 'sac à main'],
            // Santé
            ['bi-heart-pulse', 'santé'], ['bi-capsule', 'médicament'], ['bi-thermometer', 'thermomètre'],
            ['bi-bandaid', 'pansement'], ['bi-eyedropper', 'pipette'], ['bi-clipboard-pulse', 'suivi médical'],
            // Nature
            ['bi-flower1', 'fleur'], ['bi-flower2', 'fleur alternative'], ['bi-tree', 'arbre'], ['bi-tree-fill', 'arbre plein'],
            ['bi-sun', 'soleil'], ['bi-moon', 'lune'], ['bi-moon-stars', 'nuit étoilée'], ['bi-cloud', 'nuage'],
            ['bi-cloud-rain', 'pluie'], ['bi-droplet', 'goutte eau'], ['bi-fire', 'feu'], ['bi-snow', 'neige'],
            ['bi-wind', 'vent'], ['bi-water', 'eau'],
            // Loisirs / culture
            ['bi-book', 'livre'], ['bi-book-half', 'livre ouvert'], ['bi-journal', 'carnet'], ['bi-pencil', 'crayon'],
            ['bi-palette', 'palette peinture'], ['bi-brush-fill', 'brosse'], ['bi-music-note-beamed', 'musique'],
            ['bi-vinyl', 'vinyle disque'], ['bi-film', 'film'], ['bi-camera-reels', 'vidéo caméra'],
            ['bi-dice-5', 'jeu de dés'], ['bi-puzzle', 'puzzle'], ['bi-joystick', 'manette jeu'], ['bi-guitar', 'guitare'],
            ['bi-piano', 'piano'], ['bi-easel', 'chevalet art'],
            // Sport
            ['bi-dumbbell', 'sport musculation'], ['bi-trophy', 'trophée'], ['bi-bullseye', 'cible'],
            ['bi-basket3', 'basketball'], ['bi-bicycle', 'cyclisme'],
            // Voyage
            ['bi-globe', 'monde global'], ['bi-globe2', 'globe alternatif'], ['bi-map', 'carte plan'],
            ['bi-geo-alt', 'localisation'], ['bi-compass', 'boussole'], ['bi-suitcase', 'valise'],
            ['bi-suitcase2', 'valise alternative'], ['bi-umbrella', 'parapluie'], ['bi-binoculars', 'jumelles'],
            // Récompenses / symboles
            ['bi-heart', 'coeur'], ['bi-star', 'étoile'], ['bi-award', 'récompense'], ['bi-flag', 'drapeau'],
            ['bi-flag-fill', 'drapeau plein'], ['bi-patch-check', 'vérifié badge'],
            // Finance
            ['bi-piggy-bank', 'épargne'], ['bi-cash-coin', 'argent'], ['bi-cash-stack', 'liasse argent'],
            ['bi-credit-card', 'carte bancaire'], ['bi-credit-card-2-front', 'carte bancaire alternative'],
            ['bi-wallet2', 'portefeuille'], ['bi-briefcase', 'travail bureau'], ['bi-calculator', 'calculatrice'],
            ['bi-graph-up', 'graphique'], ['bi-graph-up-arrow', 'graphique hausse'], ['bi-bank', 'banque'],
            ['bi-currency-exchange', 'change devise'], ['bi-receipt', 'reçu facture'],
            // Bureau / communication
            ['bi-clipboard', 'presse-papier'], ['bi-envelope', 'enveloppe courrier'], ['bi-telephone', 'appel téléphone'],
            ['bi-chat', 'discussion message'], ['bi-chat-dots', 'messages'], ['bi-people', 'personnes groupe'],
            ['bi-person', 'personne'], ['bi-person-badge', 'badge identité'], ['bi-folder', 'dossier'],
            ['bi-file-earmark-text', 'document'], ['bi-inbox', 'boîte réception'],
            // Divers utiles marketplace
            ['bi-scissors', 'ciseaux'], ['bi-droplet-half', 'produit liquide'], ['bi-box-seam', 'boîte colis'],
            ['bi-box', 'boîte'], ['bi-boxes', 'boîtes stock'], ['bi-recycle', 'recyclage'],
            ['bi-lightning-charge', 'énergie éclair'], ['bi-battery-full', 'batterie'], ['bi-usb-plug', 'usb'],
            ['bi-camera-video', 'caméra vidéo'], ['bi-mic', 'micro'], ['bi-key', 'clé'], ['bi-shield-check', 'sécurité bouclier'],
            ['bi-lock', 'cadenas'], ['bi-unlock', 'déverrouillé'], ['bi-calendar-range', 'calendrier période'],
            ['bi-alarm', 'alarme réveil'], ['bi-collection', 'collection'], ['bi-stars', 'étincelles'],
            ['bi-baby-carriage', 'poussette bébé'], ['bi-controller', 'jouets jeux'], ['bi-emoji-smile', 'jouet enfant'],
            ['bi-pc', 'informatique'], ['bi-diamond', 'luxe diamant'], ['bi-tools', 'services techniques'],
            ['bi-truck-flatbed', 'transport marchandise'], ['bi-boombox', 'audio ancien'], ['bi-camera2', 'photographie'],
        ];

        const iconInput = document.getElementById('iconInput');
        const iconPreviewGlyph = document.getElementById('iconPreviewGlyph');
        const openIconPicker = document.getElementById('openIconPicker');
        const iconGrid = document.getElementById('iconGrid');
        const iconSearchInput = document.getElementById('iconSearchInput');
        const iconOverlay = document.getElementById('iconPickerOverlay');
        const closeIconPicker = document.getElementById('closeIconPicker');

        // Déplace la fenêtre pour qu'elle soit un enfant direct de <body> —
        // ça la sort de force de n'importe quel conteneur parent qui casserait
        // son positionnement (transform, filter, contexte d'empilement, etc.).
        document.body.appendChild(iconOverlay);

        function renderIconGrid(filter) {
            const term = (filter || '').toLowerCase();
            iconGrid.innerHTML = '';
            ICON_CHOICES
                .filter(([cls, kw]) => !term || cls.includes(term) || kw.includes(term))
                .forEach(([cls, kw]) => {
                    const item = document.createElement('div');
                    item.className = 'icon-picker-item';
                    item.innerHTML = `<i class="bi ${cls}"></i><span>${kw}</span>`;
                    item.addEventListener('click', () => {
                        iconInput.value = cls;
                        iconPreviewGlyph.className = 'bi ' + cls;
                        iconOverlay.classList.remove('active');
                    });
                    iconGrid.appendChild(item);
                });
        }

        function openOverlay() {
            renderIconGrid('');
            iconSearchInput.value = '';
            iconOverlay.classList.add('active');
            setTimeout(() => iconSearchInput.focus(), 50);
        }
        function closeOverlay() {
            iconOverlay.classList.remove('active');
        }

        openIconPicker.addEventListener('click', openOverlay);
        iconOverlay.addEventListener('click', (e) => {
            if (e.target === iconOverlay || e.target.closest('#closeIconPicker')) closeOverlay();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeOverlay();
        });
        iconSearchInput.addEventListener('input', () => renderIconGrid(iconSearchInput.value));

        const imageInput = document.getElementById('imageInput');
        const previewBox = document.getElementById('newImagePreviewBox');
        const preview = document.getElementById('newImagePreview');
        const removeBtn = document.getElementById('removeNewImage');

        imageInput.addEventListener('change', function (e) {
            const file = e.target.files[0];

            if (!file) {
                previewBox.style.display = 'none';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (ev) {
                preview.src = ev.target.result;
                previewBox.style.display = 'flex';
            };
            reader.readAsDataURL(file);
        });

        removeBtn.addEventListener('click', function () {
            imageInput.value = '';
            preview.src = '';
            previewBox.style.display = 'none';
        });
    </script>
{% endblock %}