{% extends 'manage/base.html.twig' %}

{% block title %}{{ category ? 'Modifier' : 'Ajouter' }} — Catégorie{% endblock %}
{% block page_icon %}bi-tags{% endblock %}
{% block page_title %}{{ category ? 'Modifier' : 'Ajouter' }} une catégorie{% endblock %}

{% block body %}
    <div class="admin-card" style="max-width:500px;">
        <form method="post" enctype="multipart/form-data"
              action="{{ category ? path('manage_categories_update', { id: category.id }) : path('manage_categories_create') }}">

            {% if not category %}
                <div class="mb-3">
                    <label class="form-label">Catégorie parente (laisser vide pour créer un rayon racine)</label>
                    <div class="category-picker" data-category-picker>
                        <select data-category-level="1">
                            <option value="">— Aucune (créer un rayon racine) —</option>
                            {% for root in rootCategories %}
                                <option value="{{ root.id }}" {{ parent and parent.parent is null and parent.id == root.id ? 'selected' : '' }}>{{ root.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <input type="hidden" name="parent_id" data-category-final-value value="{{ parent ? parent.id : '' }}">
                    <small class="text-muted">Choisissez le niveau le plus profond auquel rattacher la nouvelle catégorie — par exemple, sélectionnez "Électronique" puis "Téléphones" pour ajouter une nouvelle sous-catégorie.</small>
                </div>
            {% else %}
                <div class="mb-3">
                    <label class="form-label">Catégorie parente</label>
                    <div class="category-picker" data-category-picker data-category-exclude="{{ category.id }}">
                        <select data-category-level="1">
                            <option value="">— Aucune (rayon racine) —</option>
                            {% for root in rootCategories %}
                                <option value="{{ root.id }}" {{ parent and parent.parent is null and parent.id == root.id ? 'selected' : '' }}>{{ root.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <input type="hidden" name="parent_id" data-category-final-value value="{{ parent ? parent.id : '' }}">
                    <small class="text-muted">Elle ne peut pas être rattachée à elle-même ni à l'une de ses sous-catégories.</small>
                </div>
            {% endif %}

            <div class="mb-3">
                <label class="form-label">Nom</label>
                <input type="text" name="name" class="form-control" value="{{ category ? category.name : '' }}" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Icône (classe Bootstrap Icons, ex: bi-cpu)</label>
                <input type="text" name="icon" class="form-control" value="{{ category ? category.icon : '' }}" placeholder="bi-tag">
            </div>

            <div class="mb-3">
                <label class="form-label">Couleur de thème</label>
                <input type="color" name="theme_color" class="form-control form-control-color" value="{{ category and category.themeColor ? category.themeColor : '#2FA8E0' }}">
            </div>

            <div class="mb-3">
                <label class="form-label">Position (ordre d'affichage)</label>
                <input type="number" name="position" class="form-control" value="{{ category ? category.position : 0 }}">
            </div>

            <div class="mb-3">
                <label class="form-label">Image</label>
                <div class="admin-file-upload-group">
                    <div class="admin-upload-thumb" id="newImagePreviewBox" style="display:none;">
                        {% if category and category.imageName %}<span class="admin-upload-thumb-label">Nouvelle</span>{% endif %}
                        <div class="admin-upload-thumb-inner">
                            <img src="" id="newImagePreview" alt="Nouvelle image">
                            <button type="button" class="admin-upload-remove" id="removeNewImage" aria-label="Retirer la nouvelle image">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>

                    <div class="admin-upload-thumb">
                        <span class="admin-upload-thumb-label">&nbsp;</span>
                        <label class="admin-upload-dropzone" for="imageInput">
                            <i class="bi bi-camera"></i>
                            <span>Upload</span>
                        </label>
                    </div>
                    <input type="file" name="image" id="imageInput" accept="image/*" class="admin-upload-input-hidden">

                    {% if category and category.imageName %}
                        <div class="admin-upload-thumb">
                            <span class="admin-upload-thumb-label">Ancienne</span>
                            <div class="admin-upload-thumb-inner">
                                <img src="{{ vich_uploader_asset(category, 'imageFile') }}" alt="Image actuelle">
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <button type="submit" class="admin-btn admin-btn--primary">Enregistrer</button>
            <a href="{{ path('manage_categories_index', parent ? { parent: parent.id } : {}) }}" class="admin-btn admin-btn--outline">Annuler</a>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const imageInput = document.getElementById('imageInput');
        const previewBox = document.getElementById('newImagePreviewBox');
        const preview = document.getElementById('newImagePreview');
        const removeBtn = document.getElementById('removeNewImage');

        imageInput.addEventListener('change', function (e) {
            const file = e.target.files[0];

            if (!file) {
                previewBox.style.display = 'none';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (ev) {
                preview.src = ev.target.result;
                previewBox.style.display = 'flex';
            };
            reader.readAsDataURL(file);
        });

        removeBtn.addEventListener('click', function () {
            imageInput.value = '';
            preview.src = '';
            previewBox.style.display = 'none';
        });
    </script>
{% endblock %}