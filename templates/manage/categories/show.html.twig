{% extends 'manage/base.html.twig' %}

{% block title %}{{ category.name }} — Catégorie{% endblock %}
{% block page_icon %}bi-tags{% endblock %}
{% block page_title %}{{ category.name }}{% endblock %}

{% block body %}
    <div class="admin-card">
        <div class="admin-info-illustration-row">
            <div class="admin-info-col">
                <h6><i class="bi bi-info-circle"></i> Informations de la catégorie</h6>
                <table class="admin-table" style="box-shadow:none;margin-bottom:16px;">
                    <tr><td><strong>Nom</strong></td><td>{{ category.name }}</td></tr>
                    <tr><td><strong>Icône</strong></td><td><i class="bi {{ category.icon|default('bi-tag') }}"></i> {{ category.icon|default('—') }}</td></tr>
                    <tr>
                        <td><strong>Couleur</strong></td>
                        <td>
                            {% if category.themeColor %}
                                <span style="display:inline-block;width:16px;height:16px;border-radius:3px;background:{{ category.themeColor }};border:1px solid #ddd;vertical-align:middle;margin-right:6px;"></span>{{ category.themeColor }}
                            {% else %}—{% endif %}
                        </td>
                    </tr>
                    <tr><td><strong>Position</strong></td><td>{{ category.position }}</td></tr>
                    <tr><td><strong>Rattachée à</strong></td><td>{{ category.parent ? category.parent.name : 'Aucune (rayon racine)' }}</td></tr>
                    <tr><td><strong>Produits (avec sous-catégories)</strong></td><td>{{ productCount }}</td></tr>
                    <tr>
                        <td><strong>Statut</strong></td>
                        <td><span class="admin-badge admin-badge--{{ category.active ? 'active' : 'disabled' }}">{{ category.active ? 'Active' : 'Désactivée' }}</span></td>
                    </tr>
                </table>

                <div class="admin-actions">
                    <a href="{{ path('manage_categories_index', category.parent ? { parent: category.parent.id } : {}) }}" class="admin-btn admin-btn--outline">← Retour</a>
                    <a href="{{ path('manage_categories_edit', { id: category.id }) }}" class="admin-btn admin-btn--outline"><i class="bi bi-pencil"></i> Modifier</a>
                    <a href="{{ path('manage_category_attributes_index', { categoryId: category.id }) }}" class="admin-btn admin-btn--outline"><i class="bi bi-sliders"></i> Caractéristiques</a>
                    <form action="{{ path('manage_categories_toggle', { id: category.id }) }}" method="post">
                        <button type="submit" class="admin-btn admin-btn--outline">
                            <i class="bi {{ category.active ? 'bi-pause-circle' : 'bi-check-circle' }}"></i>
                            {{ category.active ? 'Désactiver' : 'Activer' }}
                        </button>
                    </form>
                </div>
            </div>

            <div class="admin-illustration-col">
                <span class="admin-illustration-label">Illustration</span>
                {% if category.imageName %}
                    <img src="{{ vich_uploader_asset(category, 'imageFile') }}" class="admin-illustration-preview">
                {% else %}
                    <div class="admin-illustration-empty">
                        <i class="bi bi-image"></i>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="admin-card">
        <h6><i class="bi bi-diagram-3"></i> Sous-catégories</h6>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2" style="margin-bottom:12px;">
            <a href="{{ path('manage_categories_new', { parent: category.id }) }}" class="admin-btn admin-btn--primary">
                <i class="bi bi-plus-lg"></i> Ajouter sous {{ category.name }}
            </a>

            <form method="get" class="d-flex align-items-center gap-2">
                <input type="text" name="q" class="form-control" style="max-width: 280px;" placeholder="Rechercher une sous-catégorie..." value="{{ searchTerm }}">
                <button type="submit" class="admin-btn admin-btn--outline"><i class="bi bi-search"></i></button>
                {% if searchTerm %}
                    <a href="{{ path('manage_categories_show', { id: category.id }) }}" class="admin-btn admin-btn--outline">Réinitialiser</a>
                {% endif %}
            </form>
        </div>

    {% macro sortLink(field, label, currentSort, currentDir) %}
        {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
        <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
            {{ label }}
            {% if currentSort == field %}
                <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
            {% else %}
                <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
            {% endif %}
        </a>
    {% endmacro %}
        {% import _self as self %}

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Icône</th>
                    <th>{{ self.sortLink('name', 'Nom', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('childrenCount', 'Sous-catégories', currentSort, currentDir) }}</th>
                    <th>{{ self.sortLink('productCount', 'Produits', currentSort, currentDir) }}</th>
                    <th>Couleur</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for row in childRows %}
                    {% set child = row.category %}
                    <tr>
                        <td>
                            {% if child.imageName %}
                                <img src="{{ vich_uploader_asset(child, 'imageFile') }}" style="width:40px;height:40px;border-radius:4px;object-fit:cover;">
                            {% else %}
                                <span class="text-muted">N/A</span>
                            {% endif %}
                        </td>
                        <td><i class="bi {{ child.icon|default('bi-tag') }}" style="font-size:18px;"></i></td>
                        <td><a href="{{ path('manage_categories_show', { id: child.id }) }}">{{ child.name }}</a></td>
                        <td>
                            {% if row.childrenCount > 0 %}
                                <a href="{{ path('manage_categories_index', { parent: child.id }) }}">{{ row.childrenCount }} <i class="bi bi-box-arrow-in-right"></i></a>
                            {% else %}<span class="text-muted">0</span>{% endif %}
                        </td>
                        <td>
                            {% if row.productCount > 0 %}
                                <a href="{{ path('manage_categories_products', { id: child.id }) }}">{{ row.productCount }}</a>
                            {% else %}0{% endif %}
                        </td>
                        <td>
                            {% if child.themeColor %}
                                <span style="display:inline-block;width:20px;height:20px;border-radius:4px;background:{{ child.themeColor }};border:1px solid #ddd;vertical-align:middle;"></span>
                            {% else %}<span class="text-muted">—</span>{% endif %}
                        </td>
                        <td class="admin-actions">
                            <a href="{{ path('manage_categories_show', { id: child.id }) }}" class="admin-btn admin-btn--outline"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('manage_categories_edit', { id: child.id }) }}" class="admin-btn admin-btn--outline"><i class="bi bi-pencil"></i></a>
                            <form action="{{ path('manage_categories_delete', { id: child.id }) }}" method="post" onsubmit="return confirm('Supprimer {{ child.name }} et toutes ses sous-catégories ?');">
                                <button type="submit" class="admin-btn admin-btn--outline"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-muted">Aucune sous-catégorie.</td></tr>
                {% endfor %}
            </tbody>
        </table>

        {% include 'manage/_partials/_pagination_links.html.twig' with {currentPage: childPage, totalPages: childPages, paramName: 'cpage'} %}
    </div>

    <div class="admin-card mt-3">
        <h6><i class="bi bi-box-seam"></i> Produits de cette catégorie ({{ productTotal }})</h6>

        <form method="get" class="mb-3 d-flex align-items-center gap-2 flex-wrap">
            <input type="text" name="pq" class="form-control" style="max-width: 220px;" placeholder="Titre ou référence..." value="{{ productTerm }}">
            <select name="pstatus" class="form-select" style="max-width: 160px;">
                <option value="">— Tous statuts —</option>
                <option value="active" {{ productStatus == 'active' ? 'selected' : '' }}>Actif</option>
                <option value="draft" {{ productStatus == 'draft' ? 'selected' : '' }}>Brouillon</option>
                <option value="sold" {{ productStatus == 'sold' ? 'selected' : '' }}>Vendu</option>
                <option value="suspended" {{ productStatus == 'suspended' ? 'selected' : '' }}>Suspendu</option>
            </select>
            <select name="pcondition" class="form-select" style="max-width: 150px;">
                <option value="">— Neuf/Occasion —</option>
                <option value="new" {{ productCondition == 'new' ? 'selected' : '' }}>Neuf</option>
                <option value="used" {{ productCondition == 'used' ? 'selected' : '' }}>Occasion</option>
            </select>
            <button type="submit" class="admin-btn admin-btn--outline"><i class="bi bi-search"></i></button>
            <a href="{{ path('manage_products_index', {category: category.id}) }}" class="btn btn-sm btn-outline-secondary ms-auto">Voir tout dans Produits →</a>
        </form>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Référence</th>
                    <th>Vendeur</th>
                    <th>Prix</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.title }}</td>
                        <td>{{ product.reference ?: '—' }}</td>
                        <td>{{ product.sellerProfile ? product.sellerProfile.user.email : '—' }}</td>
                        <td>{{ product.basePrice }} {{ product.currency }}</td>
                        <td>{{ product.status }}</td>
                        <td class="admin-actions">
                            <a href="{{ path('manage_products_edit', {id: product.id}) }}" class="admin-btn admin-btn--outline"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('manage_products_edit', {id: product.id}) }}" class="admin-btn admin-btn--outline"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-muted">Aucun produit.</td></tr>
                {% endfor %}
            </tbody>
        </table>

        {% include 'manage/_partials/_pagination_links.html.twig' with {currentPage: productPage, totalPages: productPages, paramName: 'ppage'} %}
    </div>
{% endblock %}