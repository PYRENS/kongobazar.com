{% if sourceAttributes|length == 0 %}
    <p class="text-muted">Aucune caractéristique sur "{{ source.name }}".</p>
{% else %}
    {% for attr in sourceAttributes %}
        <div class="form-check">
            <input type="checkbox" name="attribute_ids[]" value="{{ attr.id }}" class="form-check-input" id="attr{{ attr.id }}" checked>
            <label class="form-check-label" for="attr{{ attr.id }}">
                {{ attr.name }} <span class="text-muted">({{ attr.dataType }}{{ attr.dataType == 'select' ? ', ' ~ attr.options|length ~ ' options' : '' }})</span>
            </label>
        </div>
    {% endfor %}
{% endif %}