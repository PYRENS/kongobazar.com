{% extends 'manage/base.html.twig' %}

{% block title %}{{ attribute ? 'Modifier' : 'Nouvelle' }} caractéristique{% endblock %}
{% block page_icon %}bi-sliders{% endblock %}
{% block page_title %}{{ attribute ? 'Modifier' : 'Nouvelle' }} caractéristique — {{ category.name }}{% endblock %}

{% block body %}
    <form method="post" action="{{ attribute ? path('manage_category_attributes_update', {id: attribute.id}) : path('manage_category_attributes_create', {categoryId: category.id}) }}">
        <div class="mb-3">
            <label class="form-label">Nom</label>
            <input type="text" name="name" class="form-control" value="{{ attribute ? attribute.name : '' }}" required>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Type</label>
                <select name="data_type" id="dataTypeSelect" class="form-select">
                    <option value="text" {{ attribute and attribute.dataType == 'text' ? 'selected' : '' }}>Texte</option>
                    <option value="number" {{ attribute and attribute.dataType == 'number' ? 'selected' : '' }}>Nombre</option>
                    <option value="select" {{ attribute and attribute.dataType == 'select' ? 'selected' : '' }}>Liste (select)</option>
                    <option value="boolean" {{ attribute and attribute.dataType == 'boolean' ? 'selected' : '' }}>Oui/Non</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Unité (optionnel, pour Nombre)</label>
                <input type="text" name="unit" class="form-control" value="{{ attribute ? attribute.unit : '' }}" placeholder="ex: cm, kg, m²">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Position</label>
                <input type="number" name="position" class="form-control" value="{{ attribute ? attribute.position : 0 }}">
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Étiquette de regroupement (optionnel)</label>
            <input type="text" name="group_tag" class="form-control" value="{{ attribute ? attribute.groupTag : '' }}" placeholder="ex: auto">
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" name="nullable" value="1" class="form-check-input" id="nullable" {{ attribute is null or attribute.nullable ? 'checked' : '' }}>
            <label class="form-check-label" for="nullable">Peut rester vide (non obligatoire)</label>
        </div>
        <div class="mb-3 form-check">
            <input type="checkbox" name="filterable" value="1" class="form-check-input" id="filterable" {{ attribute and attribute.filterable ? 'checked' : '' }}>
            <label class="form-check-label" for="filterable">Utilisable comme filtre de recherche</label>
        </div>
        <div class="mb-3 form-check">
            <input type="checkbox" name="show_on_card" value="1" class="form-check-input" id="showOnCard" {{ attribute and attribute.showOnCard ? 'checked' : '' }}>
            <label class="form-check-label" for="showOnCard">Afficher en badge sur la carte produit</label>
        </div>

        <div id="optionsBlock" style="{{ attribute and attribute.dataType == 'select' ? '' : 'display:none;' }}">
            <label class="form-label d-block">Options</label>
            <div id="optionsList">
                {% if attribute %}
                    {% for option in attribute.options %}
                        <div class="input-group mb-2 option-row">
                            <input type="hidden" name="option_id[]" value="{{ option.id }}">
                            <input type="text" name="option_label[]" class="form-control" value="{{ option.label }}">
                            <input type="color" name="option_color[]" class="form-control form-control-color" value="{{ option.colorHex ?: '#ffffff' }}" title="Couleur (optionnel)">
                            <button type="button" class="btn btn-outline-danger remove-option-btn"><i class="bi bi-x"></i></button>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
            <button type="button" id="addOptionBtn" class="btn btn-sm btn-outline-secondary">+ Ajouter une option</button>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Enregistrer</button>
            <a href="{{ path('manage_category_attributes_index', {categoryId: category.id}) }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>

    <script>
        document.getElementById('dataTypeSelect').addEventListener('change', function () {
            document.getElementById('optionsBlock').style.display = this.value === 'select' ? 'block' : 'none';
        });

        document.getElementById('addOptionBtn').addEventListener('click', function () {
            const row = document.createElement('div');
            row.className = 'input-group mb-2 option-row';
            row.innerHTML = '<input type="hidden" name="option_id[]" value="0">' +
                '<input type="text" name="option_label[]" class="form-control">' +
                '<input type="color" name="option_color[]" class="form-control form-control-color" value="#ffffff" title="Couleur (optionnel)">' +
                '<button type="button" class="btn btn-outline-danger remove-option-btn"><i class="bi bi-x"></i></button>';
            document.getElementById('optionsList').appendChild(row);
            row.querySelector('.remove-option-btn').addEventListener('click', () => row.remove());
        });

        document.querySelectorAll('.remove-option-btn').forEach((btn) => {
            btn.addEventListener('click', function () {
                this.closest('.option-row').remove();
            });
        });
    </script>
{% endblock %}