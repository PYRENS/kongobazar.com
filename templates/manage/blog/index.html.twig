{% extends 'manage/base.html.twig' %}
{% block title %}Blog{% endblock %}
{% block page_icon %}bi-journal-text{% endblock %}
{% block page_title %}Gestion du blog{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <form method="get" class="d-flex gap-2 flex-wrap">
            <input type="text" name="q" class="form-control form-control-sm" style="max-width:240px;" placeholder="Rechercher un titre..." value="{{ searchTerm }}">
            <select name="status" class="form-select form-select-sm" style="max-width:180px;">
                <option value="">— Tous statuts —</option>
                <option value="draft" {{ currentStatus == 'draft' ? 'selected' : '' }}>Brouillon</option>
                <option value="published" {{ currentStatus == 'published' ? 'selected' : '' }}>Publié</option>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i> Filtrer</button>
        </form>
        <a href="{{ path('manage_blog_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouvel article</a>
    </div>

    <div class="sw-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Couverture</th>
                        <th>Titre</th>
                        <th>Statut</th>
                        <th>Publié le</th>
                        <th>Créé le</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in posts %}
                        <tr>
                            <td>
                                {% if post.coverImageName %}
                                    <img src="{{ vich_uploader_asset(post, 'coverImageFile') }}" style="width:70px;height:50px;object-fit:cover;border-radius:4px;" alt="">
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>{{ post.title }}</td>
                            <td>
                                {% if post.status == 'published' %}
                                    <span class="badge bg-success">Publié</span>
                                {% else %}
                                    <span class="badge bg-secondary">Brouillon</span>
                                {% endif %}
                            </td>
                            <td>{{ post.publishedAt ? post.publishedAt|date('d/m/Y') : '—' }}</td>
                            <td>{{ post.createdAt ? post.createdAt|date('d/m/Y') : '—' }}</td>
                            <td class="text-end">
                                <a href="{{ path('manage_blog_edit', { id: post.id }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                <form method="post" action="{{ path('manage_blog_remove', { id: post.id }) }}" style="display:inline;" onsubmit="return confirm('Supprimer cet article ?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">Aucun article.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if pages > 1 %}
        <nav class="mt-3">
            <ul class="pagination pagination-sm">
                {% for p in 1..pages %}
                    <li class="page-item {{ p == page ? 'active' : '' }}">
                        <a class="page-link" href="?page={{ p }}&q={{ searchTerm }}&status={{ currentStatus }}">{{ p }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
