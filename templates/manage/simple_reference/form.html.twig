{% extends 'manage/base.html.twig' %}

{% block body %}
    <h1 class="h4 mb-3">{{ item ? 'Modifier' : 'Ajouter' }} — {{ label }}</h1>

    <form method="post" action="{{ item ? path('manage_reference_update', {type: type, id: item.id}) : path('manage_reference_new', {type: type}) }}">
        <div class="mb-3">
            <label class="form-label">Nom</label>
            <input type="text" name="name" class="form-control" value="{{ item ? item.name : '' }}" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Position (ordre d'affichage)</label>
            <input type="number" name="position" class="form-control" value="{{ item ? item.position : 0 }}">
        </div>

        <button type="submit" class="btn btn-success">Enregistrer</button>
        <a href="{{ path('manage_reference_index', {type: type}) }}" class="btn btn-outline-secondary">Annuler</a>
    </form>
{% endblock %}