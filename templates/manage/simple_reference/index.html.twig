{% extends 'manage/base.html.twig' %}

{% block title %}{{ label }}{% endblock %}
{% block page_icon %}{{ icon }}{% endblock %}
{% block page_title %}{{ label }}{% endblock %}

{% macro sortLink(field, labelText, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ labelText }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi {{ icon }}"></i></div>
                <div class="ctb-stat-val">{{ stats.total }}</div>
                <div class="ctb-stat-label">{{ label }} au total</div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-green h-100">
                <div class="ctb-stat-icon ctb-stat-icon-green"><i class="bi bi-check-circle-fill"></i></div>
                <div class="ctb-stat-val">{{ stats.used }}</div>
                <div class="ctb-stat-label">Utilisés par au moins {{ usageLabel }}</div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-list-ul"></i></div>
                <div class="ctb-stat-val">{{ stats.filtered }}</div>
                <div class="ctb-stat-label">Résultats filtrés</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="sw-card">
                <div class="card-body py-3">
                    <form method="get" class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="ctb-search-wrap">
                            <i class="bi bi-search ctb-search-icon"></i>
                            <input type="text" name="q" id="refSearchInput" class="ctb-search-input" style="width:260px;" placeholder="Rechercher..." value="{{ searchTerm }}" autocomplete="off">
                            <div class="header-search-results" id="refSuggestions"></div>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <select name="perPage" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                                {% for n in [10, 20, 50, 100] %}
                                    <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Rechercher</button>
                            {% if searchTerm %}<a href="{{ path('manage_reference_index', {type: type}) }}" class="btn btn-outline-secondary btn-sm">Réinitialiser</a>{% endif %}
                            <a href="{{ path('manage_reference_new', {type: type}) }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Ajouter</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="sw-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table ctb-table mb-0">
                    <thead>
                        <tr>
                            <th>{{ self.sortLink('name', 'Nom', currentSort, currentDir) }}</th>
                            <th>{{ self.sortLink('position', 'Position', currentSort, currentDir) }}</th>
                            <th>{{ self.sortLink('usageCount', 'Utilisé par', currentSort, currentDir) }}</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set item = row.item %}
                            <tr>
                                <td class="ctb-contact-name">{{ item.name }}</td>
                                <td>{{ item.position }}</td>
                                <td>{{ row.usageCount }} {{ usageLabel }}</td>
                                <td>
                                    <div class="ctb-act-row">
                                        <a href="{{ path('manage_reference_edit', {type: type, id: item.id}) }}" class="ctb-act-btn" title="Modifier"><i class="bi bi-pencil"></i></a>
                                        <form action="{{ path('manage_reference_delete', {type: type, id: item.id}) }}" method="post" onsubmit="return confirm('Supprimer cet élément ?');">
                                            <button type="submit" class="ctb-act-btn ctb-act-danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-muted text-center py-4">Aucun élément pour l'instant.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="ctb-table-footer">
                <span class="ctb-footer-info">{{ total }} élément{{ total != 1 ? 's' : '' }} au total — page {{ page }} / {{ pages }}</span>
                {% if pages > 1 %}
                    <div class="ctb-pagination">
                        <a href="{{ path('manage_reference_index', {type: type}|merge(app.request.query.all|merge({page: max(1, page - 1)}))) }}" class="ctb-page-btn {{ page <= 1 ? 'disabled' : '' }}"><i class="bi bi-chevron-left"></i></a>
                        {% for p in max(1, page - 2)..min(pages, page + 2) %}
                            <a href="{{ path('manage_reference_index', {type: type}|merge(app.request.query.all|merge({page: p}))) }}" class="ctb-page-btn {{ p == page ? 'ctb-page-active' : '' }}">{{ p }}</a>
                        {% endfor %}
                        <a href="{{ path('manage_reference_index', {type: type}|merge(app.request.query.all|merge({page: min(pages, page + 1)}))) }}" class="ctb-page-btn {{ page >= pages ? 'disabled' : '' }}"><i class="bi bi-chevron-right"></i></a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const allRefNames = {{ allNames|json_encode|raw }};
        const refSearchInput = document.getElementById('refSearchInput');
        const refSuggestions = document.getElementById('refSuggestions');

        function renderRefSuggestions(term) {
            refSuggestions.innerHTML = '';
            if (!term) { refSuggestions.classList.remove('active'); return; }
            const matches = allRefNames.filter((n) => n.toLowerCase().includes(term.toLowerCase())).slice(0, 8);
            if (matches.length === 0) { refSuggestions.classList.remove('active'); return; }
            matches.forEach((name) => {
                const item = document.createElement('div');
                item.className = 'header-search-result-item';
                item.innerHTML = '<i class="bi {{ icon }}"></i><span>' + name + '</span>';
                item.addEventListener('click', () => {
                    refSearchInput.value = name;
                    refSuggestions.classList.remove('active');
                    refSearchInput.closest('form').submit();
                });
                refSuggestions.appendChild(item);
            });
            refSuggestions.classList.add('active');
        }

        refSearchInput.addEventListener('input', () => renderRefSuggestions(refSearchInput.value.trim()));
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.ctb-search-wrap')) refSuggestions.classList.remove('active');
        });
    </script>
{% endblock %}