{% extends 'manage/base.html.twig' %}

{% block title %}{{ label }}{% endblock %}
{% block page_icon %}{{ icon }}{% endblock %}
{% block page_title %}{{ label }}{% endblock %}

{% macro sortLink(field, labelText, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ labelText }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">{{ label }}</h1>
        <a href="{{ path('manage_reference_new', {type: type}) }}" class="btn btn-primary btn-sm">+ Ajouter</a>
    </div>

    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <input type="text" name="q" class="form-control" style="max-width: 300px;" placeholder="Rechercher..." value="{{ searchTerm }}">
        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
        {% if searchTerm %}
            <a href="{{ path('manage_reference_index', {type: type}) }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        {% endif %}
    </form>

    <table class="table admin-table">
        <thead>
            <tr>
                <th>{{ self.sortLink('name', 'Nom', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('position', 'Position', currentSort, currentDir) }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item.name }}</td>
                    <td>{{ item.position }}</td>
                    <td class="text-end">
                        <a href="{{ path('manage_reference_edit', {type: type, id: item.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Modifier</a>
                        <form action="{{ path('manage_reference_delete', {type: type, id: item.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer cet élément ?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="text-muted">Aucun élément pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}