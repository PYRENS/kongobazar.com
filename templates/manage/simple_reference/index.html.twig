{% extends 'manage/base.html.twig' %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">{{ label }}</h1>
        <a href="{{ path('manage_reference_new', {type: type}) }}" class="btn btn-primary btn-sm">+ Ajouter</a>
    </div>

    <table class="table admin-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Position</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item.name }}</td>
                    <td>{{ item.position }}</td>
                    <td class="text-end">
                        <a href="{{ path('manage_reference_edit', {type: type, id: item.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <form action="{{ path('manage_reference_delete', {type: type, id: item.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer cet élément ?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="text-muted">Aucun élément pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}