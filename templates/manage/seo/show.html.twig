{% extends 'manage/base.html.twig' %}

{% block title %}Fiche SEO — {{ override.adminLabel ?: override.pageKey }}{% endblock %}
{% block page_icon %}bi-search{% endblock %}
{% block page_title %}Fiche SEO — {{ override.adminLabel ?: override.pageKey }}{% endblock %}

{% block body %}
    <a href="{{ path('manage_seo_index') }}" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-left me-1"></i>Retour à la liste</a>
    <a href="{{ path('manage_seo_edit', {id: override.id}) }}" class="btn btn-primary btn-sm mb-3"><i class="bi bi-pencil"></i> Modifier</a>
    {% if publicUrl %}
        <a href="{{ publicUrl }}" target="_blank" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-box-arrow-up-right"></i> Voir la page publique</a>
    {% endif %}

    <div class="sw-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3"><span class="text-muted">Type :</span> <strong>{{ entityTypes[override.entityType] ?? override.entityType }}</strong></div>
                <div class="col-md-3"><span class="text-muted">Cible :</span> <strong>{{ override.adminLabel ?: (override.pageKey ?: ('#' ~ override.entityId)) }}</strong></div>
                <div class="col-md-3"><span class="text-muted">Indexation :</span>
                    {% if override.noIndex %}<span class="badge bg-danger">Non indexée</span>{% else %}<span class="badge bg-success">Indexée</span>{% endif %}
                </div>
                <div class="col-md-3"><span class="text-muted">Mise à jour :</span> <strong>{{ override.updatedAt ? override.updatedAt|date('d/m/Y H:i') : '—' }}</strong></div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-6">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-google text-primary me-2"></i>Ce que Google affiche</h6></div>
                <div class="card-body">
                    <div style="font-family:Arial,sans-serif;max-width:560px;">
                        <div style="color:#202124;font-size:14px;">kongobazar.com</div>
                        <div style="color:#1a0dab;font-size:20px;line-height:1.3;margin:2px 0;">{{ finalTitle }}</div>
                        <div style="color:#4d5156;font-size:14px;line-height:1.4;">{{ finalDescription }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-window text-primary me-2"></i>Ce que le navigateur affiche (onglet)</h6></div>
                <div class="card-body">
                    <div style="display:inline-flex;align-items:center;gap:6px;background:#dee1e6;border-radius:8px 8px 0 0;padding:8px 16px;max-width:280px;">
                        <img src="{{ asset('favicon.ico') }}" style="width:16px;height:16px;" onerror="this.style.display='none'">
                        <span style="font-size:13px;color:#3c4043;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ finalTitle }}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-facebook text-primary me-2"></i>Ce que Facebook affiche (partage)</h6></div>
                <div class="card-body">
                    <div style="border:1px solid #dddfe2;border-radius:8px;overflow:hidden;max-width:500px;font-family:Helvetica,Arial,sans-serif;">
                        {% if override.ogImageName %}
                            <img src="{{ vich_uploader_asset(override, 'ogImageFile') }}" style="width:100%;aspect-ratio:1.91/1;object-fit:cover;display:block;">
                        {% else %}
                            <div style="width:100%;aspect-ratio:1.91/1;background:#f0f2f5;display:flex;align-items:center;justify-content:center;color:#90949c;">
                                <i class="bi bi-image" style="font-size:40px;"></i>
                            </div>
                        {% endif %}
                        <div style="background:#f0f2f5;padding:10px 12px;">
                            <div style="color:#606770;font-size:12px;text-transform:uppercase;">kongobazar.com</div>
                            <div style="color:#050505;font-size:16px;font-weight:600;margin:2px 0;">{{ finalOgTitle }}</div>
                            <div style="color:#606770;font-size:14px;">{{ finalOgDescription|length > 100 ? finalOgDescription|slice(0, 100) ~ '…' : finalOgDescription }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-whatsapp text-primary me-2"></i>Ce que WhatsApp affiche (partage)</h6></div>
                <div class="card-body">
                    <div style="display:flex;border:1px solid #e9edef;border-radius:8px;overflow:hidden;max-width:420px;font-family:Helvetica,Arial,sans-serif;">
                        {% if override.ogImageName %}
                            <img src="{{ vich_uploader_asset(override, 'ogImageFile') }}" style="width:80px;height:80px;object-fit:cover;flex-shrink:0;">
                        {% else %}
                            <div style="width:80px;height:80px;background:#f0f2f5;display:flex;align-items:center;justify-content:center;color:#90949c;flex-shrink:0;">
                                <i class="bi bi-image" style="font-size:24px;"></i>
                            </div>
                        {% endif %}
                        <div style="padding:8px 10px;overflow:hidden;">
                            <div style="color:#111b21;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ finalOgTitle }}</div>
                            <div style="color:#667781;font-size:13px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ finalOgDescription }}</div>
                            <div style="color:#667781;font-size:12px;margin-top:2px;">kongobazar.com</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="sw-card h-100">
                <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-twitter-x text-primary me-2"></i>Ce que X (Twitter) affiche (partage)</h6></div>
                <div class="card-body">
                    <div style="border:1px solid #cfd9de;border-radius:16px;overflow:hidden;max-width:500px;font-family:Helvetica,Arial,sans-serif;">
                        {% if override.ogImageName %}
                            <img src="{{ vich_uploader_asset(override, 'ogImageFile') }}" style="width:100%;aspect-ratio:1.91/1;object-fit:cover;display:block;">
                        {% else %}
                            <div style="width:100%;aspect-ratio:1.91/1;background:#f0f2f5;display:flex;align-items:center;justify-content:center;color:#90949c;">
                                <i class="bi bi-image" style="font-size:40px;"></i>
                            </div>
                        {% endif %}
                        <div style="padding:8px 12px;border-top:1px solid #cfd9de;">
                            <div style="color:#536471;font-size:13px;">kongobazar.com</div>
                            <div style="color:#0f1419;font-size:15px;">{{ finalOgTitle }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
