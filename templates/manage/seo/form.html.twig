{% extends 'manage/base.html.twig' %}

{% block title %}{{ override ? 'Modifier' : 'Nouvelle' }} fiche SEO{% endblock %}
{% block page_icon %}bi-search{% endblock %}
{% block page_title %}{{ override ? 'Modifier' : 'Nouvelle' }} fiche SEO{% endblock %}

{% block body %}
    <a href="{{ path('manage_seo_index') }}" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-left me-1"></i>Retour à la liste</a>

    <form method="post" enctype="multipart/form-data" action="{{ override ? path('manage_seo_update', {id: override.id}) : path('manage_seo_create') }}">
        <div class="row g-3">
            <div class="col-xl-8">
                <div class="sw-card">
                    <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-link-45deg text-primary me-2"></i>Page ciblée</h6></div>
                    <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select name="entity_type" id="entityTypeSelect" class="form-select" style="max-width:260px;">
                            {% for key, label in entityTypes %}
                                <option value="{{ key }}" {{ override and override.entityType == key ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div id="staticPageField" class="mb-0" style="{{ not override or override.entityType == 'static_page' ? '' : 'display:none;' }}">
                        <label class="form-label">Page statique</label>
                        <select name="page_key" class="form-select" style="max-width:320px;">
                            {% for key, label in staticPages %}
                                <option value="{{ key }}" {{ override and override.pageKey == key ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div id="entityIdField" class="mb-0" style="{{ override and override.entityType != 'static_page' ? '' : 'display:none;' }}">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Identifiant de la fiche (ID)</label>
                                <input type="number" name="entity_id" class="form-control" value="{{ override ? override.entityId : '' }}">
                                <small class="text-muted">L'ID du produit, de la catégorie ou de la boutique concernée.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Libellé (repère dans la liste)</label>
                                <input type="text" name="admin_label" class="form-control" value="{{ override ? override.adminLabel : '' }}" placeholder="ex: iPhone 15 Pro Max">
                            </div>
                        </div>
                    </div>
                    </div>
                </div>

                <div class="sw-card mt-3">
                    <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-card-text text-primary me-2"></i>Balises SEO</h6></div>
                    <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Titre de la page (balise &lt;title&gt;)</label>
                        <input type="text" name="meta_title" class="form-control" value="{{ override ? override.metaTitle : '' }}" maxlength="255">
                        <small class="text-muted">Idéalement 50 à 60 caractères.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meta description</label>
                        <textarea name="meta_description" class="form-control" rows="3" maxlength="300">{{ override ? override.metaDescription : '' }}</textarea>
                        <small class="text-muted">Idéalement 150 à 160 caractères.</small>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Mots-clés (optionnel, séparés par des virgules)</label>
                        <input type="text" name="meta_keywords" class="form-control" value="{{ override ? override.metaKeywords : '' }}">
                    </div>
                    </div>
                </div>

                <div class="sw-card mt-3">
                    <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-share text-primary me-2"></i>Open Graph (partage réseaux sociaux)</h6></div>
                    <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Titre og:title (optionnel — reprend le titre SEO si vide)</label>
                        <input type="text" name="og_title" class="form-control" value="{{ override ? override.ogTitle : '' }}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description og:description (optionnel — reprend la meta description si vide)</label>
                        <textarea name="og_description" class="form-control" rows="2">{{ override ? override.ogDescription : '' }}</textarea>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Image de partage (1200×630 recommandé)</label>
                        <div class="admin-file-upload-group">
                            <div class="admin-upload-thumb" id="ogImageThumb" style="{{ override and override.ogImageName ? '' : 'display:none;' }}">
                                <span class="admin-upload-thumb-label">Actuelle</span>
                                <div class="admin-upload-thumb-inner">
                                    <img id="ogImagePreview" src="{{ override and override.ogImageName ? vich_uploader_asset(override, 'ogImageFile') : '' }}">
                                    <button type="button" id="ogImageRemoveBtn" class="admin-upload-remove"><i class="bi bi-x"></i></button>
                                </div>
                            </div>
                            <div class="admin-upload-thumb">
                                <span class="admin-upload-thumb-label">&nbsp;</span>
                                <label class="admin-upload-dropzone" for="ogImageInput">
                                    <i class="bi bi-camera"></i>
                                    <span>Upload</span>
                                </label>
                            </div>
                            <input type="file" name="og_image_file" id="ogImageInput" accept="image/*" class="admin-upload-input-hidden">
                        </div>
                    </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="sw-card">
                    <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-robot text-primary me-2"></i>Indexation</h6></div>
                    <div class="card-body">
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="no_index" value="1" class="form-check-input" id="noIndex" {{ override and override.noIndex ? 'checked' : '' }}>
                        <label class="form-check-label" for="noIndex">Ne pas indexer cette page (noindex)</label>
                    </div>
                    <div class="mb-0 form-check">
                        <input type="checkbox" name="no_follow" value="1" class="form-check-input" id="noFollow" {{ override and override.noFollow ? 'checked' : '' }}>
                        <label class="form-check-label" for="noFollow">Ne pas suivre les liens de cette page (nofollow)</label>
                    </div>
                    </div>
                </div>

                <div class="sw-card mt-3">
                    <div class="card-header"><h6 class="mb-0 fw-bold"><i class="bi bi-eye text-primary me-2"></i>Aperçu Google</h6></div>
                    <div class="card-body">
                        <div style="font-family:Arial,sans-serif;">
                            <div id="googlePreviewTitle" style="color:#1a0dab;font-size:18px;line-height:1.3;">{{ override and override.metaTitle ? override.metaTitle : 'Titre de la page' }}</div>
                            <div style="color:#006621;font-size:13px;margin:2px 0;">kongobazar.com</div>
                            <div id="googlePreviewDesc" style="color:#545454;font-size:13px;">{{ override and override.metaDescription ? override.metaDescription : 'Description de la page…' }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Enregistrer</button>
            <a href="{{ path('manage_seo_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>

    <script>
        document.getElementById('entityTypeSelect').addEventListener('change', function () {
            const isStatic = this.value === 'static_page';
            document.getElementById('staticPageField').style.display = isStatic ? 'block' : 'none';
            document.getElementById('entityIdField').style.display = isStatic ? 'none' : 'block';
        });

        document.querySelector('[name="meta_title"]').addEventListener('input', function () {
            document.getElementById('googlePreviewTitle').textContent = this.value || 'Titre de la page';
        });
        document.querySelector('[name="meta_description"]').addEventListener('input', function () {
            document.getElementById('googlePreviewDesc').textContent = this.value || 'Description de la page…';
        });

        (function () {
            const input = document.getElementById('ogImageInput');
            const thumb = document.getElementById('ogImageThumb');
            const preview = document.getElementById('ogImagePreview');
            const removeBtn = document.getElementById('ogImageRemoveBtn');

            input.addEventListener('change', function () {
                const file = this.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    thumb.style.display = '';
                };
                reader.readAsDataURL(file);
            });

            removeBtn.addEventListener('click', function () {
                input.value = '';
                preview.src = '';
                thumb.style.display = 'none';
            });
        })();
    </script>
{% endblock %}
