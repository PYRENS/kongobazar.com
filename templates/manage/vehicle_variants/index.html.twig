{% extends 'manage/base.html.twig' %}

{% block title %}Variantes véhicules{% endblock %}
{% block page_icon %}bi-diagram-3{% endblock %}
{% block page_title %}Variantes véhicules{% endblock %}

{% macro sortLink(field, label, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Variantes véhicules</h1>
        <a href="{{ path('manage_vehicle_variants_new') }}" class="btn btn-primary btn-sm">+ Nouvelle variante</a>
    </div>

    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <input type="text" name="q" class="form-control" style="max-width: 300px;" placeholder="Rechercher (variante, modèle, marque)..." value="{{ searchTerm }}">
        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
        {% if searchTerm %}
            <a href="{{ path('manage_vehicle_variants_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        {% endif %}
    </form>

    <p class="text-muted mb-2">{{ rows|length }} variante{{ rows|length > 1 ? 's' : '' }} au total</p>

    <table class="table admin-table">
        <thead>
            <tr>
                <th>Logo</th>
                <th>{{ self.sortLink('brand', 'Marque', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('model', 'Modèle', currentSort, currentDir) }}</th>
                <th>{{ self.sortLink('variant', 'Variante', currentSort, currentDir) }}</th>
                <th>Période</th>
                <th>{{ self.sortLink('engineCount', 'Motorisations', currentSort, currentDir) }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                {% set variant = row.variant %}
                <tr>
                    <td>
                        {% if variant.model.brand.logoName %}
                            <img src="{{ vich_uploader_asset(variant.model.brand, 'logoFile') }}" alt="" style="width:28px;height:28px;object-fit:contain;">
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td><a href="{{ path('manage_brands_show', {id: variant.model.brand.id}) }}">{{ variant.model.brand.name }}</a></td>
                    <td><a href="{{ path('manage_vehicle_models_show', {id: variant.model.id}) }}">{{ variant.model.name }}</a></td>
                    <td><a href="{{ path('manage_vehicle_variants_show', {id: variant.id}) }}">{{ variant.name ?: '-' }}</a></td>
                    <td>{{ variant.monthBegin }}/{{ variant.yearBegin }} — {{ variant.monthEnd ? variant.monthEnd ~ '/' ~ variant.yearEnd : '...' }}</td>
                    <td>
                        {% if row.engineCount > 0 %}
                            <a href="{{ path('manage_vehicle_variants_show', {id: variant.id}) }}#motorisations">{{ row.engineCount }}</a>
                        {% else %}
                            0
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <a href="{{ path('manage_vehicle_variants_show', {id: variant.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                        <a href="{{ path('manage_vehicle_variants_edit', {id: variant.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form action="{{ path('manage_vehicle_variants_delete', {id: variant.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer cette variante ?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-muted">Aucune variante pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}