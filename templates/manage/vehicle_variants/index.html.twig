{% extends 'manage/base.html.twig' %}

{% block title %}Variantes véhicules{% endblock %}
{% block page_icon %}bi-diagram-3{% endblock %}
{% block page_title %}Variantes véhicules{% endblock %}

{% macro sortLink(field, label, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-blue h-100">
                <div class="ctb-stat-icon ctb-stat-icon-blue"><i class="bi bi-diagram-3-fill"></i></div>
                <div class="ctb-stat-val">{{ stats.total }}</div>
                <div class="ctb-stat-label">Variantes au total</div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-purple h-100">
                <div class="ctb-stat-icon ctb-stat-icon-purple"><i class="bi bi-gear-fill"></i></div>
                <div class="ctb-stat-val">{{ stats.totalEngines }}</div>
                <div class="ctb-stat-label">Motorisations au total</div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="sw-card ctb-stat ctb-stat-orange h-100">
                <div class="ctb-stat-icon ctb-stat-icon-orange"><i class="bi bi-list-ul"></i></div>
                <div class="ctb-stat-val">{{ stats.filtered }}</div>
                <div class="ctb-stat-label">Résultats filtrés</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="sw-card">
                <div class="card-body py-3">
                    <form method="get" class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="ctb-search-wrap">
                            <i class="bi bi-search ctb-search-icon"></i>
                            <input type="text" name="q" class="ctb-search-input" style="width:300px;" placeholder="Rechercher (variante, modèle, marque)..." value="{{ searchTerm }}">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <select name="perPage" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                                {% for n in [10, 20, 50, 100] %}
                                    <option value="{{ n }}" {{ perPage == n ? 'selected' : '' }}>{{ n }} / page</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Rechercher</button>
                            {% if searchTerm %}<a href="{{ path('manage_vehicle_variants_index') }}" class="btn btn-outline-secondary btn-sm">Réinitialiser</a>{% endif %}
                            <a href="{{ path('manage_vehicle_variants_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nouvelle variante</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="sw-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table ctb-table mb-0">
                    <thead>
                        <tr>
                            <th>Logo</th>
                            <th>{{ self.sortLink('brand', 'Marque', currentSort, currentDir) }}</th>
                            <th>{{ self.sortLink('model', 'Modèle', currentSort, currentDir) }}</th>
                            <th>{{ self.sortLink('variant', 'Variante', currentSort, currentDir) }}</th>
                            <th>{{ self.sortLink('period', 'Période', currentSort, currentDir) }}</th>
                            <th>{{ self.sortLink('engineCount', 'Motorisations', currentSort, currentDir) }}</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set variant = row.variant %}
                            <tr>
                                <td>
                                    {% if variant.model.brand.logoName %}
                                        <img src="{{ vich_uploader_asset(variant.model.brand, 'logoFile') }}" alt="" style="width:28px;height:28px;object-fit:contain;">
                                    {% else %}<span class="text-muted">—</span>{% endif %}
                                </td>
                                <td><a href="{{ path('manage_brands_show', {id: variant.model.brand.id}) }}">{{ variant.model.brand.name }}</a></td>
                                <td><a href="{{ path('manage_vehicle_models_show', {id: variant.model.id}) }}">{{ variant.model.name }}</a></td>
                                <td class="ctb-contact-name"><a href="{{ path('manage_vehicle_variants_show', {id: variant.id}) }}">{{ variant.name ?: '-' }}</a></td>
                                <td>{{ variant.monthBegin }}/{{ variant.yearBegin }} — {{ variant.monthEnd ? variant.monthEnd ~ '/' ~ variant.yearEnd : '...' }}</td>
                                <td>
                                    {% if row.engineCount > 0 %}
                                        <a href="{{ path('manage_vehicle_variants_show', {id: variant.id}) }}#motorisations">{{ row.engineCount }}</a>
                                    {% else %}0{% endif %}
                                </td>
                                <td>
                                    <div class="ctb-act-row">
                                        <a href="{{ path('manage_vehicle_variants_show', {id: variant.id}) }}" class="ctb-act-btn" title="Voir"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('manage_vehicle_variants_edit', {id: variant.id}) }}" class="ctb-act-btn" title="Modifier"><i class="bi bi-pencil"></i></a>
                                        <form action="{{ path('manage_vehicle_variants_delete', {id: variant.id}) }}" method="post" onsubmit="return confirm('Supprimer cette variante ?');">
                                            <button type="submit" class="ctb-act-btn ctb-act-danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-muted text-center py-4">Aucune variante pour l'instant.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="ctb-table-footer">
                <span class="ctb-footer-info">{{ total }} variante{{ total != 1 ? 's' : '' }} au total — page {{ page }} / {{ pages }}</span>
                {% if pages > 1 %}
                    <div class="ctb-pagination">
                        <a href="{{ path('manage_vehicle_variants_index', app.request.query.all|merge({page: max(1, page - 1)})) }}" class="ctb-page-btn {{ page <= 1 ? 'disabled' : '' }}"><i class="bi bi-chevron-left"></i></a>
                        {% for p in max(1, page - 2)..min(pages, page + 2) %}
                            <a href="{{ path('manage_vehicle_variants_index', app.request.query.all|merge({page: p})) }}" class="ctb-page-btn {{ p == page ? 'ctb-page-active' : '' }}">{{ p }}</a>
                        {% endfor %}
                        <a href="{{ path('manage_vehicle_variants_index', app.request.query.all|merge({page: min(pages, page + 1)})) }}" class="ctb-page-btn {{ page >= pages ? 'disabled' : '' }}"><i class="bi bi-chevron-right"></i></a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}