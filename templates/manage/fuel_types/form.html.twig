{% extends 'manage/base.html.twig' %}

{% block body %}
    <h1 class="h4 mb-3">{{ fuelType ? 'Modifier l\'énergie' : 'Nouvelle énergie' }}</h1>

    <form method="post" action="{{ fuelType ? path('manage_fuel_types_update', {id: fuelType.id}) : path('manage_fuel_types_new') }}">
        <div class="mb-3">
            <label class="form-label">Nom</label>
            <input type="text" name="name" class="form-control" value="{{ fuelType ? fuelType.name : '' }}" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3">{{ fuelType ? fuelType.description : '' }}</textarea>
        </div>
        <div class="mb-3 form-check">
            <input type="checkbox" name="active" value="1" class="form-check-input" id="active"
                {{ fuelType is null or fuelType.active ? 'checked' : '' }}>
            <label class="form-check-label" for="active">Actif</label>
        </div>

        <button type="submit" class="btn btn-success">Enregistrer</button>
        <a href="{{ path('manage_fuel_types_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </form>
{% endblock %}