{% extends 'manage/base.html.twig' %}

{% block title %}Énergies{% endblock %}
{% block page_icon %}bi-fuel-pump{% endblock %}
{% block page_title %}Énergies{% endblock %}

{% macro sortLink(field, label, currentSort, currentDir) %}
    {% set nextDir = (currentSort == field and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="?sort={{ field }}&dir={{ nextDir }}" class="admin-sort-link">
        {{ label }}
        {% if currentSort == field %}
            <i class="bi bi-caret-{{ currentDir == 'ASC' ? 'up' : 'down' }}-fill"></i>
        {% else %}
            <i class="bi bi-arrow-down-up admin-sort-icon-idle"></i>
        {% endif %}
    </a>
{% endmacro %}
{% import _self as self %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Énergies (carburants)</h1>
        <a href="{{ path('manage_fuel_types_new') }}" class="btn btn-primary btn-sm">+ Ajouter</a>
    </div>

    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <input type="text" name="q" class="form-control" style="max-width: 300px;" placeholder="Rechercher une énergie..." value="{{ searchTerm }}">
        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search"></i></button>
        {% if searchTerm %}
            <a href="{{ path('manage_fuel_types_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
        {% endif %}
    </form>

    <table class="table admin-table">
        <thead>
            <tr>
                <th>{{ self.sortLink('name', 'Nom', currentSort, currentDir) }}</th>
                <th>Description</th>
                <th>{{ self.sortLink('active', 'Actif', currentSort, currentDir) }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for fuelType in fuelTypes %}
                <tr>
                    <td>{{ fuelType.name }}</td>
                    <td>{{ fuelType.description ?: '—' }}</td>
                    <td>{{ fuelType.active ? 'Oui' : 'Non' }}</td>
                    <td class="text-end">
                        <a href="{{ path('manage_fuel_types_edit', {id: fuelType.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <form action="{{ path('manage_fuel_types_delete', {id: fuelType.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer cette énergie ?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-muted">Aucune énergie pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}