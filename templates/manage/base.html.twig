<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Back-Office{% endblock %} — KongoBazar</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/admin-favicon.svg') }}">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css">
    <link rel="stylesheet" href="{{ asset('styles/manage/stackwave.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/manage/admin.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
{% set sbTheme = app.user and app.user.adminSidebarTheme ? app.user.adminSidebarTheme : null %}
<body class=""
      {% if sbTheme %}style="--sidebar-bg:{{ sbTheme.bgColor }};--sidebar-text:{{ sbTheme.textColor }};--sidebar-hover-bg:{{ sbTheme.hoverBgColor }};--sidebar-hover-text:{{ sbTheme.hoverTextColor }};--sidebar-active-bg:{{ sbTheme.activeBgColor }};--sidebar-active-text:{{ sbTheme.activeTextColor }};--sidebar-icon:{{ sbTheme.iconColor }};--sidebar-heading-color:{{ sbTheme.hoverTextColor }};--primary:{{ sbTheme.activeBgColor }};"{% endif %}>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<header class="app-header" id="appHeader">
    <div class="header-inner">
        <div class="header-left">
            <button class="sidebar-toggle-btn" id="sidebarBurgerToggle" title="Basculer le menu">
                <i class="bi bi-list"></i>
            </button>
        </div>
        <div class="header-search">
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="adminNavSearchInput" placeholder="Rechercher dans le menu..." autocomplete="off">
            </div>
            <div class="header-search-results" id="adminNavSearchResults"></div>
        </div>
        <div class="header-right">
            <button class="hdr-icon-btn" id="darkModeQuickToggle" title="Mode nuit" aria-label="Basculer le mode nuit">
                <i class="bi bi-moon-stars"></i>
            </button>
            {% if app.user %}
                <div class="dropdown">
                    <button class="user-avatar-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        {% if app.user.avatarName %}
                            <img src="{{ vich_uploader_asset(app.user, 'avatarFile') }}" alt="">
                        {% else %}
                            <span class="admin-avatar admin-avatar--initials">{{ app.user.initials }}</span>
                        {% endif %}
                        <span class="user-online-dot"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end profile-dropdown">
                        <div class="profile-hd">
                            <h6>{{ app.user.email }}</h6>
                        </div>
                        <div class="profile-footer">
                            <a href="{{ path('manage_logout') }}" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-box-arrow-right me-1"></i>Déconnexion</a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</header>

<aside class="app-sidebar" id="appSidebar">
    <a href="{{ path('manage_dashboard') }}" class="sidebar-logo">
        <div class="logo-mark">KB</div>
        <span class="logo-text hide-menu">Kongo<span>Bazar</span></span>
    </a>
    <div class="sidebar-inner">
        <nav class="sidebar-nav">
<ul class="admin-nav">
                <li class="{{ app.request.attributes.get('_route') == 'manage_dashboard' ? 'active' : '' }}">
                    <a href="{{ path('manage_dashboard') }}"><i class="bi bi-speedometer2"></i> <span class="hide-menu">Tableau de bord</span></a>
                </li>
                <li class="{{ app.request.attributes.get('_route') starts with 'manage_users' ? 'active' : '' }}">
                    <a href="{{ path('manage_users_index') }}"><i class="bi bi-people"></i> <span class="hide-menu">Utilisateurs</span></a>
                </li>
                <li class="{{ app.request.attributes.get('_route') starts with 'manage_geo' ? 'active' : '' }}">
                    <a href="{{ path('manage_geo_index') }}"><i class="bi bi-geo-alt"></i> <span class="hide-menu">Entités admin.</span></a>
                </li>
                <li class="{{ app.request.attributes.get('_route') starts with 'manage_categories' ? 'active' : '' }}">
                    <a href="{{ path('manage_categories_index') }}"><i class="bi bi-tags"></i> <span class="hide-menu">Catégories</span></a>
                </li>
                <li class="{{ app.request.attributes.get('_route') starts with 'manage_brands' ? 'active' : '' }}">
                    <a href="{{ path('manage_brands_index') }}"><i class="bi bi-award"></i> <span class="hide-menu">Marques</span></a>
                </li>
                {% set autoMotoRoutes = ['manage_vehicle_models', 'manage_vehicle_variants', 'manage_vehicle_engines', 'manage_fuel_types', 'manage_vehicle_import'] %}
                {% set autoMotoRefTypes = ['permis', 'types-moto'] %}
                {% set autoMotoActive = false %}
                {% for r in autoMotoRoutes %}
                    {% if app.request.attributes.get('_route') starts with r %}{% set autoMotoActive = true %}{% endif %}
                {% endfor %}
                {% if app.request.attributes.get('_route') starts with 'manage_reference' and app.request.get('type') in autoMotoRefTypes %}{% set autoMotoActive = true %}{% endif %}

                <li class="admin-nav-group {{ autoMotoActive ? 'open' : '' }}">
                    <button type="button" class="admin-nav-group-toggle">
                        <i class="bi bi-car-front"></i> <span class="hide-menu">Auto-Moto</span> <i class="bi bi-chevron-down admin-nav-group-arrow"></i>
                    </button>
                    <ul class="admin-nav-submenu">
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_vehicle_models' ? 'active' : '' }}">
                            <a href="{{ path('manage_vehicle_models_index') }}"><i class="bi bi-car-front"></i> <span class="hide-menu">Modèles véhicules</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_vehicle_variants' ? 'active' : '' }}">
                            <a href="{{ path('manage_vehicle_variants_index') }}"><i class="bi bi-diagram-3"></i> <span class="hide-menu">Variantes véhicules</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_vehicle_engines' ? 'active' : '' }}">
                            <a href="{{ path('manage_vehicle_engines_index') }}"><i class="bi bi-gear"></i> <span class="hide-menu">Motorisations</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_fuel_types' ? 'active' : '' }}">
                            <a href="{{ path('manage_fuel_types_index') }}"><i class="bi bi-fuel-pump"></i> <span class="hide-menu">Énergies</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_reference' and app.request.get('type') == 'permis' ? 'active' : '' }}">
                            <a href="{{ path('manage_reference_index', {type: 'permis'}) }}"><i class="bi bi-card-checklist"></i> <span class="hide-menu">Permis requis</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_reference' and app.request.get('type') == 'types-moto' ? 'active' : '' }}">
                            <a href="{{ path('manage_reference_index', {type: 'types-moto'}) }}"><i class="bi bi-scooter"></i> <span class="hide-menu">Types de moto</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_vehicle_import' ? 'active' : '' }}">
                            <a href="{{ path('manage_vehicle_import') }}"><i class="bi bi-upload"></i> <span class="hide-menu">Import motorisations</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_vehicle_search' ? 'active' : '' }}">
                            <a href="{{ path('manage_vehicle_search') }}"><i class="bi bi-search"></i> Recherche</a>
                        </li>
                    </ul>
                </li>

                {% set catalogRoots = part_catalog_root_categories() %}
                {% set catalogGroupActive = app.request.attributes.get('_route') starts with 'manage_part_catalog' %}
                <li class="admin-nav-group {{ catalogGroupActive ? 'open' : '' }}">
                    <button type="button" class="admin-nav-group-toggle">
                        <i class="bi bi-collection"></i> Catalogue <i class="bi bi-chevron-down admin-nav-group-arrow"></i>
                    </button>
                    <ul class="admin-nav-submenu">
                        <li class="{{ catalogGroupActive and not app.request.get('rootCategory') ? 'active' : '' }}">
                            <a href="{{ path('manage_part_catalog_index') }}"><i class="bi bi-collection"></i> Toutes catégories</a>
                        </li>
                        {% for root in catalogRoots %}
                            <li class="{{ catalogGroupActive and app.request.get('rootCategory') == root.id ? 'active' : '' }}">
                                <a href="{{ path('manage_part_catalog_index', {rootCategory: root.id}) }}"><i class="bi bi-tag"></i> Catalogue {{ root.name }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </li>

                <li class="{{ app.request.attributes.get('_route') starts with 'manage_reference' and app.request.get('type') == 'periodes-location' ? 'active' : '' }}">
                    <a href="{{ path('manage_reference_index', {type: 'periodes-location'}) }}"><i class="bi bi-calendar-range"></i> <span class="hide-menu">Périodes de location</span></a>
                </li>
                <li class="{{ app.request.attributes.get('_route') starts with 'manage_products' ? 'active' : '' }}">
                    <a href="{{ path('manage_products_index') }}"><i class="bi bi-box-seam"></i> <span class="hide-menu">Produits</span></a>
                </li>

                {% set adsGroupActive = app.request.attributes.get('_route') starts with 'manage_ads' or app.request.attributes.get('_route') starts with 'manage_ad_zones' or app.request.attributes.get('_route') starts with 'manage_trending' or app.request.attributes.get('_route') starts with 'manage_mega_menu' or app.request.attributes.get('_route') starts with 'manage_top_category' or app.request.attributes.get('_route') starts with 'manage_social_links' or app.request.attributes.get('_route') starts with 'manage_hero_side_ads_setting' or app.request.attributes.get('_route') starts with 'manage_discount_campaigns' %}

                <li class="admin-nav-group {{ adsGroupActive ? 'open' : '' }}">
                    <button type="button" class="admin-nav-group-toggle">
                        <i class="bi bi-megaphone"></i> <span class="hide-menu">Pubs / Mise en avant</span> <i class="bi bi-chevron-down admin-nav-group-arrow"></i>
                    </button>
                    <ul class="admin-nav-submenu">
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_ads' ? 'active' : '' }}">
                            <a href="{{ path('manage_ads_index') }}"><i class="bi bi-image"></i> <span class="hide-menu">Publicités</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_ad_zones' ? 'active' : '' }}">
                            <a href="{{ path('manage_ad_zones_index') }}"><i class="bi bi-shuffle"></i> <span class="hide-menu">Zones publicitaires</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_trending' ? 'active' : '' }}">
                            <a href="{{ path('manage_trending_index') }}"><i class="bi bi-graph-up-arrow"></i> <span class="hide-menu">Tendances</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_mega_menu' ? 'active' : '' }}">
                            <a href="{{ path('manage_mega_menu_index') }}"><i class="bi bi-grid-3x3-gap"></i> <span class="hide-menu">Méga-menu (header)</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_top_category' ? 'active' : '' }}">
                            <a href="{{ path('manage_top_category_index') }}"><i class="bi bi-star"></i> <span class="hide-menu">Top Catégorie</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_social_links' ? 'active' : '' }}">
                            <a href="{{ path('manage_social_links_index') }}"><i class="bi bi-share"></i> <span class="hide-menu">Réseaux sociaux</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_hero_side_ads_setting' ? 'active' : '' }}">
                            <a href="{{ path('manage_hero_side_ads_setting') }}"><i class="bi bi-columns-gap"></i> <span class="hide-menu">Pubs latérales hero</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_discount_campaigns' ? 'active' : '' }}">
                            <a href="{{ path('manage_discount_campaigns_index') }}"><i class="bi bi-tag"></i> <span class="hide-menu">Ventes Flash</span></a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a href="{{ path('manage_seller_attr_test_index') }}"><i class="bi bi-person-gear"></i> <span class="hide-menu">Test — Caractéristiques vendeur</span></a>
                </li>
                <li class="admin-nav-group {{ app.request.attributes.get('_route') starts with 'manage_settings' or app.request.attributes.get('_route') starts with 'manage_sidebar_themes' or app.request.attributes.get('_route') starts with 'manage_seo' or app.request.attributes.get('_route') starts with 'manage_site_identity' or app.request.attributes.get('_route') starts with 'manage_home_deals_setting' or app.request.attributes.get('_route') starts with 'manage_home_trending_tabs' or app.request.attributes.get('_route') starts with 'manage_home_category_blocks' or app.request.attributes.get('_route') starts with 'manage_top_category_items' ? 'open' : '' }}">
                    <button type="button" class="admin-nav-group-toggle">
                        <i class="bi bi-gear"></i> <span class="hide-menu">Paramètres</span> <i class="bi bi-chevron-down admin-nav-group-arrow"></i>
                    </button>
                    <ul class="admin-nav-submenu">
                        <li class="{{ app.request.attributes.get('_route') == 'manage_settings' ? 'active' : '' }}">
                            <a href="{{ path('manage_settings') }}"><i class="bi bi-palette"></i> <span class="hide-menu">Interface</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_seo' ? 'active' : '' }}">
                            <a href="{{ path('manage_seo_index') }}"><i class="bi bi-search"></i> <span class="hide-menu">Référencement (SEO)</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_site_identity' ? 'active' : '' }}">
                            <a href="{{ path('manage_site_identity') }}"><i class="bi bi-badge-hd"></i> <span class="hide-menu">Identité visuelle</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_home_deals_setting' ? 'active' : '' }}">
                            <a href="{{ path('manage_home_deals_setting') }}"><i class="bi bi-lightning-charge"></i> <span class="hide-menu">Ventes flash accueil</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_home_trending_tabs' ? 'active' : '' }}">
                            <a href="{{ path('manage_home_trending_tabs_setting') }}"><i class="bi bi-graph-up"></i> <span class="hide-menu">Tendances accueil</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_home_category_blocks' ? 'active' : '' }}">
                            <a href="{{ path('manage_home_category_blocks_setting') }}"><i class="bi bi-grid-3x3-gap-fill"></i> <span class="hide-menu">Blocs catégorie accueil</span></a>
                        </li>
                        <li class="{{ app.request.attributes.get('_route') starts with 'manage_top_category_items' ? 'active' : '' }}">
                            <a href="{{ path('manage_top_category_items_setting') }}"><i class="bi bi-circle-square"></i> <span class="hide-menu">Top Catégorie accueil</span></a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </div>
</aside>

<div class="content-area">
    <div class="dark-band">
        <div class="container-fluid px-4 py-3">
            <div class="page-hdr-inline">
                <div>
                    <h4 class="page-title-light"><i class="bi {% block page_icon %}bi-circle{% endblock %}"></i> {% block page_title %}Tableau de bord{% endblock %}</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="page-wrapper">
        <div class="container-fluid px-4">
            {% for label, messages in app.flashes %}
                {% set bsClass = label == 'error' ? 'danger' : label %}
                {% for message in messages %}
                    <div class="alert alert-{{ bsClass }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

        <footer class="site-footer">
            <div class="footer-inner">
                <p>© {{ "now"|date("Y") }} <strong>KongoBazar</strong> — Back-office admin.</p>
            </div>
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('js/manage/admin.js') }}"></script>
<script src="{{ asset('js/manage/geo-picker.js') }}"></script>
<script src="{{ asset('js/manage/category-picker.js') }}"></script>
<script src="{{ asset('js/manage/vehicle-model-picker.js') }}"></script>
<script src="{{ asset('js/manage/product-pickers.js') }}"></script>
<script src="{{ asset('js/manage/part-compatibility.js') }}"></script>
<script src="{{ asset('js/manage/product-attribute-paste.js') }}"></script>
<script src="{{ asset('js/manage/product-attribute-duplicate.js') }}"></script>
<script src="{{ asset('js/manage/product-free-attributes.js') }}"></script>
<script src="{{ asset('js/manage/seller-attribute-widget.js') }}"></script>
<script src="{{ asset('js/manage/part-brand-autocomplete.js') }}"></script>
<script src="{{ asset('js/manage/part-catalog-entry-link.js') }}"></script>
<script>
    (function () {
        const burger = document.getElementById('sidebarBurgerToggle');
        const sidebar = document.getElementById('appSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        if (!burger || !sidebar || !overlay) return;

        const isMobile = () => window.innerWidth < 992;

        const closeMobile = () => {
            sidebar.classList.remove('sidebar-open');
            overlay.classList.remove('active');
        };

        burger.addEventListener('click', function () {
            if (isMobile()) {
                // < 992px : sidebar hors-écran qui glisse par-dessus le contenu
                sidebar.classList.toggle('sidebar-open');
                overlay.classList.toggle('active');
            } else {
                // >= 992px : sidebar réduite en mode icônes seules (déjà stylée dans stackwave.css)
                document.body.classList.toggle('sidebar-collapsed');
            }
        });
        overlay.addEventListener('click', closeMobile);
    })();

    (function () {
        const input = document.getElementById('adminNavSearchInput');
        const results = document.getElementById('adminNavSearchResults');
        if (!input || !results) return;

        const items = Array.from(document.querySelectorAll('.admin-nav a[href]')).map(function (a) {
            const iconEl = a.querySelector('i');
            return {
                label: a.textContent.trim(),
                href: a.getAttribute('href'),
                icon: iconEl ? iconEl.className : 'bi bi-dot',
            };
        }).filter(function (item) { return item.label.length > 0; });

        function render(matches) {
            results.innerHTML = '';
            if (matches.length === 0) {
                results.innerHTML = '<div class="header-search-no-results">Aucun élément de menu trouvé.</div>';
                results.classList.add('active');
                return;
            }
            matches.slice(0, 8).forEach(function (item) {
                const a = document.createElement('a');
                a.href = item.href;
                a.className = 'header-search-result-item';
                a.innerHTML = '<i class="' + item.icon + '"></i><span>' + item.label + '</span>';
                results.appendChild(a);
            });
            results.classList.add('active');
        }

        input.addEventListener('input', function () {
            const term = this.value.trim().toLowerCase();
            if (term === '') {
                results.classList.remove('active');
                results.innerHTML = '';
                return;
            }
            render(items.filter(function (item) { return item.label.toLowerCase().includes(term); }));
        });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                const first = results.querySelector('.header-search-result-item');
                if (first) window.location.href = first.getAttribute('href');
            }
            if (e.key === 'Escape') {
                results.classList.remove('active');
                input.blur();
            }
        });

        document.addEventListener('click', function (e) {
            if (!results.contains(e.target) && e.target !== input) {
                results.classList.remove('active');
            }
        });
    })();

    (function () {
        const sidebar = document.getElementById('appSidebar');
        if (!sidebar) return;

        let flyout = null;
        let hideTimer = null;

        function removeFlyout() {
            if (flyout) { flyout.remove(); flyout = null; }
        }

        function showFlyout(li) {
            if (!document.body.classList.contains('sidebar-collapsed')) return;
            clearTimeout(hideTimer);
            removeFlyout();

            const toggle = li.querySelector(':scope > .admin-nav-group-toggle');
            const labelEl = toggle ? toggle.querySelector('.hide-menu') : null;
            if (!labelEl) return;

            const label = labelEl.textContent.trim();
            const iconEl = toggle.querySelector('i');
            const iconClass = iconEl ? iconEl.className : '';
            const isActive = li.classList.contains('open');
            const subLinks = li.querySelectorAll(':scope > .admin-nav-submenu li a');

            const fly = document.createElement('div');
            fly.className = 'sidebar-flyout';

            const titleEl = document.createElement('div');
            titleEl.className = 'flyout-title' + (isActive ? ' active' : '');
            if (iconClass) {
                const iEl = document.createElement('i');
                iEl.className = iconClass;
                titleEl.appendChild(iEl);
            }
            titleEl.appendChild(document.createTextNode(label));
            fly.appendChild(titleEl);

            if (subLinks.length) {
                const divider = document.createElement('div');
                divider.className = 'flyout-divider';
                fly.appendChild(divider);

                const ul = document.createElement('ul');
                ul.className = 'flyout-list';
                subLinks.forEach(function (a) {
                    const li2 = document.createElement('li');
                    const newA = document.createElement('a');
                    newA.setAttribute('href', a.getAttribute('href') || '#');
                    const subIconEl = a.querySelector('i');
                    if (subIconEl) {
                        const subI = document.createElement('i');
                        subI.className = subIconEl.className;
                        newA.appendChild(subI);
                    }
                    const subLabel = a.querySelector('.hide-menu');
                    newA.appendChild(document.createTextNode(subLabel ? subLabel.textContent.trim() : a.textContent.trim()));
                    if (a.closest('li').classList.contains('active')) newA.classList.add('active');
                    li2.appendChild(newA);
                    ul.appendChild(li2);
                });
                fly.appendChild(ul);
            }

            document.body.appendChild(fly);
            flyout = fly;

            const rect = li.getBoundingClientRect();
            const winH = window.innerHeight;
            let top = rect.top;
            document.body.appendChild(fly);
            const flyH = fly.offsetHeight;
            if (top + flyH > winH - 12) top = Math.max(12, winH - flyH - 12);
            fly.style.top = top + 'px';

            fly.addEventListener('mouseenter', function () { clearTimeout(hideTimer); });
            fly.addEventListener('mouseleave', function () { hideTimer = setTimeout(removeFlyout, 120); });
        }

        sidebar.querySelectorAll('.admin-nav > li.admin-nav-group').forEach(function (li) {
            li.addEventListener('mouseenter', function () { showFlyout(li); });
            li.addEventListener('mouseleave', function () { hideTimer = setTimeout(removeFlyout, 120); });
        });

        document.addEventListener('click', function (e) {
            if (e.target.closest('#sidebarBurgerToggle')) setTimeout(removeFlyout, 50);
        });
    })();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>